<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- 首发只运行于 Windows x64；默认构建只复制该平台的 PDF 原生库。 -->
    <RuntimeIdentifier
      Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- 产品后缀用于发行修订；PE 文件与程序集版本必须保持四段数字。 -->
    <Version>0.2.5.4</Version>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.2.5.4A</ProductVersion>
    <InformationalVersion>$(ProductVersion)</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="StudioXProductVersion" Value="$(ProductVersion)" />
  </ItemGroup>
</Project>
