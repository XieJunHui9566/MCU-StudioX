# 第一方文本使用一致换行；二进制和第三方资源按 Git 的默认识别处理。
* text=auto
*.cs text eol=lf
*.xaml text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.slnx text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.c text eol=lf
*.h text eol=lf
.editorconfig text eol=lf
*.md text eol=lf
# AGM 原始驱动/IP 按字节核验，不能在提交或检出时转换换行。
src/StudioX.Engine/Resources/Ag32/Peripherals/* -text -whitespace
# 这些文件的多行字面量包含生成内容；提交和检出也不能改变字面量的换行值。
src/StudioX.Cli/Program.cs -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
src/StudioX.Engine/CMakeGenerator.cs -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tools/StudioX.LvglValidation/CustomUiFixtures.cs -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
