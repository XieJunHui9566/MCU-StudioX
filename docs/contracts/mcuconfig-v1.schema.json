{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:studiox:schema:mcuconfig:1",
  "title": "StudioX MCU 图形化配置 v1（待实现契约）",
  "description": "结构约束不替代来源、ID/引用、容量、profile 语义和文件事务校验。",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "documentKind", "target", "profile", "origin", "definitions", "configuration", "generation"],
  "properties": {
    "format": { "const": "studiox.mcuconfig" },
    "formatVersion": { "const": 1 },
    "documentKind": { "enum": ["template", "project"] },
    "target": { "$ref": "#/$defs/target" },
    "profile": { "$ref": "#/$defs/profile" },
    "origin": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/origin" }] },
    "definitions": { "$ref": "#/$defs/definitions" },
    "configuration": { "$ref": "#/$defs/configuration" },
    "generation": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/generation" }] }
  },
  "allOf": [
    {
      "if": { "properties": { "documentKind": { "const": "template" } }, "required": ["documentKind"] },
      "then": { "properties": { "origin": { "type": "null" }, "generation": { "type": "null" } } },
      "else": { "properties": { "origin": { "$ref": "#/$defs/origin" } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "version": { "type": "string", "pattern": "^[0-9][A-Za-z0-9.+_-]{0,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[ .](?:/|$))[^\\u0000-\\u001f]+$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/version" } }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendorId", "deviceId", "packageId", "architecture"],
      "properties": {
        "vendorId": { "$ref": "#/$defs/id" },
        "deviceId": { "$ref": "#/$defs/id" },
        "packageId": { "$ref": "#/$defs/id" },
        "architecture": { "$ref": "#/$defs/id" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "pluginId", "providerId", "dataSchema", "framework", "sdk"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "pluginId": { "$ref": "#/$defs/id" },
        "providerId": { "$ref": "#/$defs/id" },
        "dataSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "sha256"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "version": { "$ref": "#/$defs/version" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "framework": { "$ref": "#/$defs/identity" },
        "sdk": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/identity" }] }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packId", "packVersion", "packContentHash", "deviceId", "templateId", "templateFile", "templateSha256", "definitionsSha256"],
      "properties": {
        "packId": { "$ref": "#/$defs/id" },
        "packVersion": { "$ref": "#/$defs/version" },
        "packContentHash": { "$ref": "#/$defs/sha256" },
        "deviceId": { "$ref": "#/$defs/id" },
        "templateId": { "$ref": "#/$defs/id" },
        "templateFile": { "$ref": "#/$defs/relativePath" },
        "templateSha256": { "$ref": "#/$defs/sha256" },
        "definitionsSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "data": {
      "type": "object",
      "description": "明确的 profile 扩展点；内部类型/字段由准确 profile Schema 约束，公共解析器仍检查全部数值、深度和容量。",
      "maxProperties": 128,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": true
    },
    "evidenceRefs": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "point": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 100000 },
        "y": { "type": "number", "minimum": 0, "maximum": 100000 }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "kind", "pinCount", "width", "height"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/name" },
        "kind": { "$ref": "#/$defs/id" },
        "pinCount": { "type": "integer", "minimum": 1, "maximum": 512 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 }
      }
    },
    "pinFunction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "peripheralId", "signalId", "profileData"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/name" },
        "peripheralId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "signalId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "profileData": { "$ref": "#/$defs/data" }
      },
      "oneOf": [
        { "properties": { "peripheralId": { "type": "null" }, "signalId": { "type": "null" } } },
        { "properties": { "peripheralId": { "$ref": "#/$defs/id" }, "signalId": { "$ref": "#/$defs/id" } } }
      ]
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position", "displayName", "category", "point", "side", "functions", "evidenceIds", "profileData"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "position": { "type": "string", "minLength": 1, "maxLength": 32 },
        "displayName": { "$ref": "#/$defs/name" },
        "category": { "enum": ["io", "supply", "ground", "reset", "oscillator", "reserved", "nc", "other"] },
        "point": { "$ref": "#/$defs/point" },
        "side": { "enum": ["top", "right", "bottom", "left", "center"] },
        "functions": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/pinFunction" } },
        "evidenceIds": { "$ref": "#/$defs/evidenceRefs" },
        "profileData": { "$ref": "#/$defs/data" }
      }
    },
    "signal": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "displayName", "direction", "profileData"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/name" },
        "direction": { "enum": ["input", "output", "bidirectional", "internal"] },
        "profileData": { "$ref": "#/$defs/data" }
      }
    },
    "peripheral": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "displayName", "signals", "evidenceIds", "profileData"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/name" },
        "signals": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/signal" } },
        "evidenceIds": { "$ref": "#/$defs/evidenceRefs" },
        "profileData": { "$ref": "#/$defs/data" }
      }
    },
    "clockNode": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "displayName", "inputIds", "point", "evidenceIds", "profileData"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["source", "mux", "pll", "divider", "gate", "output"] },
        "displayName": { "$ref": "#/$defs/name" },
        "inputIds": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "point": { "$ref": "#/$defs/point" },
        "evidenceIds": { "$ref": "#/$defs/evidenceRefs" },
        "profileData": { "$ref": "#/$defs/data" }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "title", "version", "locator", "sha256", "section"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["datasheet", "referenceManual", "sdk", "devicePack", "errata", "synthetic"] },
        "title": { "$ref": "#/$defs/name" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "locator": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "section": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "definitions": {
      "type": "object", "additionalProperties": false,
      "required": ["package", "pins", "peripherals", "clockTree", "evidence", "profileData"],
      "properties": {
        "package": { "$ref": "#/$defs/package" },
        "pins": { "type": "array", "minItems": 1, "maxItems": 512, "items": { "$ref": "#/$defs/pin" } },
        "peripherals": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/peripheral" } },
        "clockTree": {
          "type": "object", "additionalProperties": false, "required": ["nodes"],
          "properties": { "nodes": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/clockNode" } } }
        },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/evidence" } },
        "profileData": { "$ref": "#/$defs/data" }
      }
    },
    "pinSelection": {
      "type": "object", "additionalProperties": false,
      "required": ["pinId", "functionId", "label", "parameters"],
      "properties": {
        "pinId": { "$ref": "#/$defs/id" },
        "functionId": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "maxLength": 128 },
        "locked": { "type": "boolean", "default": false },
        "parameters": { "$ref": "#/$defs/data" }
      }
    },
    "peripheralSelection": {
      "type": "object", "additionalProperties": false,
      "required": ["peripheralId", "enabled", "parameters"],
      "properties": {
        "peripheralId": { "$ref": "#/$defs/id" },
        "enabled": { "type": "boolean" },
        "parameters": { "$ref": "#/$defs/data" }
      }
    },
    "clockSelection": {
      "type": "object", "additionalProperties": false,
      "required": ["nodeId", "enabled", "inputId", "parameters"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/id" },
        "enabled": { "type": "boolean" },
        "inputId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "parameters": { "$ref": "#/$defs/data" }
      }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["pins", "peripherals", "clocks", "profileData"],
      "properties": {
        "pins": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/pinSelection" } },
        "peripherals": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/peripheralSelection" } },
        "clocks": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/clockSelection" } },
        "profileData": { "$ref": "#/$defs/data" }
      }
    },
    "output": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {
          "allOf": [
            { "$ref": "#/$defs/relativePath" },
            { "pattern": "^(src/generated/mcuconfig/|include/generated/mcuconfig/).+\\.(c|h|cc|cpp|hpp)$" }
          ]
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "generation": {
      "type": "object", "additionalProperties": false,
      "required": ["generator", "inputSha256", "outputs"],
      "properties": {
        "generator": {
          "type": "object", "additionalProperties": false,
          "required": ["pluginId", "version", "contentSha256", "providerId"],
          "properties": {
            "pluginId": { "$ref": "#/$defs/id" },
            "version": { "$ref": "#/$defs/version" },
            "contentSha256": { "$ref": "#/$defs/sha256" },
            "providerId": { "$ref": "#/$defs/id" }
          }
        },
        "inputSha256": { "$ref": "#/$defs/sha256" },
        "outputs": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/output" } }
      }
    }
  }
}
