# XC8 uses its own whole-program compilation model; do not apply GCC detection or flags.
include_guard(GLOBAL)
function(pic_xc8_firmware target)
  foreach(required PIC_XC8_COMPILER PIC_DFP PIC_MCU)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
      message(FATAL_ERROR "${required} must be set explicitly")
    endif()
  endforeach()
  if(NOT EXISTS "${PIC_XC8_COMPILER}" OR NOT IS_DIRECTORY "${PIC_DFP}")
    message(FATAL_ERROR "XC8 compiler or device family pack is missing")
  endif()
  if(NOT PIC_MCU MATCHES "^16[A-Za-z0-9]+$")
    message(FATAL_ERROR "An exact PIC16 compiler target is required")
  endif()
  if(DEFINED PIC_EXPECTED_MCU AND NOT PIC_MCU STREQUAL PIC_EXPECTED_MCU)
    message(FATAL_ERROR "PIC_MCU differs from the selected project device")
  endif()
  get_target_property(sources ${target} INTERFACE_SOURCES)
  get_target_property(includes ${target} INTERFACE_INCLUDE_DIRECTORIES)
  get_target_property(definitions ${target} INTERFACE_COMPILE_DEFINITIONS)
  get_target_property(options ${target} INTERFACE_COMPILE_OPTIONS)
  get_target_property(libraries ${target} INTERFACE_LINK_LIBRARIES)
  if(libraries)
    message(FATAL_ERROR "XC8 whole-program build requires sources, includes, definitions and options on this target; linked targets are not supported")
  endif()
  foreach(group includes definitions options)
    if(NOT ${group})
      set(${group})
    endif()
  endforeach()
  if(NOT sources)
    message(FATAL_ERROR "Register C sources with target_sources(${target} INTERFACE ...)")
  endif()
  list(LENGTH sources source_count)
  if(source_count GREATER 128)
    message(FATAL_ERROR "At most 128 C translation units are supported")
  endif()
  set(arguments "-mcpu=${PIC_MCU}" "-mdfp=${PIC_DFP}" -std=c99 -O0 -g)
  if(PIC_DEBUGGER AND NOT PIC_DEBUGGER STREQUAL "none")
    if(NOT PIC_DEBUGGER STREQUAL "pickit3")
      message(FATAL_ERROR "Unsupported PIC debugger: ${PIC_DEBUGGER}")
    endif()
    # This reserves the exact device's debug executive resources in XC8.
    list(APPEND arguments "-mdebugger=${PIC_DEBUGGER}" -DSTUDIOX_PIC_DEBUG=1)
  endif()
  foreach(directory IN LISTS includes)
    if(directory MATCHES "\\$<")
      message(FATAL_ERROR "Generator expressions in PIC include directories are not supported")
    endif()
    list(APPEND arguments "-I${directory}")
  endforeach()
  foreach(definition IN LISTS definitions)
    if(definition MATCHES "\\$<")
      message(FATAL_ERROR "Generator expressions in PIC definitions are not supported")
    endif()
    list(APPEND arguments "-D${definition}")
  endforeach()
  foreach(option IN LISTS options)
    if(option MATCHES "\\$<")
      message(FATAL_ERROR "Generator expressions in PIC options are not supported")
    endif()
  endforeach()
  if(options)
    list(APPEND arguments ${options})
  endif()
  set(analysis "{}")
  foreach(group includes definitions)
    set(values "[]")
    set(index 0)
    foreach(value IN LISTS ${group})
      string(REPLACE "\\" "\\\\" value "${value}")
      string(REPLACE "\"" "\\\"" value "${value}")
      string(REPLACE "\n" "\\n" value "${value}")
      string(REPLACE "\r" "\\r" value "${value}")
      string(JSON values SET "${values}" ${index} "\"${value}\"")
      math(EXPR index "${index}+1")
    endforeach()
    string(JSON analysis SET "${analysis}" ${group} "${values}")
  endforeach()
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/pic-inputs.json" "${analysis}\n")
  set(inputs)
  foreach(source IN LISTS sources)
    if(NOT source MATCHES "\\.[cC]$" OR source MATCHES "\\$<")
      message(FATAL_ERROR "Only explicitly registered C sources are supported: ${source}")
    endif()
    get_source_file_property(per_file_options "${source}" COMPILE_OPTIONS)
    get_source_file_property(per_file_definitions "${source}" COMPILE_DEFINITIONS)
    if(per_file_options OR per_file_definitions)
      message(FATAL_ERROR "XC8 whole-program build requires target-level options and definitions")
    endif()
    if(NOT IS_ABSOLUTE "${source}")
      set(source "${CMAKE_CURRENT_SOURCE_DIR}/${source}")
    endif()
    list(APPEND inputs "${source}")
  endforeach()
  # Track all project headers, including indirect includes; new/deleted headers trigger reconfiguration.
  file(GLOB_RECURSE headers CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/*.h" "${CMAKE_SOURCE_DIR}/*.inc")
  set(elf "${CMAKE_CURRENT_BINARY_DIR}/firmware.elf")
  set(hex "${CMAKE_CURRENT_BINARY_DIR}/firmware.hex")
  add_custom_command(OUTPUT "${elf}" "${hex}"
    COMMAND "${PIC_XC8_COMPILER}" ${arguments} -o "${elf}" ${inputs}
    DEPENDS ${inputs} ${headers} "${PIC_XC8_COMPILER}" "${CMAKE_CURRENT_LIST_FILE}"
    WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}"
    COMMENT "XC8 ${PIC_MCU}: compile and link ${source_count} C source(s)"
    VERBATIM)
  add_custom_target(${target}_firmware ALL DEPENDS "${elf}" "${hex}")
endfunction()
