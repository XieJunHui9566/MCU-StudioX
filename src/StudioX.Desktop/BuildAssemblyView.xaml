<UserControl
  x:Class="StudioX.Desktop.BuildAssemblyView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:StudioX.Desktop"
  Background="{DynamicResource EditorSurface}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <DockPanel
      Margin="10,6">
      <Button
        DockPanel.Dock="Right"
        Content="关闭"
        Click="Close_Click"
        Padding="8,3" />
      <Button
        DockPanel.Dock="Right"
        Content="刷新"
        Click="Refresh_Click"
        Padding="8,3"
        Margin="0,0,6,0" />
      <TextBlock
        Text="编译汇编"
        FontWeight="SemiBold"
        VerticalAlignment="Center" />
    </DockPanel>
    <ComboBox
      Grid.Row="1"
      x:Name="Files"
      Margin="10,0,10,6"
      DisplayMemberPath="DisplayName"
      SelectionChanged="Files_SelectionChanged"
      AutomationProperties.Name="汇编文件与清单类型" />
    <StackPanel
      Grid.Row="2"
      Margin="10,0,10,6">
      <TextBlock
        x:Name="Hint"
        Text="成功编译后显示当前固件对应的汇编。"
        TextWrapping="Wrap"
        Foreground="{DynamicResource Muted}" />
      <CheckBox
        x:Name="Raw"
        Content="原始清单（含编译器注释）"
        Margin="0,6,0,0"
        Checked="Raw_Changed"
        Unchecked="Raw_Changed" />
    </StackPanel>
    <local:SafeTextEditor
      Grid.Row="3"
      x:Name="AssemblyEditor"
      IsReadOnly="True"
      ShowLineNumbers="False"
      Padding="8"
      Background="{DynamicResource EditorSurface}"
      Foreground="{DynamicResource Text}"
      HorizontalScrollBarVisibility="Auto"
      VerticalScrollBarVisibility="Auto" />
  </Grid>
</UserControl>
