<Window
  x:Class="StudioX.Desktop.EspressifDownloadWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="ESP 串口下载设置"
  Width="480"
  SizeToContent="Height"
  ResizeMode="NoResize"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
  Style="{StaticResource {x:Type Window}}">
  <Window.Resources>
    <!-- 可编辑端口使用专用模板；共享选择框模板没有 WPF 所需的编辑框部件。 -->
    <Style
      x:Key="EspressifPortPicker"
      TargetType="ComboBox"
      BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter
        Property="Template">
        <Setter.Value>
          <ControlTemplate
            TargetType="ComboBox">
            <Border
              x:Name="PortBorder"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="1"
              CornerRadius="4">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition
                    Width="32" />
                </Grid.ColumnDefinitions>
                <TextBox
                  x:Name="PART_EditableTextBox"
                  Style="{x:Null}"
                  Background="Transparent"
                  Foreground="{TemplateBinding Foreground}"
                  CaretBrush="{TemplateBinding Foreground}"
                  SelectionBrush="{DynamicResource Accent}"
                  FontFamily="{TemplateBinding FontFamily}"
                  FontSize="{TemplateBinding FontSize}"
                  IsReadOnly="{TemplateBinding IsReadOnly}"
                  Margin="10,6,0,6"
                  Padding="0"
                  VerticalContentAlignment="Center">
                  <TextBox.Template>
                    <ControlTemplate
                      TargetType="TextBox">
                      <ScrollViewer
                        x:Name="PART_ContentHost"
                        Focusable="False"
                        VerticalAlignment="Center"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled" />
                    </ControlTemplate>
                  </TextBox.Template>
                </TextBox>
                <ToggleButton
                  Grid.Column="1"
                  Focusable="False"
                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <ToggleButton.Template>
                    <ControlTemplate
                      TargetType="ToggleButton">
                      <Border
                        Background="Transparent">
                        <Path
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M0,0 L4,4 8,0"
                          Stroke="{DynamicResource Muted}"
                          StrokeThickness="1.2" />
                      </Border>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <Popup
                  x:Name="PART_Popup"
                  Placement="Bottom"
                  IsOpen="{TemplateBinding IsDropDownOpen}"
                  AllowsTransparency="True"
                  Focusable="False">
                  <Border
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    Padding="4"
                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                    <ScrollViewer
                      MaxHeight="300">
                      <ItemsPresenter />
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger
                Property="IsKeyboardFocusWithin"
                Value="True">
                <Setter
                  TargetName="PortBorder"
                  Property="BorderBrush"
                  Value="{DynamicResource Accent}" />
              </Trigger>
              <Trigger
                Property="IsEnabled"
                Value="False">
                <Setter
                  Property="Opacity"
                  Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <StackPanel
    Margin="24">
    <TextBlock
      Text="ESP 串口下载"
      FontSize="22"
      FontWeight="SemiBold"
      Margin="0,0,0,8" />
    <TextBlock
      x:Name="TargetLabel"
      TextWrapping="Wrap"
      Foreground="{DynamicResource Muted}"
      Margin="0,0,0,20" />
    <TextBlock
      Text="开发板使用的 COM 端口"
      Margin="0,0,0,7" />
    <DockPanel>
      <Button
        DockPanel.Dock="Right"
        Content="刷新"
        Click="RefreshPorts_Click"
        Margin="8,0,0,0" />
      <ComboBox
        x:Name="PortPicker"
        IsEditable="True"
        Style="{StaticResource EspressifPortPicker}" />
    </DockPanel>
    <TextBlock
      Text="下载波特率"
      Margin="0,16,0,7" />
    <ComboBox
      x:Name="BaudRatePicker" />
    <TextBlock
      Text="设置按工程保存。不会自动选择端口；串口采集占用此端口时需要先断开。点击下载后使用 SDK 实际生成的多映像布局，在确认页展示每个 BIN 的地址与 SHA-256。"
      TextWrapping="Wrap"
      Foreground="{DynamicResource Muted}"
      Margin="0,18,0,0" />
    <TextBlock
      x:Name="ErrorLabel"
      Foreground="#E87979"
      TextWrapping="Wrap"
      Margin="0,10,0,0" />
    <StackPanel
      Orientation="Horizontal"
      HorizontalAlignment="Right"
      Margin="0,12,0,0">
      <Button
        Content="取消"
        IsCancel="True"
        MinWidth="76"
        Margin="0,0,10,0" />
      <Button
        Content="保存设置"
        IsDefault="True"
        MinWidth="120"
        Style="{StaticResource PrimaryButton}"
        Click="Accept_Click" />
    </StackPanel>
  </StackPanel>
</Window>
