<UserControl x:Class="StudioX.Desktop.SerialTerminalView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:editor="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:local="clr-namespace:StudioX.Desktop">
 <UserControl.Resources>
  <Style x:Key="SerialEditableCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4"/></ControlTemplate></ToggleButton.Template></ToggleButton>
    <TextBox x:Name="PART_EditableTextBox" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" Foreground="{DynamicResource Text}" BorderThickness="0" Padding="0" Margin="8,5,26,5" VerticalContentAlignment="Center"/>
    <Path IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" Data="M0,0 L4,4 8,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.2"/>
    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="300"><ItemsPresenter/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <!-- 只让输入/接收表面承载半透明底色，避免父子叠加遮住背景；文字保持不透明。 -->
 <Grid Background="Transparent" Margin="14,10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="100"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" x:Name="ConnectionStatus" Text="未连接" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560"/><StackPanel Orientation="Horizontal"><local:Icon Kind="terminal" Foreground="{DynamicResource Accent}" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="串口终端" FontSize="19" FontWeight="SemiBold"/></StackPanel></DockPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,6">
   <StackPanel Width="114" Margin="0,0,8,0"><TextBlock Text="端口" Foreground="{DynamicResource Muted}" FontSize="11"/><ComboBox x:Name="PortPicker" AutomationProperties.Name="串口端口"/></StackPanel>
   <Button Content="刷新" Click="Refresh_Click" VerticalAlignment="Bottom" Margin="0,0,12,0" Padding="8,6"/>
   <WrapPanel x:Name="ConnectionParameters">
    <StackPanel Width="112" Margin="0,0,8,0"><TextBlock Text="波特率" Foreground="{DynamicResource Muted}" FontSize="11"/><ComboBox x:Name="BaudPicker" IsEditable="True" Style="{StaticResource SerialEditableCombo}" Text="115200" AutomationProperties.Name="串口波特率"/></StackPanel>
    <StackPanel Width="65" Margin="0,0,8,0"><TextBlock Text="数据位" Foreground="{DynamicResource Muted}" FontSize="11"/><ComboBox x:Name="BitsPicker" AutomationProperties.Name="串口数据位"/></StackPanel>
    <StackPanel Width="76" Margin="0,0,8,0"><TextBlock Text="停止位" Foreground="{DynamicResource Muted}" FontSize="11"/><ComboBox x:Name="StopPicker" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="串口停止位"/></StackPanel>
    <StackPanel Width="92" Margin="0,0,8,0"><TextBlock Text="校验位" Foreground="{DynamicResource Muted}" FontSize="11"/><ComboBox x:Name="ParityPicker" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="串口校验位"/></StackPanel>
    <StackPanel Width="166" Margin="0,0,10,0"><TextBlock Text="流控" Foreground="{DynamicResource Muted}" FontSize="11"/><ComboBox x:Name="FlowPicker" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Flow_Changed" AutomationProperties.Name="串口流控"/></StackPanel>
   </WrapPanel>
   <Button x:Name="ConnectButton" Content="连接串口" Click="Connect_Click" VerticalAlignment="Bottom" MinWidth="100" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" AutomationProperties.Name="连接或断开串口"/>
  </WrapPanel>
  <WrapPanel Grid.Row="2" Margin="0,4,0,10"><CheckBox x:Name="DtrCheck" Content="DTR" Click="Outputs_Click" Margin="0,0,15,0" ToolTip="手动控制 DTR。部分开发板将它接到复位或 BOOT 引脚，改变输出可能重启开发板。"/><CheckBox x:Name="RtsCheck" Content="RTS" Click="Outputs_Click" Margin="0,0,20,0" ToolTip="无硬件流控时手动控制 RTS。RTS/CTS 模式下由驱动管理；部分开发板将 RTS 用于自动复位。"/><TextBlock x:Name="PinsLabel" Text="CTS —   DSR —   DCD —" Foreground="{DynamicResource Muted}" Margin="0,0,18,0"/><TextBlock Text="参数修改后重新连接生效" Foreground="{DynamicResource Muted}" FontSize="11"/></WrapPanel>
  <WrapPanel Grid.Row="3" Margin="0,0,0,8">
   <TextBlock Text="接收" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="ReceiveMode" Width="144" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Display_Changed" AutomationProperties.Name="接收显示格式" Margin="0,0,12,0"/>
   <CheckBox x:Name="AnsiCheck" Content="ANSI 彩色" IsChecked="True" Click="Display_Click" VerticalAlignment="Center" Margin="0,0,12,0"/>
   <CheckBox x:Name="TimeCheck" Content="时间戳" Click="Timestamp_Click" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="宿主接收时间，不代表设备产生数据的时间"/>
   <CheckBox x:Name="FollowCheck" Content="自动滚动" IsChecked="True" Click="Follow_Click" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="向上滚动查看历史时暂时取消跟随；滚回底部或重新勾选后继续跟随。"/>
   <CheckBox x:Name="EchoCheck" Content="发送回显" Click="Display_Click" VerticalAlignment="Center" Margin="0,0,12,0"/>
   <Button x:Name="PauseButton" Content="暂停显示" Click="Pause_Click" Padding="8,4" Margin="0,0,8,0" ToolTip="只暂停界面刷新，后台继续接收；超过缓存上限的旧数据会丢弃。"/>
   <Button Content="清空显示" Click="Clear_Click" Padding="8,4" Margin="0,0,8,0"/><Button Content="导出…" Click="Export_Click" Padding="8,4"/>
  </WrapPanel>
  <TabControl x:Name="ReceiveTabs" Grid.Row="4">
   <TabItem Header="文字终端"><Border Background="{DynamicResource EditorSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="3">
   <editor:TextEditor x:Name="ReceiveEditor" IsReadOnly="True" ShowLineNumbers="False" FontFamily="Cascadia Mono, Consolas" FontSize="14" Foreground="{DynamicResource Text}" Background="Transparent" Padding="10" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="串口接收终端"/>
   </Border></TabItem>
   <TabItem Header="协议解析"><local:SerialProtocolView x:Name="ProtocolView"/></TabItem>
  </TabControl>
  <WrapPanel Grid.Row="5" Margin="0,10,0,7">
   <TextBlock Text="发送" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="SendMode" Width="144" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="发送数据格式" Margin="0,0,12,0"/>
   <TextBlock Text="末尾" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="EndingPicker" Width="86" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="发送行尾" Margin="0,0,12,0"/>
   <CheckBox x:Name="EscapeCheck" Content="转义序列" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="文本模式支持 \r \n \t \0 \e \xHH；例如 \e[31m红色\e[0m。HEX 模式不转换转义。"/>
   <TextBlock Text="历史" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="HistoryPicker" Width="180" SelectionChanged="History_Changed" AutomationProperties.Name="串口发送历史"/>
   <Button Content="补全 Modbus CRC" Click="AppendCrc_Click" Padding="8,3" Margin="12,0,0,0" ToolTip="把发送框作为不含 CRC 的 HEX 报文，追加 CRC 低字节和高字节；仅编辑，不会发送。"/>
   <Button Content="离线解析 RX" Click="AnalyzeOffline_Click" Padding="8,3" Margin="8,0,0,0" ToolTip="断开串口后，把发送框按当前发送格式解码，作为 RX 样例交给已启用解析器；不向设备发送。"/>
  </WrapPanel>
  <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="146"/></Grid.ColumnDefinitions>
   <TextBox x:Name="SendInput" Background="{DynamicResource EditorSurface}" AcceptsReturn="True" AcceptsTab="True" MaxLength="262144" Height="88" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" Padding="8" PreviewKeyDown="SendInput_KeyDown" AutomationProperties.Name="串口发送内容" ToolTip="Ctrl+Enter 发送；可输入多行文字或十六进制字节。"/>
   <StackPanel Grid.Column="1" Margin="10,0,0,0"><Button x:Name="SendButton" Content="发送 (Ctrl+Enter)" Click="Send_Click" IsEnabled="False"/><DockPanel Margin="0,8,0,0"><CheckBox x:Name="RepeatCheck" Content="定时" Click="Repeat_Click" VerticalAlignment="Center" IsEnabled="False"/><TextBox x:Name="IntervalInput" Background="{DynamicResource EditorSurface}" Text="1000" Width="55" Padding="3" Margin="5,0" ToolTip="周期 20–3600000 毫秒" AutomationProperties.Name="定时发送间隔"/><TextBlock Text="ms" VerticalAlignment="Center"/></DockPanel></StackPanel>
  </Grid>
  <DockPanel Grid.Row="7" Margin="0,9,0,0"><Button DockPanel.Dock="Right" Content="重置计数" Click="Counters_Click" Padding="7,2"/><TextBlock x:Name="Statistics" Text="RX 0 B    TX 0 B" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBlock x:Name="Notice" Foreground="{DynamicResource Muted}" Margin="16,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
 </Grid>
</UserControl>
