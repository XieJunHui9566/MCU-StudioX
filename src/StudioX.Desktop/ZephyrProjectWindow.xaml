<Window
  x:Class="StudioX.Desktop.ZephyrProjectWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Zephyr 实验模式 · 新建工程"
  Width="640"
  SizeToContent="Height"
  MaxHeight="720"
  ResizeMode="NoResize"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
  Style="{StaticResource {x:Type Window}}">
  <ScrollViewer
    VerticalScrollBarVisibility="Auto">
    <StackPanel
      Margin="24"
      Width="570">
      <TextBlock
        Text="Zephyr 实验模式"
        FontSize="22"
        FontWeight="SemiBold" />
      <TextBlock
        Text="此模式使用独立的 Zephyr .mcupack 格式和板级配置。当前 IDE 可创建并编辑工程，构建、下载和调试入口尚未开放。Zephyr 4.4.2 的外部构建请将工程放在不含空格的路径中。"
        TextWrapping="Wrap"
        Foreground="{DynamicResource Muted}"
        Margin="0,8,0,16" />
      <Button
        Content="导入 Zephyr .mcupack…"
        HorizontalAlignment="Left"
        Click="Import_Click" />
      <TextBlock
        Text="Zephyr 专用包"
        Margin="0,18,0,5" />
      <ComboBox
        x:Name="PackPicker"
        MinHeight="36"
        SelectionChanged="Pack_SelectionChanged">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <StackPanel
              Orientation="Horizontal">
              <TextBlock
                Text="{Binding Manifest.DisplayName}" />
              <TextBlock
                Text="{Binding Manifest.Version, StringFormat='  v{0}'}"
                Foreground="{DynamicResource Muted}" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock
        Text="板级目标"
        Margin="0,16,0,5" />
      <ComboBox
        x:Name="BoardPicker"
        DisplayMemberPath="DisplayName"
        MinHeight="36"
        IsEnabled="False"
        SelectionChanged="Board_SelectionChanged" />
      <TextBlock
        x:Name="BoardNote"
        TextWrapping="Wrap"
        Foreground="{DynamicResource Muted}"
        Margin="0,7,0,0" />
      <TextBlock
        Text="起始模板"
        Margin="0,16,0,5" />
      <ComboBox
        x:Name="TemplatePicker"
        DisplayMemberPath="DisplayName"
        MinHeight="36"
        IsEnabled="False"
        SelectionChanged="Template_SelectionChanged" />
      <TextBlock
        Text="{Binding SelectedItem.Description, ElementName=TemplatePicker}"
        TextWrapping="Wrap"
        Foreground="{DynamicResource Muted}"
        Margin="0,7,0,0" />
      <TextBlock
        Text="工程名称"
        Margin="0,16,0,5" />
      <TextBox
        x:Name="ProjectNameInput"
        Text="zephyr_experiment" />
      <TextBlock
        x:Name="StatusText"
        TextWrapping="Wrap"
        Foreground="{DynamicResource Muted}"
        Margin="0,14,0,0" />
      <StackPanel
        Orientation="Horizontal"
        HorizontalAlignment="Right"
        Margin="0,24,0,0">
        <Button
          Content="取消"
          IsCancel="True"
          MinWidth="78"
          Margin="0,0,10,0" />
        <Button
          x:Name="CreateButton"
          Content="选择位置并创建…"
          Style="{StaticResource PrimaryButton}"
          IsDefault="True"
          IsEnabled="False"
          Click="Create_Click" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
