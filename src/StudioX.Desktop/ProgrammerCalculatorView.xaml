<UserControl
  x:Class="StudioX.Desktop.ProgrammerCalculatorView"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  FontFamily="Segoe UI, Microsoft YaHei UI"
  FontSize="13"
  Foreground="{DynamicResource CalcText}"
  Background="{DynamicResource CalcBackground}"
  PreviewKeyDown="Calculator_KeyDown">
  <UserControl.Resources>
    <SolidColorBrush
      x:Key="CalcBackground"
      Color="#202020" />
    <SolidColorBrush
      x:Key="CalcSurface"
      Color="#292929" />
    <SolidColorBrush
      x:Key="CalcKey"
      Color="#343434" />
    <SolidColorBrush
      x:Key="CalcHover"
      Color="#454545" />
    <SolidColorBrush
      x:Key="CalcText"
      Color="#F5F5F5" />
    <SolidColorBrush
      x:Key="CalcMuted"
      Color="#B6B6B6" />
    <SolidColorBrush
      x:Key="CalcBorder"
      Color="#454545" />
    <SolidColorBrush
      x:Key="CalcAccent"
      Color="#99C9FF" />
    <SolidColorBrush
      x:Key="CalcOnAccent"
      Color="#102840" />
    <Style
      TargetType="Button">
      <Setter
        Property="Foreground"
        Value="{DynamicResource CalcText}" />
      <Setter
        Property="Background"
        Value="{DynamicResource CalcSurface}" />
      <Setter
        Property="BorderBrush"
        Value="{DynamicResource CalcBorder}" />
      <Setter
        Property="BorderThickness"
        Value="0" />
      <Setter
        Property="Padding"
        Value="8,6" />
      <Setter
        Property="Margin"
        Value="2" />
      <Setter
        Property="Focusable"
        Value="False" />
      <Setter
        Property="Template">
        <Setter.Value>
          <ControlTemplate
            TargetType="Button">
            <Border
              x:Name="KeyBorder"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="5"
              Padding="{TemplateBinding Padding}">
              <ContentPresenter
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger
                Property="IsMouseOver"
                Value="True">
                <Setter
                  TargetName="KeyBorder"
                  Property="Opacity"
                  Value="0.8" />
              </Trigger>
              <Trigger
                Property="IsPressed"
                Value="True">
                <Setter
                  TargetName="KeyBorder"
                  Property="Opacity"
                  Value="0.6" />
              </Trigger>
              <Trigger
                Property="IsEnabled"
                Value="False">
                <Setter
                  Property="Opacity"
                  Value="0.3" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style
      TargetType="TextBox">
      <Setter
        Property="Foreground"
        Value="{DynamicResource CalcText}" />
      <Setter
        Property="Background"
        Value="{DynamicResource CalcSurface}" />
      <Setter
        Property="CaretBrush"
        Value="{DynamicResource CalcText}" />
      <Setter
        Property="SelectionBrush"
        Value="{DynamicResource CalcAccent}" />
      <Setter
        Property="BorderBrush"
        Value="{DynamicResource CalcBorder}" />
      <Setter
        Property="Padding"
        Value="7,5" />
      <Setter
        Property="FontFamily"
        Value="Consolas, Microsoft YaHei UI" />
    </Style>
    <Style
      TargetType="TextBlock">
      <Setter
        Property="Foreground"
        Value="{DynamicResource CalcText}" />
    </Style>
    <Style
      x:Key="Caption"
      TargetType="TextBlock">
      <Setter
        Property="Foreground"
        Value="{DynamicResource CalcMuted}" />
      <Setter
        Property="Margin"
        Value="0,8,0,6" />
      <Setter
        Property="FontSize"
        Value="12" />
    </Style>
  </UserControl.Resources>
  <ScrollViewer
    VerticalScrollBarVisibility="Auto"
    HorizontalScrollBarVisibility="Disabled">
    <Grid
      x:Name="LayoutRoot"
      Margin="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition
          Width="*" />
        <ColumnDefinition
          x:Name="DetailsColumn"
          Width="280" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition
          Height="Auto" />
        <RowDefinition
          Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel
        x:Name="CalculatorBody"
        Margin="0,0,14,0">
        <TextBlock
          Text="程序员"
          FontSize="23"
          FontWeight="SemiBold"
          Margin="3,0,0,4" />
        <TextBlock
          Text="MCU StudioX · 定宽整数计算"
          Style="{StaticResource Caption}"
          Margin="3,0,0,12" />
        <TextBlock
          x:Name="PreviousExpression"
          TextTrimming="CharacterEllipsis"
          Foreground="{DynamicResource CalcMuted}"
          Height="23"
          TextAlignment="Right" />
        <TextBox
          x:Name="Expression"
          Text="0"
          FontSize="30"
          TextAlignment="Right"
          BorderThickness="0"
          Background="Transparent"
          MaxLength="1024"
          MinHeight="60"
          VerticalContentAlignment="Center"
          AutomationProperties.Name="计算表达式" />
        <TextBlock
          x:Name="StatusText"
          Text="Enter 计算 · Esc 清空 · 支持粘贴表达式"
          FontSize="11"
          MinHeight="34"
          TextWrapping="Wrap"
          Margin="4,4,0,4"
          Foreground="{DynamicResource CalcMuted}" />
        <StackPanel
          x:Name="BaseRows" />
        <Grid
          Margin="0,10,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition
              Width="*" />
            <ColumnDefinition
              Width="Auto" />
          </Grid.ColumnDefinitions>
          <WrapPanel
            x:Name="WidthButtons" />
          <Button
            x:Name="SignedButton"
            Grid.Column="1"
            Content="无符号"
            Click="Signed_Click"
            ToolTip="影响十进制显示、除法、取余和算术右移" />
        </Grid>
        <UniformGrid
          x:Name="Keypad"
          Columns="6"
          Rows="6" />
        <WrapPanel
          Margin="0,8,0,0">
          <Button
            Content="复制数值"
            Click="CopyValue_Click" />
          <Button
            Content="复制 C 常量"
            Click="CopyConstant_Click" />
          <Button
            Content="&gt;&gt;&gt; 逻辑右移"
            Tag="&gt;&gt;&gt;"
            Click="ExtraOperator_Click" />
          <Button
            Content="NAND"
            Tag="NAND"
            Click="ExtraOperator_Click" />
          <Button
            Content="NOR"
            Tag="NOR"
            Click="ExtraOperator_Click" />
        </WrapPanel>
        <TextBlock
          Text="输入溢出会报错；运算保留低位。缩窄位宽保留低位。"
          Style="{StaticResource Caption}"
          TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel
        x:Name="McuDetails"
        Grid.Column="1"
        Margin="8,0,0,0">
        <TextBlock
          Text="寄存器与内存"
          FontSize="17"
          FontWeight="SemiBold"
          Margin="0,6,0,8" />
        <TextBlock
          Text="点击位值可翻转；bit 0 为最低位"
          Style="{StaticResource Caption}" />
        <UniformGrid
          x:Name="Bits"
          Columns="8" />
        <TextBlock
          x:Name="IntegerInterpretation"
          Style="{StaticResource Caption}"
          TextWrapping="Wrap" />
        <TextBlock
          Text="内存字节序 · 低地址 → 高地址"
          Style="{StaticResource Caption}" />
        <TextBlock
          Text="小端 LE"
          FontSize="11"
          Foreground="{DynamicResource CalcMuted}" />
        <TextBox
          x:Name="LittleEndian"
          IsReadOnly="True"
          Margin="0,3,0,7"
          AutomationProperties.Name="小端字节序" />
        <TextBlock
          Text="大端 BE"
          FontSize="11"
          Foreground="{DynamicResource CalcMuted}" />
        <TextBox
          x:Name="BigEndian"
          IsReadOnly="True"
          Margin="0,3,0,7"
          AutomationProperties.Name="大端字节序" />
        <TextBlock
          Text="C / C++ 定宽常量"
          Style="{StaticResource Caption}" />
        <TextBox
          x:Name="Constant"
          IsReadOnly="True"
          TextWrapping="Wrap"
          AutomationProperties.Name="C定宽常量" />
        <WrapPanel
          Margin="0,12,0,4">
          <Button
            x:Name="CalculatorMode"
            Content="计算器"
            Tag="calculator"
            Click="Mode_Click" />
          <Button
            x:Name="FieldMode"
            Content="位域工具"
            Tag="bitfield"
            Click="Mode_Click" />
        </WrapPanel>
        <StackPanel
          x:Name="FieldControls"
          Visibility="Collapsed">
          <TextBlock
            Text="位域 [起始位, 长度]"
            Style="{StaticResource Caption}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBox
              x:Name="FieldStart"
              Text="0"
              Margin="0,0,4,0"
              AutomationProperties.Name="位域起始位" />
            <TextBox
              x:Name="FieldCount"
              Text="1"
              Grid.Column="1"
              Margin="4,0,0,0"
              AutomationProperties.Name="位域长度" />
          </Grid>
          <TextBlock
            Text="替换值（仅替换操作使用）"
            Style="{StaticResource Caption}" />
          <TextBox
            x:Name="FieldOperand"
            Text="0"
            MaxLength="1024"
            AutomationProperties.Name="位域替换值" />
          <WrapPanel
            Margin="0,6,0,4">
            <Button
              Content="提取"
              Tag="inspect"
              Click="Field_Click" />
            <Button
              Content="置 1"
              Tag="set"
              Click="Field_Click" />
            <Button
              Content="清 0"
              Tag="clear"
              Click="Field_Click" />
            <Button
              Content="翻转"
              Tag="toggle"
              Click="Field_Click" />
            <Button
              Content="替换"
              Tag="replace"
              Click="Field_Click" />
          </WrapPanel>
          <TextBlock
            x:Name="FieldResult"
            Style="{StaticResource Caption}"
            TextWrapping="Wrap" />
        </StackPanel>
        <Button
          Content="复制完整结果与代码"
          Click="CopyAll_Click"
          HorizontalAlignment="Left"
          Margin="0,10,0,0" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
