          <ComboBox x:Name="TemplatePicker" DisplayMemberPath="DisplayName" IsEnabled="False" SelectionChanged="TemplatePicker_SelectionChanged"/>
          <TextBlock Text="{Binding SelectedItem.Description, ElementName=TemplatePicker}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
          <Border x:Name="Ag32LogicModePanel" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,18,0,0" Visibility="Collapsed">
           <StackPanel>
            <CheckBox x:Name="Ag32LogicModeCheckBox" Content="启用 AG32 逻辑/Verilog 特殊模式" FontWeight="SemiBold" AutomationProperties.Name="启用 AG32 逻辑 Verilog 特殊模式"/>
            <TextBlock Text="AG32VF303CCT6 · 2K 逻辑单元 · AGRV2KL48 / LQFP48" Foreground="{DynamicResource Muted}" Margin="22,7,0,0"/>
            <TextBlock Text="需要 Quartus II Full 与 Supra（Supra 通常随 AgRV SDK 提供）。先用 AgRV SDK 的 Prepare LOGIC 从 .ve 生成顶层和工程，再由 Quartus II 编译成 .vo、Supra 转换为逻辑 .bin。逻辑下载需对应厂商工具与烧录器，且与 MCU 固件分开。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="22,7,0,0" LineHeight="20"/>
           </StackPanel>
          </Border>
          <TextBlock Text="工程名称" Style="{StaticResource SectionLabel}"/>
          <TextBox x:Name="ProjectName" Text="my_firmware"/>
          <TextBlock Text="创建后自动初始化 Git 仓库；编译产物不纳入版本管理。" Foreground="{DynamicResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"/><Button x:Name="CreateProjectButton" Content="选择位置并创建工程…" Style="{StaticResource PrimaryButton}" IsEnabled="False" HorizontalAlignment="Left" Margin="0,24,0,0" Click="CreateProject_Click"/>
          <TextBlock x:Name="PackageStatus" Text="尚未安装器件包。请导入 StudioX 格式 1 的 .mcupack。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,18,0,0"/>
         </StackPanel>
         </Grid>
        </ScrollViewer>
       </Border>
      </TabItem>
      <TabItem Header="Git 图谱" x:Name="GitGraphTab" Visibility="Collapsed"><local:GitGraphView x:Name="GitGraph"/></TabItem>
      <TabItem Header="GitHub 协作" x:Name="GitHubWorkspaceTab" Visibility="Collapsed"><local:GitHubWorkspaceView x:Name="GitHubWorkspace"/></TabItem>
      <TabItem Header="串口绘图" x:Name="SerialPlotTab" Visibility="Collapsed"><local:SerialPlotView x:Name="SerialPlotView"/></TabItem>
      <TabItem Header="串口终端" x:Name="SerialTab" Visibility="Collapsed"><local:SerialTerminalView x:Name="SerialView"/></TabItem>
      <TabItem Header="波形演示" x:Name="LabTab" Visibility="Collapsed"><Grid Background="{DynamicResource EditorSurface}"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel><TextBlock Text="数据观察" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="模拟传感器 · 温度与数字状态，真实串口将在后续接入" Foreground="{DynamicResource Muted}" Margin="0,8,0,18"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18"><Button x:Name="SimulationButton" Content="连接模拟设备" Click="Simulation_Click" Margin="0,0,10,0"/><Button x:Name="RecordButton" Content="开始记录" Click="Record_Click" IsEnabled="False"/><TextBlock x:Name="FrameStatus" Text="未连接" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0"/></StackPanel><local:SignalPlot Grid.Row="2" x:Name="Plot"/></Grid></Grid></TabItem>
      <TabItem Header="插件与工具集" x:Name="ExtensionsTab" Visibility="Collapsed">
       <Border Background="{DynamicResource EditorSurface}"><ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28" MaxWidth="760">
         <TextBlock Text="插件与工具集" FontSize="23" FontWeight="SemiBold"/>
         <TextBlock Text="管理工作台的开发组件与数据解码扩展。" Foreground="{DynamicResource Muted}" Margin="0,8,0,16"/>
         <TextBlock Text="内置工具" Style="{StaticResource SectionLabel}"/>
         <Button Content="检查内置工具链" Click="VerifyTools_Click" HorizontalAlignment="Left" Margin="0,0,0,12"/>
         <TextBox x:Name="ToolInventory" IsReadOnly="True" MinHeight="80" TextWrapping="Wrap"/>
         <TextBlock Text="工程按器件包自动选择工具集。F7 编译；支持下载的器件包可选择 ST-Link、CMSIS-DAP 或 J-Link。已收录的 STM32F1/F4 型号可选择 ST-Link 或 DAP-Link，通过 OpenOCD 调试。AG32VF303 新版包支持官方 AGM BLASTER；也可选择 F407 离线示例预览操作。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,12,0,0"/>
         <TextBlock Text="AI 技能" Style="{StaticResource SectionLabel}" Margin="0,22,0,8"/>
         <TextBlock Text="用户技能可在工程中使用。工程内技能默认关闭，启用前请确认来源。技能说明不会直接获得文件或设备操作权限。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12"/>
         <TextBlock x:Name="SkillsProjectText" Text="打开工程后查看技能。" TextWrapping="Wrap" Margin="0,10,0,0"/>
         <StackPanel Orientation="Horizontal" Margin="0,9,0,10">
          <CheckBox x:Name="ProjectSkillsEnabledToggle" Content="启用当前工程中的技能" IsEnabled="False" VerticalAlignment="Center" Checked="ProjectSkillsEnabled_Changed" Unchecked="ProjectSkillsEnabled_Changed"/>
          <Button x:Name="SkillsRefreshButton" Content="刷新技能" Click="SkillsRefresh_Click" Margin="18,0,0,0" Padding="10,5"/>
         </StackPanel>
         <ItemsControl x:Name="SkillsList">
          <ItemsControl.ItemTemplate><DataTemplate>
           <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,9">
            <StackPanel>
             <DockPanel LastChildFill="False"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding ScopeLabel}" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="11"/></DockPanel>
             <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
           </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
         <TextBlock x:Name="SkillsEmptyHint" Text="尚未发现技能。" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
         <TextBlock x:Name="SkillsDiagnosticText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" Visibility="Collapsed"/>
         <TextBlock Text="数据解码插件" Style="{StaticResource SectionLabel}"/>
         <ComboBox x:Name="PluginPicker"/>
         <StackPanel Orientation="Horizontal" Margin="0,14,0,12"><TextBox x:Name="PluginInput" Text="24.5,1" Width="190" Margin="0,0,12,0"/><Button Content="运行解码器" Click="Decode_Click"/></StackPanel>
         <TextBox x:Name="PluginOutput" IsReadOnly="True" MinHeight="140" TextWrapping="Wrap"/>
         <TextBlock Text="仅运行你信任的插件。插件具有当前用户权限。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,16,0,0"/>
        </StackPanel>
       </ScrollViewer></Border>
      </TabItem>
     </TabControl>
     <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="{DynamicResource Background}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>
     <Grid Grid.Row="2" x:Name="BottomPanel" Background="{DynamicResource ToolSurface}"><TabControl x:Name="BottomTabs"><TabItem Header="构建"><TextBox x:Name="BuildLog" Text="构建输出将在这里显示。" Background="Transparent" BorderThickness="0" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="14,10"/></TabItem><TabItem Header="设备输出"><TextBox x:Name="DeviceLog" Text="尚未连接设备。" Background="Transparent" BorderThickness="0" IsReadOnly="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" Padding="14,10"/></TabItem><TabItem x:Name="DebugTab" Header="调试" Visibility="Collapsed"><local:DebugToolsView x:Name="DebugTools"/></TabItem><TabItem x:Name="ProjectTerminalTab" Header="终端" GotFocus="ProjectTerminalTab_GotFocus"><local:ProjectTerminalView x:Name="ProjectTerminal"/></TabItem></TabControl><Button Style="{StaticResource ToolButton}" ToolTip="隐藏工具窗口 (Alt+4)" Click="ToggleBottom_Click" HorizontalAlignment="Right" VerticalAlignment="Top"><local:Icon Kind="minus" /></Button></Grid>
    </Grid>
    <Border x:Name="AiSidebar" Grid.Column="5" Visibility="Collapsed" Background="{DynamicResource ToolSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
     <Grid Margin="12,0,12,10">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,10,0,11">
       <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" ToolTip="收起 AI 助手" Click="AiClose_Click" AutomationProperties.Name="收起 AI 助手"><local:Icon Kind="close"/></Button>
       <Button x:Name="AiNewConversationButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" ToolTip="新对话" Click="AiNewConversation_Click" AutomationProperties.Name="新建 AI 对话"><local:Icon Kind="new-chat" Foreground="{DynamicResource Muted}"/></Button>
       <Button x:Name="AiHistoryButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" ToolTip="历史对话" Click="AiHistoryButton_Click" AutomationProperties.Name="查看当前工程历史对话"><local:Icon Kind="history" Foreground="{DynamicResource Muted}"/></Button>
       <StackPanel><TextBlock Text="AI 助手" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="AiConversationHeading" Visibility="Collapsed" Foreground="{DynamicResource Muted}" FontSize="11" MaxWidth="200" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,3,0,0"/></StackPanel>
      </DockPanel>
      <Popup x:Name="AiHistoryPopup" Grid.Row="0" PlacementTarget="{Binding ElementName=AiHistoryButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" PreviewKeyDown="AiPopup_PreviewKeyDown">
       <Border Width="310" MaxHeight="410" CornerRadius="12" Padding="12" Focusable="True" Background="{DynamicResource ToolSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <DockPanel LastChildFill="False" Margin="0,0,0,9"><TextBlock Text="本工程的历史对话" FontWeight="SemiBold"/><TextBlock x:Name="AiHistoryCount" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="11"/></DockPanel>
         <Grid Grid.Row="1"><ListBox x:Name="AiConversationPicker" MaxHeight="310" Background="Transparent" Foreground="{DynamicResource Text}" BorderThickness="0" SelectionChanged="AiConversationPicker_SelectionChanged" AutomationProperties.Name="当前工程的历史对话">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
           <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
           <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="HistoryItemChrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Margin="1,2" Padding="9,7"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers>
             <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HistoryItemChrome" Property="Background" Value="#28424A59"/></Trigger>
             <Trigger Property="IsSelected" Value="True"><Setter TargetName="HistoryItemChrome" Property="Background" Value="#3D465675"/><Setter TargetName="HistoryItemChrome" Property="BorderBrush" Value="#6B6580AA"/></Trigger>
             <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="HistoryItemChrome" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
           </ControlTemplate></Setter.Value></Setter>
          </Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding UpdatedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
         </ListBox><TextBlock x:Name="AiHistoryEmptyHint" Text="这个工程还没有历史对话。" Visibility="Collapsed" Foreground="{DynamicResource Muted}" Margin="4,16" HorizontalAlignment="Center"/></Grid>
         <Button x:Name="AiDeleteConversationButton" Grid.Row="2" Style="{StaticResource ToolButton}" Width="Auto" Height="28" HorizontalAlignment="Right" Click="AiDeleteConversation_Click" ToolTip="删除当前选中的对话" AutomationProperties.Name="删除选中的 AI 对话" Margin="0,9,0,0"><StackPanel Orientation="Horizontal"><local:Icon Kind="trash" Width="15" Height="15" Foreground="{DynamicResource Muted}" Margin="0,0,4,0"/><TextBlock Text="删除选中对话" FontSize="11"/></StackPanel></Button>
        </Grid>
       </Border>
      </Popup>
      <Grid Grid.Row="1">
       <ScrollViewer x:Name="AiTranscript" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Background="{DynamicResource EditorSurface}">
        <StackPanel x:Name="AiTranscriptItems" Margin="10"/>
       </ScrollViewer>
       <StackPanel x:Name="AiEmptyHint" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="250">
        <local:Icon Kind="ai" Width="26" Height="26" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
        <TextBlock Text="有什么可以一起处理？" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        <TextBlock Text="打开工程后，可以让我阅读代码、解释问题或提出修改。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,0"/>
       </StackPanel>
       <TextBlock x:Name="AiUnconfiguredHint" Text="未配置 API" Foreground="{DynamicResource Muted}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <TextBlock Grid.Row="2" x:Name="AiStatus" Visibility="Collapsed" Text="打开工程后可以提问。工程文本会发送到所配置的 API 服务。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,8" FontSize="11"/>
      <Grid x:Name="AiPromptPanel" Grid.Row="3" Visibility="Collapsed">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Border x:Name="AiSteeringBanner" Grid.Row="0" Visibility="Collapsed" Background="{DynamicResource ChromeSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="9" Padding="9,6" Margin="0,0,0,6">
        <DockPanel LastChildFill="True">
         <Button DockPanel.Dock="Right" Content="×" Click="AiSteeringRemove_Click" Style="{StaticResource ToolButton}" Width="24" Height="24" ToolTip="撤回尚未注入的提示" AutomationProperties.Name="撤回待注入提示"/>
         <StackPanel><TextBlock x:Name="AiSteeringCount" Text="待注入 · 当前步骤完成后应用" Foreground="{DynamicResource Muted}" FontSize="10"/><TextBlock x:Name="AiSteeringText" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text}" FontSize="11" Margin="0,2,6,0"/></StackPanel>
        </DockPanel>
       </Border>
       <Border Grid.Row="1" Background="{DynamicResource EditorSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="13" Padding="7,6">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <TextBox x:Name="AiPromptInput" Grid.Row="0" MinHeight="68" MaxHeight="130" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="4" Background="Transparent" BorderThickness="0" ToolTip="向 AI 助手提问；工程修改会逐次请求授权"/>
         <TextBlock x:Name="AiCacheUsageText" Grid.Row="1" Text="缓存：发送后显示 API 用量" Foreground="{DynamicResource Muted}" FontSize="11" Margin="4,2,4,0" TextTrimming="CharacterEllipsis" ToolTip="发送消息后显示 API 实际返回的缓存命中和未命中 token。" AutomationProperties.Name="缓存用量"/>
         <Grid Grid.Row="2" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="AiModelButton" Grid.Column="1" Click="AiModelButton_Click" Background="Transparent" BorderBrush="Transparent" Padding="3,3" ToolTip="点击选择思考强度" AutomationProperties.Name="模型和思考强度"><StackPanel Orientation="Horizontal"><TextBlock x:Name="AiModelButtonText" Text="deepseek-flash · 高" MaxWidth="165" TextTrimming="CharacterEllipsis" FontSize="11" VerticalAlignment="Center"/><local:Icon Kind="chevron" Width="10" Height="10" Foreground="{DynamicResource Muted}" Margin="2,0,0,0"><local:Icon.RenderTransform><RotateTransform Angle="90" CenterX="5" CenterY="5"/></local:Icon.RenderTransform></local:Icon></StackPanel></Button>
          <Grid x:Name="AiContextBadge" Grid.Column="2" Width="22" Height="22" Margin="4,0,5,0" VerticalAlignment="Center" ToolTip="尚无上下文用量" AutomationProperties.Name="上下文用量"><Ellipse x:Name="AiContextTrack" Width="17" Height="17" Stroke="{DynamicResource Border}" StrokeThickness="3"/><Path x:Name="AiContextArc" Stroke="{DynamicResource Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/><Ellipse x:Name="AiContextFull" Width="17" Height="17" Stroke="{DynamicResource Accent}" StrokeThickness="3" Visibility="Collapsed"/></Grid>
          <Button x:Name="AiCancelButton" Grid.Column="3" Content="停止" Click="AiCancel_Click" IsEnabled="False" Visibility="Collapsed" Padding="6,3" Margin="0,0,5,0"/>
          <Button x:Name="AiSendButton" Grid.Column="4" Content="↑" Click="AiSend_Click" Width="32" Height="32" FontSize="18" FontWeight="SemiBold" Foreground="White" Background="{DynamicResource Accent}" BorderThickness="0" ToolTip="发送" AutomationProperties.Name="发送 AI 消息"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="SendCircle" Background="{TemplateBinding Background}" CornerRadius="16"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="SendCircle" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>
         </Grid>
        </Grid>
       </Border>
       <Popup x:Name="AiModelPopup" PlacementTarget="{Binding ElementName=AiModelButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" PreviewKeyDown="AiPopup_PreviewKeyDown">
        <Border Width="285" CornerRadius="12" Padding="14" Focusable="True" Background="{DynamicResource ToolSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
         <StackPanel><TextBlock x:Name="AiPopupModelName" Text="deepseek-flash" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <DockPanel LastChildFill="False" Margin="0,12,0,0"><TextBlock Text="思考强度" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock x:Name="AiThinkingValue" DockPanel.Dock="Right" FontWeight="SemiBold" FontSize="11" Text="高"/></DockPanel>
          <Slider x:Name="AiThinkingSlider" Minimum="0" Maximum="3" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AiThinkingSlider_ValueChanged" Margin="0,8,0,0" ToolTip="DeepSeek 思考强度：关闭、低、高、最大" AutomationProperties.Name="思考强度"/>
          <TextBlock x:Name="AiThinkingHint" Text="关闭     ·     低     ·     高     ·     最大" Foreground="{DynamicResource Muted}" FontSize="10" TextAlignment="Center" Margin="0,3,0,0"/>
         </StackPanel>
        </Border>
       </Popup>
      </Grid>
     </Grid>
    </Border>
    <GridSplitter x:Name="AiSidebarSplitter" Grid.Column="4" Visibility="Collapsed" HorizontalAlignment="Stretch" Background="{DynamicResource Border}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
    <Border Grid.Column="6" Background="{DynamicResource ChromeSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0"><StackPanel><Button Style="{StaticResource RightRailButton}" ToolTip="欢迎页" Click="Welcome_Click"><local:Icon Kind="home" /></Button><Button Style="{StaticResource RightRailButton}" ToolTip="外观与背景" Click="Appearance_Click"><local:Icon Kind="image" /></Button></StackPanel></Border>
   </Grid>
   <Border Grid.Row="5" Background="{DynamicResource ChromeSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"><DockPanel Margin="12,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="C / C++" FontSize="11" Foreground="{DynamicResource Muted}" Margin="16,0"/><TextBlock Text="UTF-8" FontSize="11" Foreground="{DynamicResource Muted}" Margin="12,0"/><TextBlock Text="{x:Static local:ProductInfo.DisplayName}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="12,0"/></StackPanel><TextBlock x:Name="Status" Text="就绪" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
  </Grid>
 </Grid></Border>
</Window>
