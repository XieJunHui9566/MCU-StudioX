<Window x:Class="StudioX.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:StudioX.Desktop" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:editor="http://icsharpcode.net/sharpdevelop/avalonedit"
 Title="MCU StudioX" Icon="Assets/StudioX.ico" Style="{StaticResource {x:Type Window}}" Width="1460" Height="920" MinWidth="1100" MinHeight="720" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" StateChanged="Window_StateChanged" Activated="Window_Activated" Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.InputBindings><KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save"/><KeyBinding Key="O" Modifiers="Control" Command="ApplicationCommands.Open"/><KeyBinding Key="N" Modifiers="Control" Command="ApplicationCommands.New"/></Window.InputBindings>
 <Window.CommandBindings><CommandBinding Command="ApplicationCommands.Save" Executed="Save_Click"/><CommandBinding Command="ApplicationCommands.Open" Executed="OpenProject_Click"/><CommandBinding Command="ApplicationCommands.New" Executed="NewProject_Click"/></Window.CommandBindings>
 <Border BorderBrush="{DynamicResource Border}" BorderThickness="1"><Grid x:Name="WindowRoot" ClipToBounds="True">
  <Grid x:Name="BackgroundLayer" IsHitTestVisible="False" Visibility="Collapsed"><Grid x:Name="MediaLayer"><Image x:Name="BackgroundImage" Stretch="UniformToFill"/><MediaElement x:Name="BackgroundVideo" LoadedBehavior="Manual" UnloadedBehavior="Manual" Volume="0" IsMuted="True" Stretch="UniformToFill" MediaEnded="BackgroundVideo_MediaEnded" MediaOpened="BackgroundVideo_MediaOpened" MediaFailed="BackgroundVideo_MediaFailed"/></Grid><Border x:Name="BackgroundDim" Background="Black"/></Grid>
  <Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="30"/><RowDefinition Height="39"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="26"/></Grid.RowDefinitions>
   <Border Background="{DynamicResource ChromeSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Image Source="{StaticResource StudioXMark}" Width="28" Height="28" Stretch="Uniform" AutomationProperties.Name="MCU StudioX 标识"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True"><TextBlock Text="MCU StudioX" FontWeight="SemiBold"/><TextBlock Text=" / " Foreground="{DynamicResource Muted}" Margin="10,0"/><TextBlock x:Name="WindowProjectTitle" Text="欢迎" Foreground="{DynamicResource Muted}" MaxWidth="320" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><Border Background="{DynamicResource Panel}" CornerRadius="3" Margin="14,0,0,0" Padding="6,2"><TextBlock Text="PREVIEW" FontSize="9" Foreground="{DynamicResource Muted}"/></Border></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
      <Button x:Name="AiToggleButton" Style="{StaticResource ToolButton}" Width="34" Height="30" Margin="0,4,8,4" Click="AiAssistant_Click" ToolTip="打开右侧 AI 助手" AutomationProperties.Name="打开右侧 AI 助手"><local:Icon Kind="ai" Foreground="{DynamicResource Accent}"/></Button>
      <Button x:Name="GitHubIdentityButton" Style="{StaticResource LabeledToolButton}" Height="30" Margin="0,4,10,4" Click="GitHubWorkspace_Click" ToolTip="未登录 GitHub · 点击打开协作页登录" AutomationProperties.Name="未登录 GitHub">
       <StackPanel Orientation="Horizontal">
        <Grid x:Name="GitHubAvatarContainer" Width="22" Height="22" Margin="0,0,7,0" Visibility="Collapsed">
         <Ellipse Fill="{DynamicResource Accent}"/>
         <TextBlock x:Name="GitHubAvatarInitial" Text="G" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         <Ellipse x:Name="GitHubAvatarImage" Visibility="Collapsed"><Ellipse.Fill><ImageBrush x:Name="GitHubAvatarBrush" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
        </Grid>
        <TextBlock x:Name="GitHubIdentityName" Text="未登录 GitHub" MaxWidth="135" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
       </StackPanel>
      </Button>
      <Button Style="{StaticResource ToolButton}" ToolTip="最小化" Click="Minimize_Click" Width="44" Height="36"><local:Icon Kind="minus" /></Button><Button Style="{StaticResource ToolButton}" ToolTip="最大化 / 还原" Click="Maximize_Click" Width="44" Height="36"><local:Icon Kind="maximize" /></Button><Button Style="{StaticResource ToolButton}" ToolTip="关闭" Click="Close_Click" Width="44" Height="36"><local:Icon Kind="close" /></Button>
    </StackPanel>
   </Grid></Border>
   <Border Grid.Row="1" Background="{DynamicResource ChromeSurface}"><Menu Margin="5,0">
    <MenuItem Header="文件(_F)"><MenuItem Header="新建工程…" InputGestureText="Ctrl+N" Click="NewProject_Click"/><MenuItem Header="打开工程…" InputGestureText="Ctrl+O" Click="OpenProject_Click"/><MenuItem Header="导入 CubeMX CMake 工程…" Click="ImportCubeMx_Click"/><MenuItem Header="保存" InputGestureText="Ctrl+S" Click="Save_Click"/><MenuItem Header="全部保存" InputGestureText="Ctrl+Shift+S" Click="SaveAll_Click"/><MenuItem x:Name="CloseProjectMenu" Header="关闭工程" InputGestureText="Ctrl+Shift+W" IsEnabled="False" Click="CloseProject_Click"/><MenuItem Header="关闭当前标签" InputGestureText="Ctrl+W" Click="CloseDocument_Click"/><Separator/><MenuItem Header="导入器件包…" Click="ImportPack_Click"/><MenuItem x:Name="CheckPackUpdatesMenu" Header="检查 GitHub 器件包更新…" Click="CheckPackUpdates_Click"/><MenuItem x:Name="SyncPacksMenu" Header="从 GitHub 同步下载器件包…" Click="SyncPacks_Click"/><Separator/><MenuItem Header="退出" Click="Close_Click"/></MenuItem>
    <MenuItem Header="编辑(_E)"><MenuItem Header="撤销" Command="ApplicationCommands.Undo"/><MenuItem Header="重做" Command="ApplicationCommands.Redo"/><Separator/><MenuItem Header="剪切" Command="ApplicationCommands.Cut"/><MenuItem Header="复制" Command="ApplicationCommands.Copy"/><MenuItem Header="粘贴" Command="ApplicationCommands.Paste"/><Separator/><MenuItem Header="代码提示" InputGestureText="Ctrl+Space" Click="CompleteCode_Click"/><MenuItem Header="参数提示" InputGestureText="Ctrl+Shift+Space" Click="ParameterInfo_Click"/><Separator/><MenuItem Header="切换行注释" InputGestureText="Ctrl+/" Command="local:SourceCommands.ToggleComment" CommandTarget="{Binding ElementName=SourceEditor}"/></MenuItem>
    <MenuItem Header="视图(_V)"><MenuItem Header="欢迎页" Click="Welcome_Click"/><MenuItem Header="编辑器字号"><MenuItem Header="放大" Click="ZoomIn_Click"/><MenuItem Header="缩小" Click="ZoomOut_Click"/><MenuItem Header="恢复默认字号" Click="ZoomReset_Click"/></MenuItem><MenuItem Header="工程窗口" InputGestureText="Alt+1" Click="ToggleProject_Click"/><MenuItem Header="底部工具窗口" InputGestureText="Alt+4" Click="ToggleBottom_Click"/><Separator/><MenuItem Header="外观与背景…" InputGestureText="Ctrl+Alt+S" Click="Appearance_Click"/></MenuItem>
    <MenuItem Header="构建(_B)"><MenuItem x:Name="BuildMenu" IsEnabled="False" Header="编译工程" InputGestureText="F7" Click="Build_Click"/><MenuItem Header="停止构建" Click="Cancel_Click"/><Separator/><MenuItem x:Name="DownloadMenu" Header="下载固件" IsEnabled="False" Click="Download_Click"/><MenuItem x:Name="DownloadSettingsMenu" Header="下载设置…" IsEnabled="False" Click="DownloadSettings_Click"/><MenuItem x:Name="Ag32LogicMenu" Header="AG32 逻辑模式…" Visibility="Collapsed" Click="Ag32Logic_Click"/><MenuItem x:Name="BuildLogicButton" Header="AG32 逻辑构建指引…" Visibility="Collapsed" Click="BuildLogic_Click"/><MenuItem x:Name="DownloadLogicButton" Header="AG32 逻辑下载指引…" Visibility="Collapsed" Click="DownloadLogic_Click"/></MenuItem>
    <MenuItem x:Name="DebugTopMenu" Header="调试(_D)">
     <MenuItem x:Name="DebugStartMenu" Header="启动 / 结束调试" InputGestureText="Ctrl+F5" Click="DebugStart_Click"/>
     <MenuItem Header="打开 F407 离线调试示例" Click="DebugExample_Click"/>
     <Separator/>
     <MenuItem x:Name="DebugContinueMenu" Header="运行" InputGestureText="F5" Click="DebugContinue_Click" IsEnabled="False"/>
     <MenuItem x:Name="DebugPauseMenu" Header="暂停" Click="DebugPause_Click" IsEnabled="False"/>
     <MenuItem x:Name="DebugIntoMenu" Header="单步进入" InputGestureText="F11" Click="DebugInto_Click" IsEnabled="False"/>
     <MenuItem x:Name="DebugOverMenu" Header="逐过程" InputGestureText="F10" Click="DebugOver_Click" IsEnabled="False"/>
     <MenuItem x:Name="DebugOutMenu" Header="跳出函数" InputGestureText="Ctrl+F11" Click="DebugOut_Click" IsEnabled="False"/>
     <Separator/>
     <MenuItem Header="设置 / 删除断点" InputGestureText="F9" Click="DebugBreakpoint_Click"/>
     <MenuItem Header="启用 / 禁用当前断点" InputGestureText="Ctrl+F9" Click="DebugEnableBreakpoint_Click"/>
     <MenuItem Header="条件 / 日志 / 临时断点…" InputGestureText="Shift+F9" Click="DebugBreakpointSettings_Click"/>
     <MenuItem x:Name="DebugRunToMenu" Header="运行到光标" InputGestureText="Ctrl+F10" Click="DebugRunToCursor_Click" IsEnabled="False"/>
     <MenuItem x:Name="ShowDebugMenu" Header="调试窗口" Click="ShowDebug_Click" IsEnabled="False"/>
     <MenuItem x:Name="ShowFreeRtosMenu" Header="FreeRTOS 状态" Click="ShowFreeRtos_Click" IsEnabled="False"/>
    </MenuItem>
    <MenuItem Header="工具(_T)"><MenuItem Header="工程终端" InputGestureText="Ctrl+`" Click="ProjectTerminal_Click"/><MenuItem Header="AI 接口设置…" Click="AiSettingsMenu_Click"/><MenuItem Header="Git 图谱" Click="GitGraph_Click"/><MenuItem Header="GitHub 协作" Click="GitHubWorkspace_Click"/><MenuItem Header="器件与模板" Click="DevicesAndTemplates_Click"/><MenuItem Header="串口终端" Click="Serial_Click"/><MenuItem Header="串口绘图" Click="SerialPlot_Click"/><MenuItem Header="波形演示" Click="Lab_Click"/><MenuItem Header="插件与工具集" Click="Extensions_Click"/><MenuItem Header="检查内置工具链" Click="VerifyTools_Click"/></MenuItem>
    <MenuItem Header="帮助(_H)"><MenuItem Header="快速开始" Click="Welcome_Click"/><MenuItem Header="关于 MCU StudioX" Click="About_Click"/></MenuItem>
   </Menu></Border>
   <Border x:Name="MainToolbar" Grid.Row="2" Background="{DynamicResource ChromeSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><DockPanel Margin="8,3">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button Style="{StaticResource LabeledToolButton}" ToolTip="外观与背景 (Ctrl+Alt+S)" Click="Appearance_Click" AutomationProperties.Name="外观与背景"><StackPanel Orientation="Horizontal"><local:Icon Kind="settings" Margin="0,0,6,0"/><TextBlock Text="外观" VerticalAlignment="Center"/></StackPanel></Button>
    </StackPanel>
    <StackPanel Orientation="Horizontal">
     <Button Style="{StaticResource LabeledToolButton}" ToolTip="新建工程 (Ctrl+N)" Click="NewProject_Click" AutomationProperties.Name="新建工程"><StackPanel Orientation="Horizontal"><local:Icon Kind="plus" Margin="0,0,6,0"/><TextBlock Text="新建" VerticalAlignment="Center"/></StackPanel></Button>
     <Button Style="{StaticResource LabeledToolButton}" ToolTip="打开工程 (Ctrl+O)" Click="OpenProject_Click" AutomationProperties.Name="打开工程"><StackPanel Orientation="Horizontal"><local:Icon Kind="folder" Margin="0,0,6,0"/><TextBlock Text="打开" VerticalAlignment="Center"/></StackPanel></Button>
     <Button Style="{StaticResource LabeledToolButton}" ToolTip="保存 (Ctrl+S)" Click="Save_Click" AutomationProperties.Name="保存"><StackPanel Orientation="Horizontal"><local:Icon Kind="save" Margin="0,0,6,0"/><TextBlock Text="保存" VerticalAlignment="Center"/></StackPanel></Button>
     <Border Width="1" Background="{DynamicResource Border}" Margin="10,5"/>
     <Border Background="{DynamicResource Background}" CornerRadius="4" Padding="12,5" MinWidth="135" MaxWidth="200" Margin="0,0,8,0" ToolTip="{Binding Text, ElementName=BuildConfiguration}"><TextBlock x:Name="BuildConfiguration" Text="无构建目标" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}"/></Border>
     <Button x:Name="BuildButton" IsEnabled="False" Style="{StaticResource LabeledToolButton}" ToolTip="编译固件 (F7)" Click="Build_Click" AutomationProperties.Name="编译"><StackPanel Orientation="Horizontal"><local:Icon Kind="build" Foreground="{DynamicResource RunColor}" Margin="0,0,6,0"/><TextBlock Text="编译" VerticalAlignment="Center"/></StackPanel></Button>
     <TextBlock x:Name="DownloadProbeLabel" Text="烧录器" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="10,0,7,0"/>
     <ComboBox x:Name="DownloadProbePicker" Width="174" Height="28" MinHeight="28" Padding="8,3" VerticalAlignment="Center" IsEnabled="False" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectionChanged="DownloadProbe_Changed" AutomationProperties.Name="烧录器选择"/>
     <Button x:Name="DownloadSettingsButton" Style="{StaticResource ToolButton}" Width="28" IsEnabled="False" ToolTip="下载设置：速度与序列号" Click="DownloadSettings_Click" AutomationProperties.Name="下载设置"><local:Icon Kind="settings" Width="14" Height="14"/></Button>
     <Button x:Name="DownloadButton" Style="{StaticResource LabeledToolButton}" IsEnabled="False" ToolTip="编译并下载固件" Click="Download_Click" AutomationProperties.Name="下载"><StackPanel Orientation="Horizontal"><local:Icon Kind="download" Foreground="{DynamicResource Accent}" Margin="0,0,6,0"/><TextBlock Text="下载" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="DebugStartButton" Style="{StaticResource LabeledToolButton}" ToolTip="启动 / 结束调试 (Ctrl+F5) · 实机模式先核对板上固件，不自动下载" Click="DebugStart_Click" AutomationProperties.Name="调试"><StackPanel Orientation="Horizontal"><local:Icon Kind="debug" Margin="0,0,6,0"/><TextBlock Text="调试" VerticalAlignment="Center"/></StackPanel></Button>
     <Button Style="{StaticResource LabeledToolButton}" ToolTip="停止当前操作" Click="Cancel_Click" x:Name="CancelButton" IsEnabled="False" AutomationProperties.Name="停止"><StackPanel Orientation="Horizontal"><local:Icon Kind="stop" Margin="0,0,6,0"/><TextBlock Text="停止" VerticalAlignment="Center"/></StackPanel></Button>
    </StackPanel>
   </DockPanel></Border>
   <Border x:Name="DebugToolbar" Grid.Row="3" Visibility="Collapsed" Background="{DynamicResource ChromeSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
    <DockPanel Margin="8,3">
     <Border DockPanel.Dock="Right" Background="{DynamicResource Panel}" CornerRadius="3" Padding="9,4" Margin="8,0"><TextBlock x:Name="DebugModeBadge" Text="未连接调试目标" Foreground="{DynamicResource DebugChanged}" VerticalAlignment="Center"/></Border>
     <WrapPanel>
      <Button x:Name="DebugContinueButton" Style="{StaticResource LabeledToolButton}" Click="DebugContinue_Click" ToolTip="运行 (F5)"><StackPanel Orientation="Horizontal"><local:Icon Kind="play" Foreground="{DynamicResource RunColor}" Margin="0,0,6,0"/><TextBlock Text="运行"/></StackPanel></Button>
      <Button x:Name="DebugPauseButton" Style="{StaticResource LabeledToolButton}" Click="DebugPause_Click" ToolTip="暂停"><StackPanel Orientation="Horizontal"><local:Icon Kind="pause" Foreground="{DynamicResource DebugChanged}" Margin="0,0,6,0"/><TextBlock Text="暂停"/></StackPanel></Button>
      <Button x:Name="DebugOverButton" Style="{StaticResource LabeledToolButton}" Click="DebugOver_Click" ToolTip="逐过程 (F10)"><StackPanel Orientation="Horizontal"><local:Icon Kind="step-over" Foreground="{DynamicResource Accent}" Margin="0,0,6,0"/><TextBlock Text="逐过程"/></StackPanel></Button>
      <Button x:Name="DebugIntoButton" Style="{StaticResource LabeledToolButton}" Click="DebugInto_Click" ToolTip="单步进入 (F11)"><StackPanel Orientation="Horizontal"><local:Icon Kind="step-into" Foreground="{DynamicResource Accent}" Margin="0,0,6,0"/><TextBlock Text="进入"/></StackPanel></Button>
      <Button x:Name="DebugOutButton" Style="{StaticResource LabeledToolButton}" Click="DebugOut_Click" ToolTip="跳出函数 (Ctrl+F11)"><StackPanel Orientation="Horizontal"><local:Icon Kind="step-out" Foreground="{DynamicResource Accent}" Margin="0,0,6,0"/><TextBlock Text="跳出"/></StackPanel></Button>
      <Button x:Name="DebugResetButton" Style="{StaticResource LabeledToolButton}" Click="DebugReset_Click" ToolTip="复位并暂停目标"><StackPanel Orientation="Horizontal"><local:Icon Kind="restart" Margin="0,0,6,0"/><TextBlock Text="复位"/></StackPanel></Button>
      <Button x:Name="DebugRefreshButton" Style="{StaticResource LabeledToolButton}" Click="DebugRefresh_Click" ToolTip="刷新寄存器与变量"><TextBlock Text="刷新"/></Button>
      <Button x:Name="DebugStopButton" Style="{StaticResource LabeledToolButton}" Click="DebugStop_Click" ToolTip="结束调试 (Ctrl+F5)"><StackPanel Orientation="Horizontal"><local:Icon Kind="stop" Foreground="#F25964" Margin="0,0,6,0"/><TextBlock Text="结束"/></StackPanel></Button>
      <TextBlock x:Name="DebugStateText" Text="未启动调试" Margin="14,0,0,0" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
     </WrapPanel>
    </DockPanel>
   </Border>
   <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition x:Name="ProjectColumn" Width="230" MinWidth="0"/><ColumnDefinition x:Name="ProjectSplitterColumn" Width="4"/><ColumnDefinition MinWidth="200"/><ColumnDefinition x:Name="AiSidebarSplitterColumn" Width="0"/><ColumnDefinition x:Name="AiSidebarColumn" Width="0" MinWidth="0" MaxWidth="620"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
     <Border Background="{DynamicResource ChromeSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"><DockPanel><StackPanel DockPanel.Dock="Bottom"><Button Style="{StaticResource RailButton}" ToolTip="工程终端 (Ctrl+`)" Click="ProjectTerminal_Click" AutomationProperties.Name="工程终端"><local:Icon Kind="terminal" /></Button><Button Style="{StaticResource RailButton}" ToolTip="构建日志" AutomationProperties.Name="构建日志" Click="ShowBuildLog_Click"><local:Icon Kind="build-log" /></Button><Button Style="{StaticResource RailButton}" ToolTip="外观与背景" Click="Appearance_Click"><local:Icon Kind="settings" /></Button></StackPanel><StackPanel><Button Style="{StaticResource RailButton}" ToolTip="工程 (Alt+1)" Click="ToggleProject_Click"><local:Icon Kind="folder" /></Button><Button Style="{StaticResource RailButton}" ToolTip="Git 图谱" AutomationProperties.Name="Git 图谱" Click="GitGraph_Click"><local:Icon Kind="git-branch" /></Button><Button Style="{StaticResource RailButton}" ToolTip="器件与模板" AutomationProperties.Name="器件与模板" Click="DevicesAndTemplates_Click"><local:Icon Kind="chip" /></Button><Button Style="{StaticResource RailButton}" ToolTip="串口终端" AutomationProperties.Name="串口终端" Click="Serial_Click"><local:Icon Kind="serial" /></Button><Button Style="{StaticResource RailButton}" ToolTip="串口绘图" AutomationProperties.Name="串口绘图" Click="SerialPlot_Click"><local:Icon Kind="wave" /></Button><Button Style="{StaticResource RailButton}" ToolTip="扩展" Click="Extensions_Click"><local:Icon Kind="plug" /></Button></StackPanel></DockPanel></Border>
    <Border Grid.Column="1" x:Name="ProjectPanel" Background="{DynamicResource ToolSurface}"><TabControl x:Name="LeftToolTabs"><TabItem Header="工程"><Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="12,0,5,0"><Button Style="{StaticResource ToolButton}" ToolTip="隐藏工程窗口" Click="ToggleProject_Click" DockPanel.Dock="Right"><local:Icon Kind="minus" /></Button><Button x:Name="CloseProjectButton" Style="{StaticResource ToolButton}" ToolTip="关闭工程 (Ctrl+Shift+W)" AutomationProperties.Name="关闭工程" Click="CloseProject_Click" IsEnabled="False" DockPanel.Dock="Right"><local:Icon Kind="close"/></Button><TextBlock Text="工程" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
     <Grid Grid.Row="1"><StackPanel x:Name="EmptyProject" Margin="18,24,18,0"><local:Icon Kind="folder" Width="30" Height="30" HorizontalAlignment="Left" Margin="0,0,0,14"/><TextBlock Text="尚未打开工程" Margin="0,0,0,8"/><TextBlock Text="创建一个工程，或从本地打开已有工程。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" LineHeight="22"/><Button Style="{StaticResource LinkButton}" Content="新建工程…" Click="NewProject_Click" Margin="0,14,0,0"/><Button Style="{StaticResource LinkButton}" Content="打开工程…" Click="OpenProject_Click"/><Button Style="{StaticResource LinkButton}" Content="导入 CubeMX 工程…" Click="ImportCubeMx_Click"/></StackPanel><TreeView x:Name="ProjectTree" Visibility="Collapsed" Margin="6" MouseDoubleClick="ProjectTree_DoubleClick" KeyDown="ProjectTree_KeyDown"/></Grid>
     <StackPanel Grid.Row="2"><local:BuildMemoryView x:Name="BuildMemory"/><Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="12,10"><StackPanel><TextBlock x:Name="ProjectLabel" Text="工作区" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DeviceLabel" Text="器件未选择" FontSize="11" Margin="0,5,0,0" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="ToolsetLabel" Text="" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></StackPanel></Border></StackPanel>
    </Grid></TabItem><TabItem x:Name="RegistersTab" Header="寄存器" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition/></Grid.RowDefinitions>
     <StackPanel Margin="9,5"><TextBlock x:Name="RegisterTitle" Text="目标寄存器" FontWeight="SemiBold"/><TextBlock x:Name="RegisterHint" Text="暂停后读取 · 模拟数据" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel>
