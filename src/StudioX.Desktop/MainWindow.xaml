    </Grid></TabItem></TabControl></Border>
    <GridSplitter Grid.Column="2" HorizontalAlignment="Stretch" Background="{DynamicResource Background}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
    <Grid Grid.Column="3"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="4"/><RowDefinition x:Name="BottomRow" Height="150" MinHeight="0"/></Grid.RowDefinitions>
     <TabControl x:Name="WorkspaceTabs" Style="{StaticResource WorkspaceTabControl}" SelectionChanged="WorkspaceTabs_SkillsSelectionChanged">
      <TabItem Header="欢迎" x:Name="WelcomeTab"><Border Background="{DynamicResource EditorSurface}"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="44,30,44,18" MaxWidth="1180">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid Margin="0,0,0,34"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MCU StudioX" FontSize="40" FontWeight="SemiBold"/><TextBlock Text="嵌入式开发，从这里开始。" Foreground="{DynamicResource Muted}" FontSize="15" Margin="0,10,0,24"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource PrimaryButton}" Click="NewProject_Click" Margin="0,0,12,0"><StackPanel Orientation="Horizontal"><local:Icon Kind="plus" Foreground="White" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="新建工程" Foreground="White"/></StackPanel></Button><Button Content="打开工程…" Click="OpenProject_Click" Padding="18,10"/><Button Style="{StaticResource LinkButton}" Content="导入器件包" Click="ImportPack_Click" Margin="18,0,0,0"/></StackPanel></StackPanel>
        <Image Grid.Column="1" Source="{StaticResource StudioXAppIcon}" Width="72" Height="72" HorizontalAlignment="Right"
               VerticalAlignment="Top" Margin="0,8,0,0" Stretch="Uniform" AutomationProperties.Name="MCU StudioX 标识"/>
       </Grid>
