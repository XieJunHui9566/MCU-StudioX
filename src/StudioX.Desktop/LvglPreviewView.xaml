<UserControl
  x:Class="StudioX.Desktop.LvglPreviewView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:StudioX.Desktop">
  <Border
    Background="{DynamicResource EditorSurface}">
    <ScrollViewer
      VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled">
      <StackPanel
        Margin="24,20"
        MaxWidth="1000"
        HorizontalAlignment="Stretch">
        <TextBlock
          Text="LVGL PC 预览"
          FontSize="23"
          FontWeight="SemiBold" />
        <TextBlock
          x:Name="ProjectLabel"
          Text="打开 LVGL 工程后，在独立窗口运行共享的界面代码。"
          Foreground="{DynamicResource Muted}"
          TextWrapping="Wrap"
          Margin="0,7,0,14" />
        <WrapPanel
          Margin="0,0,0,10">
          <Button
            x:Name="StartButton"
            Content="启动预览"
            Click="Start_Click"
            Style="{StaticResource PrimaryButton}"
            Margin="0,0,8,5"
            AutomationProperties.Name="启动 LVGL PC 窗口预览" />
          <Button
            x:Name="StopButton"
            Content="停止"
            Click="Stop_Click"
            Margin="0,0,8,5"
            IsEnabled="False" />
          <Button
            x:Name="CaptureButton"
            Content="截屏"
            Click="Capture_Click"
            Margin="0,0,8,5"
            IsEnabled="False" />
          <Button
            x:Name="ResourcesButton"
            Content="刷新资源分析"
            Click="Resources_Click"
            Margin="0,0,8,5" />
          <Button
            x:Name="SetupButton"
            Content="配置自定义 UI"
            Click="Setup_Click"
            Margin="0,0,8,5" />
        </WrapPanel>
        <TextBlock
          x:Name="StateLabel"
          Text="尚未启动"
          TextWrapping="Wrap"
          Margin="0,0,0,5" />
        <TextBlock
          x:Name="ToolchainLabel"
          Text="自动使用 IDE 内置 PC 编译链"
          Foreground="{DynamicResource Muted}"
          FontSize="11"
          TextWrapping="Wrap"
          Margin="0,0,0,12" />
        <local:LvglPreviewSetupView
          x:Name="SetupView"
          Visibility="Collapsed"
          Margin="0,0,0,15" />
        <Border
          x:Name="StaleBanner"
          Visibility="Collapsed"
          BorderBrush="{DynamicResource DebugChanged}"
          BorderThickness="1"
          CornerRadius="5"
          Padding="10,8"
          Margin="0,0,0,12"
          Background="Transparent">
          <TextBlock
            Text="当前窗口显示上次成功构建的界面。新代码尚未成功构建，请查看构建状态与诊断。"
            Foreground="{DynamicResource DebugChanged}"
            TextWrapping="Wrap" />
        </Border>
        <Expander
          Header="显示与构建设置"
          IsExpanded="False"
          Foreground="{DynamicResource Text}"
          Margin="0,0,0,14">
          <StackPanel
            Margin="0,10,0,0">
            <WrapPanel
              x:Name="ConfigurationInputs">
              <StackPanel
                Width="86"
                Margin="0,0,10,8">
                <TextBlock
                  Text="宽度 (px)"
                  Foreground="{DynamicResource Muted}"
                  FontSize="11" />
                <TextBox
                  x:Name="WidthInput"
                  Text="240"
                  MaxLength="4"
                  AutomationProperties.Name="预览逻辑宽度" />
              </StackPanel>
              <StackPanel
                Width="86"
                Margin="0,0,10,8">
                <TextBlock
                  Text="高度 (px)"
                  Foreground="{DynamicResource Muted}"
                  FontSize="11" />
                <TextBox
                  x:Name="HeightInput"
                  Text="320"
                  MaxLength="4"
                  AutomationProperties.Name="预览逻辑高度" />
              </StackPanel>
              <StackPanel
                Width="86"
                Margin="0,0,10,8">
                <TextBlock
                  Text="窗口倍率"
                  Foreground="{DynamicResource Muted}"
                  FontSize="11" />
                <ComboBox
                  x:Name="ZoomPicker"
                  AutomationProperties.Name="预览窗口倍率" />
              </StackPanel>
              <StackPanel
                Width="94"
                Margin="0,0,10,8">
                <TextBlock
                  Text="绘制缓存行数"
                  Foreground="{DynamicResource Muted}"
                  FontSize="11" />
                <TextBox
                  x:Name="RowsInput"
                  Text="10"
                  MaxLength="4"
                  AutomationProperties.Name="LVGL 绘制缓存行数" />
              </StackPanel>
              <StackPanel
                Width="86"
                Margin="0,0,10,8">
                <TextBlock
                  Text="缓存数量"
                  Foreground="{DynamicResource Muted}"
                  FontSize="11" />
                <ComboBox
                  x:Name="BufferCountPicker"
                  AutomationProperties.Name="LVGL 绘制缓存数量" />
              </StackPanel>
              <StackPanel
                Width="90"
                Margin="0,0,10,8">
                <TextBlock
                  Text="共享色深"
                  Foreground="{DynamicResource Muted}"
                  FontSize="11" />
                <TextBlock
                  x:Name="ColorDepthLabel"
                  Text="—"
                  Margin="0,9,0,0"
                  ToolTip="色深沿用共享的 LVGL 配置；修改 lv_conf.h 后重新构建。" />
              </StackPanel>
              <CheckBox
                x:Name="AutoRebuildCheck"
                Content="保存后自动重建"
                IsChecked="True"
                VerticalAlignment="Center"
                Margin="0,8,0,8"
                ToolTip="保存共享源码后防抖构建；构建成功再替换窗口。" />
            </WrapPanel>
            <Button
              x:Name="ApplyButton"
              Content="保存设置"
              Click="Apply_Click"
              HorizontalAlignment="Left"
              Padding="12,5"
              Margin="0,0,0,7" />
            <TextBlock
              x:Name="ConfigurationNotice"
              Text="设置保存在工程 .studiox/lvgl-preview.json；外部编译链覆盖保存在本机设置中。"
              FontSize="11"
              Foreground="{DynamicResource Muted}"
              TextWrapping="Wrap" />
          </StackPanel>
        </Expander>
        <Expander
          Header="编译链（高级）"
          IsExpanded="False"
          Foreground="{DynamicResource Text}"
          Margin="0,0,0,14">
          <StackPanel
            Margin="0,10,0,0">
            <TextBlock
              Text="默认使用随 IDE 提供的 Windows PC 编译链，可直接启动预览。需要特定版本时，可手动选择外部 GCC。"
              FontSize="11"
              Foreground="{DynamicResource Muted}"
              TextWrapping="Wrap"
              Margin="0,0,0,8" />
            <WrapPanel>
              <Button
                x:Name="BundledToolchainButton"
                Content="使用内置编译链"
                Click="BundledToolchain_Click"
                Margin="0,0,8,5" />
              <Button
                x:Name="ToolchainButton"
                Content="选择外部 GCC…"
                Click="Toolchain_Click"
                Margin="0,0,8,5" />
            </WrapPanel>
          </StackPanel>
        </Expander>
        <WrapPanel>
          <Border
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14"
            Margin="0,0,12,12"
            Width="305"
            Background="Transparent">
            <StackPanel>
              <TextBlock
                Text="PC 运行状态"
                FontSize="15"
                FontWeight="SemiBold" />
              <TextBlock
                x:Name="PcRuntimeLabel"
                Text="等待预览进程返回数据"
                Foreground="{DynamicResource Muted}"
                FontSize="11"
                Margin="0,7,0,12"
                TextWrapping="Wrap" />
              <TextBlock
                x:Name="FpsLabel"
                Text="FPS —"
                FontSize="23"
                Foreground="{DynamicResource Accent}" />
              <TextBlock
                x:Name="FramesLabel"
                Text="帧数 — · 刷新像素 —"
                Foreground="{DynamicResource Muted}"
                FontSize="11"
                Margin="0,4,0,9"
                TextWrapping="Wrap" />
              <TextBlock
                x:Name="HeapLabel"
                Text="LVGL 堆：—"
                Margin="0,0,0,5" />
              <ProgressBar
                x:Name="HeapBar"
                Minimum="0"
                Maximum="100"
                Height="6"
                Background="{DynamicResource Panel}"
                Foreground="{DynamicResource Accent}"
                BorderThickness="0"
                Margin="0,0,0,8" />
              <TextBlock
                x:Name="HeapDetails"
                Text="空闲 / 最大空闲块 / 碎片率：—"
                Foreground="{DynamicResource Muted}"
                FontSize="11"
                TextWrapping="Wrap" />
              <TextBlock
                x:Name="HeapPeakLabel"
                Text="观测堆峰值：—"
                Foreground="{DynamicResource Muted}"
                FontSize="11"
                Margin="0,6,0,0" />
              <TextBlock
                x:Name="RuntimeDiagnostics"
                Text="警告 0 · 错误 0"
                Foreground="{DynamicResource Muted}"
                FontSize="11"
                Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <Border
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14"
            Margin="0,0,12,12"
            Width="305"
            Background="Transparent">
            <StackPanel>
              <TextBlock
                Text="目标 MCU 静态占用"
                FontSize="15"
                FontWeight="SemiBold" />
              <TextBlock
                x:Name="TargetCorrespondenceLabel"
                Text="来自目标 ELF / MAP；需要与当前 UI 对应"
                Foreground="{DynamicResource Muted}"
                FontSize="11"
                Margin="0,7,0,8"
                TextWrapping="Wrap" />
              <local:BuildMemoryView
                x:Name="TargetMemory" />
            </StackPanel>
          </Border>
        </WrapPanel>
        <Border
          BorderBrush="{DynamicResource Border}"
          BorderThickness="1"
          CornerRadius="6"
          Padding="14"
          Margin="0,0,0,12"
          Background="Transparent">
          <StackPanel>
            <TextBlock
              Text="缓存与估算依据"
              FontSize="15"
              FontWeight="SemiBold"
              Margin="0,0,0,8" />
            <TextBlock
              x:Name="BuffersLabel"
              Text="LVGL 绘制缓存 — · PC 显示帧缓存 —"
              TextWrapping="Wrap" />
            <TextBlock
              x:Name="TransferLabel"
              Text="传输模型等待工程配置。"
              FontSize="11"
              TextWrapping="Wrap"
              Margin="0,7,0,0" />
            <TextBlock
              x:Name="EvidenceLabel"
              Foreground="{DynamicResource Muted}"
              FontSize="11"
              TextWrapping="Wrap"
              Margin="0,7,0,0" />
            <TextBlock
              x:Name="LimitationsLabel"
              Text="PC 堆、FPS 和显示帧缓存属于电脑预览。MCU 的运行时堆栈峰值及实际刷新速度需要实机测量；静态 RAM 已包含链接预留的堆和缓存，不能重复相加。"
              Foreground="{DynamicResource Muted}"
              FontSize="11"
              TextWrapping="Wrap"
              Margin="0,7,0,0" />
          </StackPanel>
        </Border>
        <Expander
          x:Name="ScreenshotSection"
          Header="最近截屏"
          Foreground="{DynamicResource Text}"
          Visibility="Collapsed"
          Margin="0,0,0,12">
          <StackPanel
            Margin="0,8,0,0">
            <Image
              x:Name="ScreenshotImage"
              MaxHeight="420"
              HorizontalAlignment="Left"
              Stretch="Uniform" />
            <TextBlock
              x:Name="ScreenshotPath"
              Foreground="{DynamicResource Muted}"
              FontSize="11"
              TextWrapping="Wrap"
              Margin="0,7,0,0" />
          </StackPanel>
        </Expander>
        <Expander
          Header="构建与运行诊断"
          Foreground="{DynamicResource Text}"
          IsExpanded="True">
          <StackPanel>
            <local:OutputLogView
              x:Name="DiagnosticLog"
              IsReadOnly="True"
              Foreground="{DynamicResource Text}"
              Background="{DynamicResource EditorSurface}"
              FontFamily="Cascadia Mono, Consolas"
              FontSize="11"
              MinHeight="130"
              MaxHeight="290"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Auto"
              Margin="0,8,0,0"
              AutomationProperties.Name="LVGL 预览构建与运行日志" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
