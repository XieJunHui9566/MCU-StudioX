<UserControl
  x:Class="StudioX.Desktop.Ag32PinPlanningView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:StudioX.Desktop">
  <UserControl.Resources>
    <local:Ag32PinSummaryConverter
      x:Key="PinSummary" />
    <GroupStyle
      x:Key="PeripheralGroup">
      <GroupStyle.ContainerStyle>
        <Style
          TargetType="GroupItem">
          <Setter
            Property="Template">
            <Setter.Value>
              <ControlTemplate
                TargetType="GroupItem">
                <Expander
                  Header="{Binding Name.Title}"
                  IsExpanded="{Binding Name.IsExpanded, Mode=TwoWay}"
                  AutomationProperties.Name="{Binding Name.Title}"
                  Foreground="{DynamicResource Text}"
                  Margin="1,2">
                  <ItemsPresenter
                    Margin="10,1,0,1" />
                </Expander>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Style.Triggers>
            <DataTrigger
              Binding="{Binding Name.Title}"
              Value="">
              <Setter
                Property="Template">
                <Setter.Value>
                  <ControlTemplate
                    TargetType="GroupItem">
                    <ItemsPresenter />
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </GroupStyle.ContainerStyle>
    </GroupStyle>
    <Style
      x:Key="PlannerSplitter"
      TargetType="GridSplitter">
      <Setter
        Property="HorizontalAlignment"
        Value="Stretch" />
      <Setter
        Property="VerticalAlignment"
        Value="Stretch" />
      <Setter
        Property="ResizeBehavior"
        Value="PreviousAndNext" />
      <Setter
        Property="KeyboardIncrement"
        Value="8" />
      <Setter
        Property="Background"
        Value="Transparent" />
      <Setter
        Property="Template">
        <Setter.Value>
          <ControlTemplate
            TargetType="GridSplitter">
            <Grid
              Background="{TemplateBinding Background}">
              <Border
                x:Name="Line"
                Width="2"
                HorizontalAlignment="Center"
                Background="{DynamicResource Border}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger
                Property="ResizeDirection"
                Value="Rows">
                <Setter
                  TargetName="Line"
                  Property="Width"
                  Value="Auto" />
                <Setter
                  TargetName="Line"
                  Property="Height"
                  Value="2" />
                <Setter
                  TargetName="Line"
                  Property="HorizontalAlignment"
                  Value="Stretch" />
                <Setter
                  TargetName="Line"
                  Property="VerticalAlignment"
                  Value="Center" />
              </Trigger>
              <Trigger
                Property="IsMouseOver"
                Value="True">
                <Setter
                  TargetName="Line"
                  Property="Background"
                  Value="{DynamicResource Accent}" />
              </Trigger>
              <Trigger
                Property="IsKeyboardFocused"
                Value="True">
                <Setter
                  TargetName="Line"
                  Property="Background"
                  Value="{DynamicResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <DockPanel>
    <WrapPanel
      DockPanel.Dock="Top"
      Margin="0,0,0,2">
      <StackPanel
        VerticalAlignment="Center"
        Margin="0,0,14,3">
        <TextBlock
          x:Name="PackageText"
          FontWeight="SemiBold"
          TextWrapping="Wrap" />
        <TextBlock
          x:Name="PlannerStatus"
          TextWrapping="Wrap"
          Foreground="{DynamicResource Muted}">
          <TextBlock.Style>
            <Style
              TargetType="TextBlock">
              <Style.Triggers>
                <Trigger
                  Property="Text"
                  Value="">
                  <Setter
                    Property="Visibility"
                    Value="Collapsed" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
      <WrapPanel
        VerticalAlignment="Center"
        Margin="0,0,0,3">
        <Button
          x:Name="ProjectToolsButton"
          Content="构建状态"
          ToolTip="展开或收起构建状态和 Supra 许可说明"
          Padding="8,3"
          Margin="0,0,4,0" />
        <Button
          x:Name="BottomPaneButton"
          Content="收起底栏"
          ToolTip="收起或展开底部终端和输出面板"
          Padding="8,3" />
        <Button
          x:Name="SavePlanButton"
          Content="保存并生成"
          Style="{DynamicResource PrimaryButton}"
          Click="Save_Click"
          ToolTip="保存引脚和外设参数，生成系统代码与约束"
          Margin="4,0"
          Padding="8,3" />
        <Button
          x:Name="ReloadPlanButton"
          Content="重新读取"
          Click="Reload_Click"
          Padding="8,3"
          ToolTip="放弃当前草稿，从 .ve 重新读取配置" />
      </WrapPanel>
    </WrapPanel>
    <ScrollViewer
      DockPanel.Dock="Top"
      MaxHeight="65"
      VerticalScrollBarVisibility="Auto"
      Visibility="{Binding Visibility, ElementName=ConflictStatus}">
      <TextBlock
        x:Name="ConflictStatus"
        Visibility="Collapsed"
        Foreground="{DynamicResource ErrorColor}"
        TextWrapping="Wrap"
        Margin="0,2,0,4" />
    </ScrollViewer>
    <TabControl
      x:Name="PlannerTabs"
      SelectedIndex="0">
      <TabItem
        x:Name="PinTab"
        Header="引脚分配">
        <Grid
          x:Name="PinWorkspace"
          SizeChanged="Workspace_SizeChanged"
          Margin="0,8,0,0">
          <Grid.RowDefinitions>
            <RowDefinition
              Height="*" />
            <RowDefinition
              Height="0" />
            <RowDefinition
              Height="0" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition
              x:Name="NavigationColumn"
              Width="158"
              MinWidth="114" />
            <ColumnDefinition
              x:Name="NavigationHandleColumn"
              Width="8" />
            <ColumnDefinition
              x:Name="PropertiesColumn"
              Width="0.73*" />
            <ColumnDefinition
              Width="8" />
            <ColumnDefinition
              x:Name="DiagramColumn"
              Width="1.27*" />
          </Grid.ColumnDefinitions>
          <DockPanel
            x:Name="WideNavigation"
            Margin="0,0,2,0">
            <TextBlock
              DockPanel.Dock="Top"
              Text="配置对象"
              FontWeight="SemiBold"
              Margin="6,4,0,8" />
            <ListBox
              x:Name="PeripheralList"
              ItemsSource="{Binding ItemsSource, ElementName=UartPort}"
              Background="Transparent"
              Foreground="{DynamicResource Text}"
              BorderThickness="0"
              ItemContainerStyle="{StaticResource CodeCompletionItemStyle}"
              SelectedItem="{Binding SelectedItem, ElementName=UartPort, Mode=TwoWay}"
              AutomationProperties.Name="引脚与外设">
              <ListBox.Template>
                <ControlTemplate
                  TargetType="ListBox">
                  <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                    <ScrollViewer
                      Focusable="False"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True">
                      <ItemsPresenter />
                    </ScrollViewer>
                  </Border>
                </ControlTemplate>
              </ListBox.Template>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock
                    Padding="5,4"
                    Text="{Binding}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.GroupStyle>
                <StaticResource
                  ResourceKey="PeripheralGroup" />
              </ListBox.GroupStyle>
            </ListBox>
          </DockPanel>
          <GridSplitter
            x:Name="NavigationSplitter"
            Grid.Column="1"
            Style="{StaticResource PlannerSplitter}"
            ResizeDirection="Columns"
            ToolTip="左右拖动调整配置对象栏宽度"
            AutomationProperties.Name="配置对象栏宽度" />
          <DockPanel
            x:Name="PropertyPane"
            Grid.Column="2"
            Margin="5,0,7,0">
            <Grid
              x:Name="CompactNavigation"
              DockPanel.Dock="Top"
              Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition
                  Width="Auto" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Label
                Content="配置对象"
                Target="{Binding ElementName=UartPort}"
                Foreground="{DynamicResource Text}" />
              <ComboBox
                x:Name="UartPort"
                Grid.Column="1"
                AutomationProperties.Name="配置对象"
                SelectionChanged="UartPort_Changed">
                <ComboBox.GroupStyle>
                  <StaticResource
                    ResourceKey="PeripheralGroup" />
                </ComboBox.GroupStyle>
              </ComboBox>
            </Grid>
            <DockPanel
              x:Name="PropertyWorkspace"
              SizeChanged="PropertyWorkspace_SizeChanged">
              <DockPanel
                x:Name="AssignmentsArea"
                DockPanel.Dock="Top"
                Margin="4,2,5,6"
                Visibility="{Binding Visibility, ElementName=PinInspector}">
                <TextBlock
                  DockPanel.Dock="Top"
                  x:Name="AssignmentsHeading"
                  Text="已分配功能"
                  FontWeight="SemiBold"
                  Margin="0,0,0,8" />
                <DockPanel
                  DockPanel.Dock="Top"
                  x:Name="PinFilterBar"
                  Margin="0,0,0,3">
                  <Label
                    Content="筛选"
                    Target="{Binding ElementName=PinFilter}"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Text}" />
                  <TextBox
                    x:Name="PinFilter"
                    TextChanged="PinFilter_Changed"
                    AutomationProperties.Name="筛选已分配引脚"
                    ToolTip="按引脚号、名称或内部功能筛选" />
                </DockPanel>
                <DataGrid
                  x:Name="AssignmentsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionChanged="Assignment_Changed"
                  Background="Transparent"
                  Foreground="{DynamicResource Text}"
                  BorderBrush="{DynamicResource Border}"
                  RowBackground="Transparent"
                  AlternatingRowBackground="{DynamicResource Surface}"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  MinHeight="0"
                  MaxHeight="250"
                  Margin="0,4,0,0">
                  <DataGrid.ColumnHeaderStyle>
                    <Style
                      TargetType="DataGridColumnHeader">
                      <Setter
                        Property="Background"
                        Value="{DynamicResource Panel}" />
                      <Setter
                        Property="Foreground"
                        Value="{DynamicResource Text}" />
                      <Setter
                        Property="Padding"
                        Value="8,6" />
                      <Setter
                        Property="BorderBrush"
                        Value="{DynamicResource Border}" />
                      <Setter
                        Property="BorderThickness"
                        Value="0,0,0,1" />
                    </Style>
                  </DataGrid.ColumnHeaderStyle>
                  <DataGrid.CellStyle>
                    <Style
                      TargetType="DataGridCell">
                      <Setter
                        Property="Foreground"
                        Value="{DynamicResource Text}" />
                      <Setter
                        Property="Background"
                        Value="Transparent" />
                      <Setter
                        Property="Padding"
                        Value="8,4" />
                      <Setter
                        Property="BorderThickness"
                        Value="0" />
                      <Style.Triggers>
                        <Trigger
                          Property="IsSelected"
                          Value="True">
                          <Setter
                            Property="Background"
                            Value="{DynamicResource Accent}" />
                          <Setter
                            Property="Foreground"
                            Value="{DynamicResource OnAccent}" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </DataGrid.CellStyle>
                  <DataGrid.Columns>
                    <DataGridTextColumn
                      Header="名称"
                      Binding="{Binding Name}"
                      Width="80" />
                    <DataGridTemplateColumn
                      Header="功能 / 配置"
                      Width="*"
                      MinWidth="90">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel
                            Margin="3,1"
                            ToolTip="{Binding Converter={StaticResource PinSummary}}">
                            <TextBlock
                              Text="{Binding Function}"
                              TextTrimming="CharacterEllipsis" />
                            <TextBlock
                              Text="{Binding Converter={StaticResource PinSummary}}"
                              TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                      Header="封装脚"
                      Binding="{Binding PinNumber}"
                      Width="70" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
              <ScrollViewer
                x:Name="PropertyScroll"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel
                  Margin="4,2,5,4">
                  <StackPanel
                    x:Name="VerilogInspector"
                    Visibility="Collapsed">
                    <TextBlock
                      Text="Verilog 顶层端口"
                      FontWeight="SemiBold"
                      Margin="0,0,0,4" />
                    <TextBlock
                      x:Name="VerilogInterfaceStatus"
                      TextWrapping="Wrap"
                      Foreground="{DynamicResource Muted}"
                      Margin="0,0,0,6" />
                    <Label
                      Content="端口"
                      Target="{Binding ElementName=VerilogPortPicker}" />
                    <ComboBox
                      x:Name="VerilogPortPicker"
                      SelectionChanged="VerilogPort_Changed"
                      DisplayMemberPath="Label" />
                    <Label
                      Content="信号 / 总线位"
                      Target="{Binding ElementName=VerilogBitPicker}"
                      Margin="0,4,0,0" />
                    <ListBox
                      x:Name="VerilogBitPicker"
                      SelectedValuePath="Signal"
                      SelectionChanged="VerilogBit_Changed"
                      MaxHeight="162"
                      MinHeight="34"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingPanel.IsVirtualizing="True"
                      ItemContainerStyle="{StaticResource CodeCompletionItemStyle}">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <DockPanel
                            Margin="6,3">
                            <TextBlock
                              DockPanel.Dock="Right"
                              Text="{Binding Pin}"
                              Foreground="{DynamicResource Muted}"
                              Margin="8,0,0,0" />
                            <TextBlock
                              Text="{Binding Signal}"
                              TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <Label
                      Content="封装引脚"
                      Target="{Binding ElementName=VerilogPinPicker}"
                      Margin="0,4,0,0" />
                    <ComboBox
                      x:Name="VerilogPinPicker"
                      SelectionChanged="VerilogPin_Changed"
                      SelectedValuePath="Number"
                      DisplayMemberPath="Label" />
                    <TextBlock
                      x:Name="VerilogPortUsage"
                      TextWrapping="Wrap"
                      Foreground="{DynamicResource Muted}"
                      Margin="0,8,0,0" />
                  </StackPanel>
                  <StackPanel
                    x:Name="PinInspector">
                    <TextBlock
                      Text="当前引脚"
                      FontWeight="SemiBold" />
                    <TextBlock
                      x:Name="PinDetails"
                      Foreground="{DynamicResource Muted}"
                      TextWrapping="Wrap"
                      Margin="0,8,0,10" />
                    <WrapPanel
                      x:Name="PinLegend"
                      Margin="0,0,0,10">
                      <StackPanel
                        Orientation="Horizontal"
                        Margin="0,0,12,4">
                        <Border
                          Width="10"
                          Height="10"
                          Background="{x:Static local:Ag32PackageDiagram.AvailablePadBrush}" />
                        <TextBlock
                          Margin="4,0,0,0"
                          Text="可分配" />
                      </StackPanel>
                      <StackPanel
                        Orientation="Horizontal"
                        Margin="0,0,12,4">
                        <Border
                          Width="10"
                          Height="10"
                          Background="{x:Static local:Ag32PackageDiagram.SupplyPadBrush}" />
                        <TextBlock
                          Margin="4,0,0,0"
                          Text="电源 (VCC)" />
                      </StackPanel>
                      <StackPanel
                        Orientation="Horizontal"
                        Margin="0,0,12,4">
                        <Border
                          Width="10"
                          Height="10"
                          Background="{x:Static local:Ag32PackageDiagram.GroundPadBrush}" />
                        <TextBlock
                          Margin="4,0,0,0"
                          Text="地 (GND)" />
                      </StackPanel>
                      <StackPanel
                        Orientation="Horizontal"
                        Margin="0,0,12,4">
                        <Border
                          Width="10"
                          Height="10"
                          Background="{x:Static local:Ag32PackageDiagram.ReservedPadBrush}" />
                        <TextBlock
                          Margin="4,0,0,0"
                          Text="参考 / 保留" />
                      </StackPanel>
                      <StackPanel
                        Orientation="Horizontal"
                        Margin="0,0,12,4">
                        <Border
                          Width="10"
                          Height="10"
                          Background="{DynamicResource RunColor}" />
                        <TextBlock
                          Margin="4,0,0,0"
                          Text="已分配" />
                      </StackPanel>
                      <StackPanel
                        Orientation="Horizontal"
                        Margin="0,0,0,4">
                        <Border
                          Width="10"
                          Height="10"
                          Background="{DynamicResource ErrorColor}" />
                        <TextBlock
                          Margin="4,0,0,0"
                          Text="冲突" />
                      </StackPanel>
                    </WrapPanel>
                    <Grid
                      x:Name="PinEditor"
                      Margin="0,0,0,8"
                      Visibility="Collapsed">
                      <Grid.Resources>
                        <Style
                          TargetType="Label">
                          <Setter
                            Property="Padding"
                            Value="0,0,8,0" />
                          <Setter
                            Property="VerticalAlignment"
                            Value="Center" />
                          <Setter
                            Property="Foreground"
                            Value="{DynamicResource Text}" />
                        </Style>
                      </Grid.Resources>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition
                          x:Name="PinLabelColumn"
                          Width="Auto" />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition
                          Height="Auto" />
                        <RowDefinition
                          Height="Auto" />
                        <RowDefinition
                          Height="Auto" />
                        <RowDefinition
                          Height="Auto" />
                        <RowDefinition
                          Height="Auto" />
                      </Grid.RowDefinitions>
                      <Label
                        Content="引脚名称"
                        Target="{Binding ElementName=PinName}" />
                      <TextBox
                        x:Name="PinName"
                        Grid.Column="1"
                        Margin="0,0,0,4"
                        TextChanged="PinName_Changed"
                        ToolTip="例如 LED1，生成 LED1_Port 和 LED1_Bit。留空可清除名称。" />
                      <Label
                        Grid.Row="1"
                        Content="GPIO 方向"
                        Target="{Binding ElementName=PinDirection}"
                        Visibility="{Binding Visibility, ElementName=PinDirection}" />
                      <ComboBox
                        x:Name="PinDirection"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,0,0,4"
                        SelectedValuePath="Tag"
                        SelectionChanged="PinDirection_Changed">
                        <ComboBoxItem
                          Content="不初始化方向"
                          Tag="" />
                        <ComboBoxItem
                          Content="输入"
                          Tag="INPUT" />
                        <ComboBoxItem
                          Content="输出"
                          Tag="OUTPUT" />
                      </ComboBox>
                      <Label
                        Grid.Row="2"
                        Content="上下拉"
                        Target="{Binding ElementName=PinPull}"
                        Visibility="{Binding Visibility, ElementName=PinDirection}" />
                      <ComboBox
                        x:Name="PinPull"
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,0,0,4"
                        SelectedValuePath="Tag"
                        SelectionChanged="PinDirection_Changed"
                        Visibility="{Binding Visibility, ElementName=PinDirection}">
                        <ComboBoxItem
                          Content="浮空（无上下拉）"
                          Tag="NONE" />
                        <ComboBoxItem
                          Content="上拉"
                          Tag="UP" />
                        <ComboBoxItem
                          Content="下拉"
                          Tag="DOWN" />
                        <ComboBoxItem
                          Content="总线保持"
                          Tag="HOLD" />
                      </ComboBox>
                      <Label
                        Grid.Row="3"
                        Content="输出类型"
                        Target="{Binding ElementName=PinOutputType}"
                        Visibility="{Binding Visibility, ElementName=PinDirection}" />
                      <ComboBox
                        x:Name="PinOutputType"
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,0,0,4"
                        SelectedValuePath="Tag"
                        SelectionChanged="PinDirection_Changed"
                        Visibility="{Binding Visibility, ElementName=PinDirection}">
                        <ComboBoxItem
                          Content="推挽"
                          Tag="PUSH_PULL" />
                        <ComboBoxItem
                          Content="开漏"
                          Tag="OPEN_DRAIN" />
                      </ComboBox>
                      <StackPanel
                        x:Name="PinExtraFields"
                        Grid.Row="4"
                        Grid.ColumnSpan="2">
                        <StackPanel
                          x:Name="PinOutputFields">
                          <DockPanel
                            Margin="0,0,0,4"
                            LastChildFill="True">
                            <Label
                              DockPanel.Dock="Left"
                              Content="启动电平"
                              Width="{Binding ActualWidth, ElementName=PinLabelColumn}"
                              VerticalAlignment="Center"
                              Target="{Binding ElementName=PinLevel}" />
                            <ComboBox
                              x:Name="PinLevel"
                              SelectedValuePath="Tag"
                              SelectionChanged="PinDirection_Changed">
                              <ComboBoxItem
                                Tag="LOW"
                                Content="低电平" />
                              <ComboBoxItem
                                Tag="HIGH"
                                Content="高电平" />
                            </ComboBox>
                          </DockPanel>
                          <CheckBox
                            x:Name="PinSlew"
                            Content="启用输出转换速率控制"
                            Checked="PinSlew_Changed"
                            Unchecked="PinSlew_Changed"
                            ToolTip="设置此引脚的 Supra SLEW_RATE 控制位，编译并下载映射后生效。" />
                        </StackPanel>
                        <StackPanel
                          x:Name="PinInputFields">
                          <DockPanel
                            Margin="0,0,0,4"
                            LastChildFill="True">
                            <Label
                              DockPanel.Dock="Left"
                              Content="输入中断"
                              Width="{Binding ActualWidth, ElementName=PinLabelColumn}"
                              VerticalAlignment="Center"
                              Target="{Binding ElementName=PinInterrupt}" />
                            <ComboBox
                              x:Name="PinInterrupt"
                              SelectedValuePath="Tag"
                              SelectionChanged="PinDirection_Changed">
                              <ComboBoxItem
                                Tag="NONE"
                                Content="关闭" />
                              <ComboBoxItem
                                Tag="RISEEDGE"
                                Content="上升沿" />
                              <ComboBoxItem
                                Tag="FALLEDGE"
                                Content="下降沿" />
                              <ComboBoxItem
                                Tag="BOTHEDGE"
                                Content="双边沿" />
                              <ComboBoxItem
                                Tag="HIGHLEVEL"
                                Content="高电平" />
                              <ComboBoxItem
                                Tag="LOWLEVEL"
                                Content="低电平" />
                            </ComboBox>
                          </DockPanel>
                          <TextBlock
                            x:Name="PinInterruptHint"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource Muted}" />
                          <Button
                            Content="PLIC 中断设置…"
                            Click="OpenInterrupts_Click"
                            HorizontalAlignment="Left"
                            Margin="0,4" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                  <StackPanel
                    x:Name="AnalogInspector"
                    Visibility="Collapsed">
                    <TextBlock
                      Text="ADC / DAC / 比较器"
                      FontWeight="SemiBold"
                      Margin="0,0,0,6" />
                    <CheckBox
                      x:Name="AnalogEnabled"
                      Content="启用模拟 IP"
                      Checked="Analog_Changed"
                      Unchecked="Analog_Changed" />
                    <TextBlock
                      Text="ADC 外部输入"
                      FontWeight="SemiBold"
                      Margin="0,10,0,4" />
                    <WrapPanel
                      x:Name="AnalogChannels" />
                    <TextBlock
                      Text="仅使用内部通道时，外部输入留空。"
                      Foreground="{DynamicResource Muted}"
                      TextWrapping="Wrap" />
                    <TextBlock
                      Text="DAC 输出与比较器"
                      FontWeight="SemiBold"
                      Margin="0,10,0,4" />
                    <WrapPanel>
                      <CheckBox
                        x:Name="AnalogDac0"
                        Margin="0,2,12,2"
                        Checked="Analog_Changed"
                        Unchecked="Analog_Changed" />
                      <CheckBox
                        x:Name="AnalogDac1"
                        Margin="0,2,12,2"
                        Checked="Analog_Changed"
                        Unchecked="Analog_Changed" />
                    </WrapPanel>
                    <CheckBox
                      x:Name="AnalogComparator"
                      Content="CMP 比较器"
                      Margin="0,4"
                      Checked="Analog_Changed"
                      Unchecked="Analog_Changed" />
                    <TextBlock
                      x:Name="AnalogComparatorPins"
                      Foreground="{DynamicResource Muted}"
                      TextWrapping="Wrap" />
                    <TextBlock
                      Text="DAC 初始值和启动方式可在 DAC0 / DAC1 中设置。ADC2 与 DAC1 共用 DMA 资源。"
                      Foreground="{DynamicResource Muted}"
                      TextWrapping="Wrap"
                      Margin="0,8,0,0" />
                  </StackPanel>
                  <StackPanel
                    x:Name="TimerInspector"
                    Visibility="Collapsed">
                    <StackPanel.Resources>
                      <Style
                        TargetType="Label">
                        <Setter
