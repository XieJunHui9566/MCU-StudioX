                            Target="{Binding ElementName=UartParity}" />
                          <ComboBox
                            x:Name="UartParity"
                            SelectedValuePath="Tag"
                            SelectionChanged="UartField_Changed">
                            <ComboBoxItem
                              Tag="NONE"
                              Content="无" />
                            <ComboBoxItem
                              Tag="ODD"
                              Content="奇校验" />
                            <ComboBoxItem
                              Tag="EVEN"
                              Content="偶校验" />
                            <ComboBoxItem
                              Tag="ONE"
                              Content="固定为 1" />
                            <ComboBoxItem
                              Tag="ZERO"
                              Content="固定为 0" />
                          </ComboBox>
                        </DockPanel>
                        <DockPanel
                          Margin="0,0,0,4"
                          LastChildFill="True">
                          <Label
                            DockPanel.Dock="Left"
                            Content="停止位"
                            Width="86"
                            VerticalAlignment="Center"
                            Target="{Binding ElementName=UartStopBits}" />
                          <ComboBox
                            x:Name="UartStopBits"
                            SelectionChanged="UartField_Changed" />
                        </DockPanel>
                      </StackPanel>
                    </Expander>
                    <Expander
                      x:Name="UartAdvanced"
                      Header="流控、FIFO 与中断优先级"
                      Margin="0,2"
                      Foreground="{DynamicResource Text}">
                      <StackPanel
                        Margin="2,6,2,0">
                        <DockPanel
                          Margin="0,0,0,4"
                          LastChildFill="True">
                          <Label
                            DockPanel.Dock="Left"
                            Content="硬件流控"
                            Width="86"
                            VerticalAlignment="Center"
                            Target="{Binding ElementName=UartFlow}" />
                          <ComboBox
                            x:Name="UartFlow"
                            SelectedValuePath="Tag"
                            SelectionChanged="UartField_Changed">
                            <ComboBoxItem
                              Tag="NONE"
                              Content="关闭" />
                            <ComboBoxItem
                              Tag="RTS"
                              Content="RTS" />
                            <ComboBoxItem
                              Tag="CTS"
                              Content="CTS" />
                            <ComboBoxItem
                              Tag="RTS_CTS"
                              Content="RTS + CTS" />
                          </ComboBox>
                        </DockPanel>
                        <DockPanel
                          x:Name="UartRtsRow"
                          Margin="0,0,0,4"
                          LastChildFill="True">
                          <Label
                            DockPanel.Dock="Left"
                            Content="RTS 引脚"
                            Width="86"
                            VerticalAlignment="Center"
                            Target="{Binding ElementName=UartRts}" />
                          <ComboBox
                            x:Name="UartRts"
                            Tag="NUARTRTS"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Number"
                            SelectionChanged="UartPin_Changed" />
                        </DockPanel>
                        <DockPanel
                          x:Name="UartCtsRow"
                          Margin="0,0,0,4"
                          LastChildFill="True">
                          <Label
                            DockPanel.Dock="Left"
                            Content="CTS 引脚"
                            Width="86"
                            VerticalAlignment="Center"
                            Target="{Binding ElementName=UartCts}" />
                          <ComboBox
                            x:Name="UartCts"
                            Tag="NUARTCTS"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Number"
                            SelectionChanged="UartPin_Changed" />
                        </DockPanel>
                        <CheckBox
                          x:Name="UartFifo"
                          Content="使用 16 字节硬件 FIFO"
                          Margin="0,3,0,7"
                          Checked="UartField_Changed"
                          Unchecked="UartField_Changed" />
                        <DockPanel
                          Margin="0,0,0,4"
                          LastChildFill="True">
                          <Label
                            DockPanel.Dock="Left"
                            Content="优先级"
                            Width="86"
                            VerticalAlignment="Center"
                            Target="{Binding ElementName=UartPriority}" />
                          <ComboBox
                            x:Name="UartPriority"
                            SelectionChanged="UartField_Changed" />
                        </DockPanel>
                      </StackPanel>
                    </Expander>
                    <TextBlock
                      x:Name="UartHint"
                      Foreground="{DynamicResource Muted}"
                      TextWrapping="Wrap"
                      Margin="0,4,0,4" />
                    <TextBlock
                      x:Name="UartStatus"
                      TextWrapping="Wrap"
                      Margin="0,4,0,6"
                      AutomationProperties.LiveSetting="Polite" />
                    <WrapPanel>
                      <Button
                        x:Name="UartPreviewButton"
                        Content="预览初始化代码"
                        Click="UartPreview_Click"
                        Margin="0,0,0,6" />
                    </WrapPanel>
                    <TextBox
                      x:Name="UartPreview"
                      Visibility="Collapsed"
                      IsReadOnly="True"
                      TextWrapping="Wrap"
                      Margin="0,6,0,0"
                      AutomationProperties.Name="初始化代码预览" />
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </DockPanel>
          <GridSplitter
            x:Name="PaneSplitter"
            Grid.Column="3"
            Style="{StaticResource PlannerSplitter}"
            ResizeDirection="Columns"
            ToolTip="拖动调整参数区和封装图区大小"
            AutomationProperties.Name="参数区与封装图区分隔线" />
          <DockPanel
            x:Name="PackagePane"
            Grid.Column="4"
            Margin="8,0,0,0">
            <DockPanel
              DockPanel.Dock="Bottom"
              Margin="0,5,0,0">
              <Button
                x:Name="FitPackageButton"
                DockPanel.Dock="Right"
                Content="适应窗口"
                Click="FitPackage_Click"
                Padding="6,3"
                ToolTip="将完整封装图居中显示" />
              <Button
                x:Name="ZoomInPackageButton"
                DockPanel.Dock="Right"
                Content="＋"
                AutomationProperties.Name="放大封装图"
                ToolTip="放大封装图（Ctrl + 滚轮可围绕指针缩放）"
                Click="ZoomIn_Click"
                Padding="5,2"
                Margin="4,0" />
              <Button
                DockPanel.Dock="Left"
                Content="－"
                AutomationProperties.Name="缩小封装图"
                ToolTip="缩小封装图"
                Click="ZoomOut_Click"
                Padding="5,2"
                Margin="0,0,4,0" />
              <Slider
                x:Name="DiagramZoom"
                Minimum="15"
                Maximum="400"
                Value="100"
                SmallChange="5"
                LargeChange="25"
                ToolTip="{Binding Value, RelativeSource={RelativeSource Self}, StringFormat={}{0:F0}%}"
                AutomationProperties.Name="封装图缩放"
                ValueChanged="DiagramZoom_Changed"
                VerticalAlignment="Center" />
            </DockPanel>
            <ScrollViewer
              x:Name="DiagramViewport"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Auto"
              SizeChanged="DiagramViewport_SizeChanged"
              PreviewMouseWheel="DiagramViewport_Wheel"
              Background="{DynamicResource EditorSurface}">
              <Grid
                x:Name="DiagramSurface"
                Background="Transparent"
                Cursor="Hand"
                ToolTip="按住鼠标左键拖动封装图，单击引脚查看或配置。"
                PreviewMouseLeftButtonDown="DiagramSurface_PanStart"
                PreviewMouseMove="DiagramSurface_PanMove"
                PreviewMouseLeftButtonUp="DiagramSurface_PanEnd"
                LostMouseCapture="DiagramSurface_PanLost"
                MouseLeave="DiagramSurface_MouseLeave">
                <Viewbox
                  x:Name="DiagramHost"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Stretch="Uniform">
                  <Viewbox.RenderTransform>
                    <TranslateTransform
                      x:Name="DiagramTranslation" />
                  </Viewbox.RenderTransform>
                  <local:Ag32PackageDiagram
                    x:Name="PackageDiagram" />
                </Viewbox>
              </Grid>
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </TabItem>
      <TabItem
        x:Name="IrqTab"
        Header="中断 / PLIC">
        <DockPanel
          Margin="10,8"
          Grid.IsSharedSizeScope="True">
          <WrapPanel
            DockPanel.Dock="Top"
            Margin="0,0,0,6">
            <Label
              Content="搜索中断"
              Target="{Binding ElementName=IrqSearch}"
              Foreground="{DynamicResource Text}" />
            <TextBox
              x:Name="IrqSearch"
              MinWidth="130"
              TextChanged="IrqFilter_Changed"
              Margin="0,0,12,0" />
            <CheckBox
              x:Name="IrqEnabledOnly"
              Content="仅显示已启用向量"
              VerticalAlignment="Center"
              Checked="IrqFilter_Changed"
              Unchecked="IrqFilter_Changed" />
          </WrapPanel>
          <TextBlock
            DockPanel.Dock="Top"
            Foreground="{DynamicResource Muted}"
            TextWrapping="Wrap"
            Margin="0,0,0,8"
            Text="同一向量共用一个优先级。1 最低，15 最高。" />
          <Expander
            x:Name="IrqCodePanel"
            DockPanel.Dock="Bottom"
            Header="回调与源码"
            Margin="0,6,0,0"
            Foreground="{DynamicResource Text}">
            <StackPanel>
              <TextBlock
                Margin="4,3"
                TextWrapping="Wrap"
                Foreground="{DynamicResource Muted}"
                Text="保存并生成后，可点击事件下方的“编写回调”进入用户代码。" />
              <TextBox
                x:Name="IrqCodeSummary"
                IsReadOnly="True"
                TextWrapping="Wrap"
                MaxHeight="125"
                VerticalScrollBarVisibility="Auto"
                AutomationProperties.Name="中断入口、回调和文件" />
            </StackPanel>
          </Expander>
          <Grid
            DockPanel.Dock="Top"
            Margin="2,0,0,3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition
                Width="Auto"
                SharedSizeGroup="IrqVector" />
              <ColumnDefinition
                Width="Auto"
                SharedSizeGroup="IrqPriority" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock
              Text="中断向量"
              Margin="4,2,12,2" />
            <TextBlock
              Grid.Column="1"
              Text="优先级"
              Margin="2,2,12,2" />
            <TextBlock
              Grid.Column="2"
              Text="触发事件"
              Margin="4,2" />
          </Grid>
          <TextBlock
            DockPanel.Dock="Top"
            x:Name="IrqEmpty"
            TextWrapping="Wrap"
            Margin="4,10"
            Foreground="{DynamicResource Muted}" />
          <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <ItemsControl
              x:Name="InterruptRows">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource Border}"
                    Padding="2,4">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition
                          Width="Auto"
                          SharedSizeGroup="IrqVector" />
                        <ColumnDefinition
                          Width="Auto"
                          SharedSizeGroup="IrqPriority" />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <Button
                        Content="{Binding Vector}"
                        Click="LocateIrqModule_Click"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        ToolTip="{Binding LocationHint}"
                        Margin="0,0,8,0" />
                      <ComboBox
                        Grid.Column="1"
                        ItemsSource="{Binding Priorities}"
                        SelectedItem="{Binding Priority, Mode=TwoWay}"
                        Visibility="{Binding PriorityVisibility}"
                        IsEnabled="{Binding Enabled}"
                        MinWidth="58"
                        Margin="0,0,8,0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{Binding Vector, StringFormat={}{0} 优先级}" />
                      <TextBlock
                        Grid.Column="1"
                        Text="内核固定"
                        Visibility="{Binding FixedPriorityVisibility}"
                        Foreground="{DynamicResource Muted}"
                        Margin="0,2,6,0" />
                      <StackPanel
                        Grid.Column="2">
                        <ItemsControl
                          ItemsSource="{Binding Events}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel
                                Margin="4,1,10,2"
                                VerticalAlignment="Center">
                                <CheckBox
                                  Content="{Binding Label}"
                                  IsEnabled="{Binding CanToggle}"
                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                  Visibility="{Binding SwitchVisibility}"
                                  ToolTip="{Binding Hint}" />
                                <WrapPanel
                                  Visibility="{Binding TriggerVisibility}">
                                  <TextBlock
                                    Text="{Binding Label}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,5,0" />
                                  <ComboBox
                                    ItemsSource="{Binding Triggers}"
                                    DisplayMemberPath="Label"
                                    SelectedValuePath="Code"
                                    SelectedValue="{Binding Trigger, Mode=TwoWay}"
                                    AutomationProperties.Name="{Binding Label}"
                                    ToolTip="{Binding Hint}" />
                                </WrapPanel>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl
                          ItemsSource="{Binding Hooks}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button
                                Content="{Binding Label}"
                                Click="WriteCallback_Click"
                                ToolTip="{Binding Hint}"
                                Margin="4,2,4,0" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>
      <TabItem
        x:Name="TimingTab"
        Header="时钟 / 时序">
        <ScrollViewer
          VerticalScrollBarVisibility="Auto">
          <StackPanel
            Margin="16">
            <Border
              x:Name="TimingBorder"
              BorderThickness="2,0,0,0"
              Padding="12,6"
              Margin="0,0,0,12"
              BorderBrush="{DynamicResource DiagnosticWarning}">
              <StackPanel>
                <TextBlock
                  x:Name="TimingStateText"
                  FontWeight="SemiBold"
                  TextWrapping="Wrap"
                  Foreground="{DynamicResource DiagnosticWarning}" />
                <TextBlock
                  x:Name="TimingSummaryText"
                  TextWrapping="Wrap"
                  Margin="0,5,0,0" />
                <Expander
                  x:Name="TimingDetails"
                  Header="查看关键路径与原始报告"
                  Foreground="{DynamicResource Text}"
                  Margin="0,6,0,0">
                  <StackPanel>
                    <TextBlock
                      x:Name="TimingPathText"
                      TextWrapping="Wrap"
                      Margin="0,6,0,6" />
                    <Button
                      x:Name="TimingReportButton"
                      Content="打开 Supra 原始时序报告"
                      HorizontalAlignment="Left"
                      Click="TimingReport_Click"
                      IsEnabled="False" />
                    <TextBlock
                      x:Name="TimingScopeText"
                      Text="片内时序结果，不含外部器件采样时序。"
                      TextWrapping="Wrap"
                      Foreground="{DynamicResource Muted}"
                      Margin="0,6,0,0" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
            <TextBlock
              Text="单位 MHz；留空沿用默认。频率需与板上晶振和固件一致。"
              TextWrapping="Wrap"
              Foreground="{DynamicResource Muted}"
              Margin="0,0,0,16" />
            <TextBlock
              Text="HSECLK · 外部输入时钟" />
            <TextBox
              x:Name="HseClock"
              TextChanged="Clock_Changed"
              Margin="0,6,0,12" />
            <TextBlock
              Text="SYSCLK · 系统时钟" />
            <TextBox
              x:Name="SysClock"
              TextChanged="Clock_Changed"
              Margin="0,6,0,12" />
            <TextBlock
              Text="BUSCLK · 总线时钟" />
            <TextBox
              x:Name="BusClock"
              TextChanged="Clock_Changed"
              Margin="0,6,0,12" />
            <TextBlock
              x:Name="ClockGuidanceText"
              TextWrapping="Wrap"
              Foreground="{DynamicResource DiagnosticWarning}"
              Margin="0,0,0,12" />
            <TextBlock
              Text="模拟 IP 推荐组合（SYS / BUS）"
              Margin="0,0,0,6" />
            <ComboBox
              x:Name="RecommendedClocks"
              DisplayMemberPath="Name"
              SelectionChanged="Recommendation_Changed"
              Margin="0,0,0,8" />
            <Button
              x:Name="ApplyRecommendedClockButton"
              Content="应用推荐时钟并保存"
              HorizontalAlignment="Left"
              Click="ApplyRecommendedClock_Click"
              ToolTip="保留当前 HSE、引脚和模拟设置，保存整份图形草稿并重新生成系统层；仍需点击顶部编译验证实际时序。"
              Margin="0,0,0,8" />
            <TextBlock
              x:Name="RecommendationDetails"
              TextWrapping="Wrap"
              Foreground="{DynamicResource Muted}"
              Margin="0,0,0,14" />
            <TextBlock
              Text="保存约束后重新编译"
              TextWrapping="Wrap"
              Foreground="{DynamicResource Muted}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem
        Header="约束文件">
        <ScrollViewer
          VerticalScrollBarVisibility="Auto">
          <StackPanel
            Margin="16">
            <TextBlock
              Text="保存后可查看生成的约束"
              TextWrapping="Wrap"
              Foreground="{DynamicResource Muted}"
              Margin="0,0,0,12" />
            <TextBox
              x:Name="ConstraintDetails"
              IsReadOnly="True"
              TextWrapping="Wrap"
              Background="Transparent"
              BorderThickness="0"
              MinHeight="80" />
            <WrapPanel>
              <Button
                x:Name="VexButton"
                Content="打开引脚约束数据"
                IsEnabled="False"
                Click="Vex_Click"
                Margin="0,8,8,8" />
              <Button
                x:Name="SdcButton"
                Content="打开时序约束 SDC"
                IsEnabled="False"
                Click="Sdc_Click"
                Margin="0,8,0,8" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
