<UserControl
  x:Class="StudioX.Desktop.Ag32PinPlanningView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:StudioX.Desktop">
  <StackPanel>
    <TextBlock
      Text="图形化引脚与时钟配置"
      FontSize="20"
      FontWeight="SemiBold"
      Margin="0,8,0,8" />
    <TextBlock
      x:Name="PackageText"
      Foreground="{DynamicResource Muted}"
      TextWrapping="Wrap"
      Margin="0,0,0,12" />
    <WrapPanel>
      <Button
        x:Name="SavePlanButton"
        Content="保存并生成约束"
        Style="{DynamicResource PrimaryButton}"
        Click="Save_Click"
        Margin="0,0,8,12" />
      <Button
        x:Name="ReloadPlanButton"
        Content="重新读取 .ve"
        ToolTip="放弃尚未保存的图形配置，重新读取磁盘文件"
        Click="Reload_Click"
        Margin="0,0,0,12" />
    </WrapPanel>
    <Border
      x:Name="TimingBorder"
      BorderThickness="2,0,0,0"
      Padding="12,6"
      Margin="0,0,0,12"
      BorderBrush="{DynamicResource DiagnosticWarning}">
      <StackPanel>
        <TextBlock
          x:Name="TimingStateText"
          FontWeight="SemiBold"
          TextWrapping="Wrap"
          Foreground="{DynamicResource DiagnosticWarning}" />
        <TextBlock
          x:Name="TimingSummaryText"
          TextWrapping="Wrap"
          Margin="0,5,0,0" />
        <Expander
          x:Name="TimingDetails"
          Header="查看关键路径与原始报告"
          Foreground="{DynamicResource Text}"
          Margin="0,6,0,0">
          <StackPanel>
            <TextBlock
              x:Name="TimingPathText"
              TextWrapping="Wrap"
              Margin="0,6,0,6" />
            <Button
              x:Name="TimingReportButton"
              Content="打开 Supra 原始时序报告"
              HorizontalAlignment="Left"
              Click="TimingReport_Click"
              IsEnabled="False" />
            <TextBlock
              Text="片内时序结果，不含外部器件采样时序。"
              TextWrapping="Wrap"
              Foreground="{DynamicResource Muted}"
              Margin="0,6,0,0" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </Border>
    <TextBlock
      x:Name="ConflictStatus"
      Visibility="Collapsed"
      Foreground="{DynamicResource ErrorColor}"
      TextWrapping="Wrap"
      Margin="0,4,0,10" />
    <TabControl
      x:Name="PlannerTabs"
      SelectedIndex="1">
      <TabItem
        Header="ADC / DAC / 比较器">
        <StackPanel
          Margin="16">
          <CheckBox
            x:Name="AnalogEnabled"
            Content="启用 ADC / DAC / CMP（官方模拟 IP）"
            Checked="Analog_Changed"
            Unchecked="Analog_Changed"
            Margin="0,0,0,12" />
          <TextBlock
            Text="模拟引脚固定，不能与数字功能共用。"
            TextWrapping="Wrap"
            Margin="0,0,0,12" />
          <TextBlock
            Text="ADC 外部通道（逗号分隔，例如 0,1,4；留空仅使用内部通道）" />
          <TextBox
            x:Name="AnalogChannels"
            TextChanged="AnalogText_Changed"
            Margin="0,6,0,12"
            MaxWidth="480"
            HorizontalAlignment="Left"
            MinWidth="260" />
          <WrapPanel>
            <CheckBox
              x:Name="AnalogDac0"
              Content="DAC0"
              Checked="Analog_Changed"
              Unchecked="Analog_Changed"
              Margin="0,0,24,12" />
            <CheckBox
              x:Name="AnalogDac1"
              Content="DAC1"
              Checked="Analog_Changed"
              Unchecked="Analog_Changed"
              Margin="0,0,24,12" />
            <CheckBox
              x:Name="AnalogComparator"
              Content="CMP 比较器（预留输入脚）"
              Checked="Analog_Changed"
              Unchecked="Analog_Changed"
              Margin="0,0,0,12" />
          </WrapPanel>
          <ScrollViewer
            MaxHeight="190"
            VerticalScrollBarVisibility="Auto"
            Margin="0,0,0,12">
            <TextBlock
              x:Name="AnalogPinDetails"
              TextWrapping="Wrap" />
          </ScrollViewer>
          <TextBlock
            Text="DAC 需在代码中使能；ADC2 与 DAC1 不能同时使用 DMA。"
            TextWrapping="Wrap"
            Foreground="{DynamicResource Muted}" />
        </StackPanel>
      </TabItem>
      <TabItem
        Header="引脚分配">
        <Grid
          Margin="8,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition
              Width="3*" />
            <ColumnDefinition
              Width="2*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <ScrollViewer
              Height="580"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Auto">
              <Viewbox
                Height="{Binding Value, ElementName=DiagramZoom}"
                Width="{Binding Value, ElementName=DiagramZoom}"
                Stretch="Uniform">
                <local:Ag32PackageDiagram
                  x:Name="PackageDiagram" />
              </Viewbox>
            </ScrollViewer>
            <DockPanel
              Margin="0,8,12,0">
              <TextBlock
                Text="封装图缩放"
                VerticalAlignment="Center"
                Margin="0,0,12,0" />
              <Slider
                x:Name="DiagramZoom"
                Minimum="400"
                Maximum="1200"
                Value="560"
                SmallChange="30"
                LargeChange="120"
                ToolTip="放大后可滚动查看引脚；左键点击引脚打开功能菜单" />
            </DockPanel>
            <TextBlock
              Text="顶视示意图 · 灰色：空闲 · 绿色：已分配 · 红色：冲突 · 蓝色边框：当前选择"
              Foreground="{DynamicResource Muted}"
              TextWrapping="Wrap"
              Margin="0,8,12,0" />
          </StackPanel>
          <StackPanel
            Grid.Column="1"
            Margin="16,0,0,0">
            <TextBlock
              Text="当前引脚"
              FontWeight="SemiBold" />
            <TextBlock
              x:Name="PinDetails"
              Foreground="{DynamicResource Muted}"
              TextWrapping="Wrap"
              Margin="0,8,0,10" />
            <TextBlock
              Text="点击引脚分配功能"
              Foreground="{DynamicResource Muted}"
              TextWrapping="Wrap"
              Margin="0,0,0,18" />
            <TextBlock
              Text="引脚名称 / GPIO 方向"
              FontWeight="SemiBold" />
            <WrapPanel
              Margin="0,6,0,8">
              <TextBox
                x:Name="PinName"
                Width="125"
                Margin="0,0,8,6"
                TextChanged="PinName_Changed"
                ToolTip="例如 LED1：生成 #LED1 注释及 LED1_Port / LED1_Bit。留空可清除名称。" />
              <ComboBox
                x:Name="PinDirection"
                Width="135"
                SelectedValuePath="Tag"
                SelectionChanged="PinDirection_Changed"
                Margin="0,0,0,6">
                <ComboBoxItem
                  Content="不初始化方向"
                  Tag="" />
                <ComboBoxItem
                  Content="输入"
                  Tag="INPUT" />
                <ComboBoxItem
                  Content="输出（初始低）"
                  Tag="OUTPUT" />
              </ComboBox>
            </WrapPanel>
            <TextBlock
              Text="GPIO 电气配置"
              FontWeight="SemiBold"
              Margin="0,0,0,6" />
            <WrapPanel
              Margin="0,0,0,8">
              <StackPanel
                Width="150"
                Margin="0,0,8,6">
                <TextBlock
                  Text="上下拉"
                  Foreground="{DynamicResource Muted}"
                  Margin="0,0,0,4" />
                <ComboBox
                  x:Name="PinPull"
                  SelectedValuePath="Tag"
                  SelectionChanged="PinDirection_Changed">
                  <ComboBoxItem
                    Content="浮空（无上下拉）"
                    Tag="NONE" />
                  <ComboBoxItem
                    Content="上拉"
                    Tag="UP" />
                  <ComboBoxItem
                    Content="下拉"
                    Tag="DOWN" />
                </ComboBox>
              </StackPanel>
              <StackPanel
                Width="135"
                Margin="0,0,0,6">
                <TextBlock
                  Text="输出类型"
                  Foreground="{DynamicResource Muted}"
                  Margin="0,0,0,4" />
                <ComboBox
                  x:Name="PinOutputType"
                  SelectedValuePath="Tag"
                  SelectionChanged="PinDirection_Changed">
                  <ComboBoxItem
                    Content="推挽"
                    Tag="PUSH_PULL" />
                  <ComboBoxItem
                    Content="开漏"
                    Tag="OPEN_DRAIN" />
                </ComboBox>
              </StackPanel>
            </WrapPanel>
            <TextBlock
              Text="保存生成初始化代码；引脚配置下载后生效。"
              TextWrapping="Wrap"
              Foreground="{DynamicResource Muted}"
              Margin="0,0,0,8" />
            <TextBlock
              Text="已分配功能"
              FontWeight="SemiBold"
              Margin="0,0,0,8" />
            <DataGrid
              x:Name="AssignmentsGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              SelectionMode="Single"
              SelectionChanged="Assignment_Changed"
              Background="Transparent"
              Foreground="{DynamicResource Text}"
              BorderBrush="{DynamicResource Border}"
              RowBackground="Transparent"
              AlternatingRowBackground="{DynamicResource Surface}"
              GridLinesVisibility="None"
              HeadersVisibility="Column"
              MinHeight="150"
              MaxHeight="250"
              Margin="0,4,0,0">
              <DataGrid.ColumnHeaderStyle>
                <Style
                  TargetType="DataGridColumnHeader">
                  <Setter
                    Property="Background"
                    Value="{DynamicResource Panel}" />
                  <Setter
                    Property="Foreground"
                    Value="{DynamicResource Text}" />
                  <Setter
                    Property="Padding"
                    Value="8,6" />
                  <Setter
                    Property="BorderBrush"
                    Value="{DynamicResource Border}" />
                  <Setter
                    Property="BorderThickness"
                    Value="0,0,0,1" />
                </Style>
              </DataGrid.ColumnHeaderStyle>
              <DataGrid.CellStyle>
                <Style
                  TargetType="DataGridCell">
                  <Setter
                    Property="Foreground"
                    Value="{DynamicResource Text}" />
                  <Setter
                    Property="Background"
                    Value="Transparent" />
                  <Setter
                    Property="Padding"
                    Value="8,4" />
                  <Setter
                    Property="BorderThickness"
                    Value="0" />
                  <Style.Triggers>
                    <Trigger
                      Property="IsSelected"
                      Value="True">
                      <Setter
                        Property="Background"
                        Value="{DynamicResource Accent}" />
                      <Setter
                        Property="Foreground"
                        Value="{DynamicResource OnAccent}" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </DataGrid.CellStyle>
              <DataGrid.Columns>
                <DataGridTextColumn
                  Header="名称"
                  Binding="{Binding Name}"
                  Width="80" />
                <DataGridTextColumn
                  Header="内部功能"
                  Binding="{Binding Function}"
                  Width="*" />
                <DataGridTextColumn
                  Header="封装脚"
                  Binding="{Binding PinNumber}"
                  Width="70" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem
        Header="时钟 / 时序">
        <StackPanel
          Margin="16">
          <TextBlock
            Text="单位 MHz；留空沿用默认。频率需与板上晶振和固件一致。"
            TextWrapping="Wrap"
            Foreground="{DynamicResource Muted}"
            Margin="0,0,0,16" />
          <TextBlock
            Text="HSECLK · 外部输入时钟" />
          <TextBox
            x:Name="HseClock"
            TextChanged="Clock_Changed"
            Margin="0,6,0,12" />
          <TextBlock
            Text="SYSCLK · 系统时钟" />
          <TextBox
            x:Name="SysClock"
            TextChanged="Clock_Changed"
            Margin="0,6,0,12" />
          <TextBlock
            Text="BUSCLK · 总线时钟" />
          <TextBox
            x:Name="BusClock"
            TextChanged="Clock_Changed"
            Margin="0,6,0,12" />
          <TextBlock
            x:Name="ClockGuidanceText"
            TextWrapping="Wrap"
            Foreground="{DynamicResource DiagnosticWarning}"
            Margin="0,0,0,12" />
          <TextBlock
            Text="模拟 IP 推荐组合（SYS / BUS）"
            Margin="0,0,0,6" />
          <ComboBox
            x:Name="RecommendedClocks"
            DisplayMemberPath="Name"
            SelectionChanged="Recommendation_Changed"
            Margin="0,0,0,8" />
          <Button
            x:Name="ApplyRecommendedClockButton"
            Content="应用推荐时钟并保存"
            HorizontalAlignment="Left"
            Click="ApplyRecommendedClock_Click"
            ToolTip="保留当前 HSE、引脚和模拟设置，保存整份图形草稿并重新生成系统层；仍需点击顶部编译验证实际时序。"
            Margin="0,0,0,8" />
          <TextBlock
            x:Name="RecommendationDetails"
            TextWrapping="Wrap"
            Foreground="{DynamicResource Muted}"
            Margin="0,0,0,14" />
          <TextBlock
            Text="保存约束后重新编译"
            TextWrapping="Wrap"
            Foreground="{DynamicResource Muted}" />
        </StackPanel>
      </TabItem>
      <TabItem
        Header="约束文件">
        <StackPanel
          Margin="16">
          <TextBlock
            Text="保存后可查看生成的约束"
            TextWrapping="Wrap"
            Foreground="{DynamicResource Muted}"
            Margin="0,0,0,12" />
          <TextBox
            x:Name="ConstraintDetails"
            IsReadOnly="True"
            TextWrapping="Wrap"
            Background="Transparent"
            BorderThickness="0"
            MinHeight="80" />
          <WrapPanel>
            <Button
              x:Name="VexButton"
              Content="打开引脚约束数据"
              IsEnabled="False"
              Click="Vex_Click"
              Margin="0,8,8,8" />
            <Button
              x:Name="SdcButton"
              Content="打开时序约束 SDC"
              IsEnabled="False"
              Click="Sdc_Click"
              Margin="0,8,0,8" />
          </WrapPanel>
        </StackPanel>
      </TabItem>
    </TabControl>
    <TextBlock
      x:Name="PlannerStatus"
      TextWrapping="Wrap"
      Foreground="{DynamicResource Muted}"
      Margin="0,12,0,8" />
  </StackPanel>
</UserControl>
