<Window
  x:Class="StudioX.Desktop.AiSettingsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="AI 接口设置"
  Width="620"
  MinWidth="540"
  Height="720"
  MinHeight="600"
  SizeToContent="Manual"
  ResizeMode="CanResize"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
  Style="{StaticResource {x:Type Window}}">
  <DockPanel
    Margin="24">
    <StackPanel
      DockPanel.Dock="Top">
      <TextBlock
        Text="AI 接口设置"
        FontSize="22"
        FontWeight="SemiBold" />
      <TextBlock
        Text="仅支持 OpenAI 兼容的 Chat Completions API（包括 DeepSeek）。不支持 Anthropic 系列的 Messages API。"
        TextWrapping="Wrap"
        Foreground="{DynamicResource Muted}"
        Margin="0,7,0,20" />
    </StackPanel>
    <StackPanel
      DockPanel.Dock="Bottom">
      <TextBlock
        x:Name="ErrorText"
        Foreground="#E87979"
        TextWrapping="Wrap"
        Margin="0,10,0,0" />
      <StackPanel
        Orientation="Horizontal"
        HorizontalAlignment="Right"
        Margin="0,20,0,0">
        <Button
          Content="取消"
          IsCancel="True"
          MinWidth="76"
          Margin="0,0,10,0" />
        <Button
          x:Name="SaveButton"
          Content="保存设置"
          IsDefault="True"
          MinWidth="100"
          Style="{StaticResource PrimaryButton}"
          Click="Save_Click" />
      </StackPanel>
    </StackPanel>
    <TabControl
      x:Name="AiSettingsTabs"
      Background="{DynamicResource EditorSurface}"
      Foreground="{DynamicResource Text}"
      BorderBrush="{DynamicResource Border}">
      <TabItem
        Header="模型 API">
        <ScrollViewer
          VerticalScrollBarVisibility="Auto"
          HorizontalScrollBarVisibility="Disabled">
          <StackPanel
            Margin="12,16,12,12">
            <TextBlock
              Text="API 路由地址"
              Margin="0,0,0,7" />
            <TextBox
              x:Name="BaseUrlInput" />
            <TextBlock
              Text="模型"
              Margin="0,16,0,7" />
            <TextBox
              x:Name="ModelInput" />
            <TextBlock
              Text="上下文窗口 token 数（可选）"
              Margin="0,16,0,7" />
            <TextBox
              x:Name="ContextWindowInput" />
            <TextBlock
              Text="DeepSeek 已知模型自动读取窗口上限；其他接口可在这里填写服务商公布的数值。"
              Foreground="{DynamicResource Muted}"
              FontSize="11"
              TextWrapping="Wrap"
              Margin="0,6,0,0" />
            <TextBlock
              Text="API Key"
              Margin="0,16,0,7" />
            <PasswordBox
              x:Name="KeyInput"
              Background="{DynamicResource EditorSurface}"
              Foreground="{DynamicResource Text}"
              BorderBrush="{DynamicResource Border}" />
            <TextBlock
              x:Name="KeyState"
              Foreground="{DynamicResource Muted}"
              FontSize="11"
              Margin="0,7,0,0" />
            <Button
              x:Name="DeleteKeyButton"
              Content="删除已保存的 API Key"
              Click="DeleteKey_Click"
              HorizontalAlignment="Left"
              Margin="0,16,0,0" />
            <TextBlock
              Text="API Key 保存在当前 Windows 用户凭据中。"
              Foreground="{DynamicResource Muted}"
              FontSize="11"
              Margin="0,16,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem
        Header="自定义 MCP"
        x:Name="McpSettingsTab">
        <ScrollViewer
          VerticalScrollBarVisibility="Auto"
          HorizontalScrollBarVisibility="Disabled">
          <StackPanel
            Margin="12,16,12,12">
            <StackPanel
              x:Name="McpPanel"
              Margin="0">
              <TextBlock
                Text="自定义 MCP 服务"
                FontSize="15"
                FontWeight="SemiBold" />
              <TextBlock
                Text="添加自己的远端接口或本地 MCP 程序。支持 Streamable HTTP、SSE、stdio；工具按需发现，减少 DeepSeek 输入量。"
                Foreground="{DynamicResource Muted}"
                TextWrapping="Wrap"
                FontSize="11"
                Margin="0,7,0,10" />
              <ListBox
                x:Name="McpServersList"
                MinHeight="180"
                MaxHeight="300"
                Background="{DynamicResource EditorSurface}"
                Foreground="{DynamicResource Text}"
                BorderBrush="{DynamicResource Border}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel
                      Orientation="Horizontal">
                      <CheckBox
                        IsChecked="{Binding Enabled, Mode=OneWay}"
                        IsHitTestVisible="False"
                        Focusable="False"
                        Margin="0,0,8,0" />
                      <TextBlock
                        Text="{Binding Name}"
                        Margin="0,0,10,0" />
                      <TextBlock
                        Text="{Binding Transport}"
                        Foreground="{DynamicResource Muted}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel
                Orientation="Horizontal"
                Margin="0,10,0,0">
                <Button
                  Content="添加 MCP"
                  Click="McpAdd_Click"
                  Margin="0,0,8,0" />
                <Button
                  Content="编辑 / 测试"
                  Click="McpEdit_Click"
                  Margin="0,0,8,0" />
                <Button
                  Content="删除"
                  Click="McpRemove_Click" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem
        Header="联网资料">
        <ScrollViewer
          VerticalScrollBarVisibility="Auto"
          HorizontalScrollBarVisibility="Disabled">
          <StackPanel
            Margin="12,16,12,12">
            <TextBlock
              Text="联网搜索（Tavily）"
              FontSize="16"
              FontWeight="SemiBold" />
            <TextBlock
              Text="不填密钥也可使用免密钥搜索和网页读取；频繁使用可填写自己的 Tavily API Key。"
              Foreground="{DynamicResource Muted}"
              FontSize="11"
              TextWrapping="Wrap"
              Margin="0,7,0,0" />
            <TextBlock
              Text="Tavily API Key（可选）"
              Margin="0,14,0,7" />
            <PasswordBox
              x:Name="WebKeyInput"
              Background="{DynamicResource EditorSurface}"
              Foreground="{DynamicResource Text}"
              BorderBrush="{DynamicResource Border}" />
            <TextBlock
              x:Name="WebKeyState"
              Foreground="{DynamicResource Muted}"
              FontSize="11"
              Margin="0,7,0,0" />
            <Button
              x:Name="DeleteWebKeyButton"
              Content="删除 Tavily API Key"
              Click="DeleteWebKey_Click"
              HorizontalAlignment="Left"
              Margin="0,12,0,0" />
            <TextBlock
              Text="乐鑫官方资料"
              FontSize="16"
              FontWeight="SemiBold"
              Margin="0,22,0,0" />
            <TextBlock
              Text="组件库可直接查询；文档库需在浏览器登录 GitHub 或微信。文档库主要提供最新版资料，Agent 会核对工程的 IDF 版本。"
              Foreground="{DynamicResource Muted}"
              FontSize="11"
              TextWrapping="Wrap"
              Margin="0,7,0,0" />
            <TextBlock
              x:Name="EspressifState"
              Foreground="{DynamicResource Muted}"
              FontSize="11"
              TextWrapping="Wrap"
              Margin="0,10,0,0" />
            <WrapPanel
              Margin="0,12,0,0">
              <Button
                x:Name="ConnectEspressifButton"
                Content="连接乐鑫文档"
                Click="ConnectEspressif_Click"
                Margin="0,0,8,8" />
              <Button
                x:Name="DisconnectEspressifButton"
                Content="断开连接"
                Click="DisconnectEspressif_Click"
                Margin="0,0,8,8" />
              <Button
                x:Name="CancelEspressifButton"
                Content="取消连接"
                Click="CancelEspressif_Click"
                Visibility="Collapsed"
                Margin="0,0,0,8" />
            </WrapPanel>
            <TextBlock
              Text="授权凭据仅保存在当前 Windows 用户的加密存储中。查询只发送公开检索词，不发送工程源码或模型 API Key。"
              Foreground="{DynamicResource Muted}"
              FontSize="11"
              TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
