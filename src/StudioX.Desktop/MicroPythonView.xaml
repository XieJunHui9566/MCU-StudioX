<UserControl x:Class="StudioX.Desktop.MicroPythonView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- 可编辑端口需要 PART_EditableTextBox；普通选择框模板只呈现 SelectionBoxItem。 -->
    <Style x:Key="PortCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" />
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <TextBox x:Name="PART_EditableTextBox"
                Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource TemplatedParent}}"
                Background="Transparent" Foreground="{DynamicResource Text}" BorderThickness="0"
                Padding="0" Margin="8,5,28,5" VerticalContentAlignment="Center" />
              <Path IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,0,10,0" Data="M0,0 L4,4 8,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.2" />
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="4"
                  MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="300"><ItemsPresenter /></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Border Background="{DynamicResource EditorSurface}">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid MinHeight="{Binding ViewportHeight, ElementName=PageScroll}">
        <Grid Margin="18,14" SizeChanged="Content_SizeChanged">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,14">
            <TextBlock Text="MicroPython 下载" FontSize="22" Foreground="{DynamicResource Text}" />
            <TextBlock x:Name="ProjectText" Margin="0,6,0,0" Text="请先打开 MicroPython 工程。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
          </StackPanel>
          <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="设备连接" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,0,0,8" />
              <WrapPanel>
                <TextBlock Text="USB 串口" Foreground="{DynamicResource Text}" VerticalAlignment="Center" Margin="0,0,8,8" />
                <ComboBox x:Name="PortPicker" Style="{StaticResource PortCombo}" Width="150" IsEditable="True" Margin="0,0,8,8"
                  AutomationProperties.Name="MicroPython USB 串口" ToolTip="选择或输入开发板端口，例如 COM5" />
                <Button x:Name="RefreshButton" Content="刷新端口" Click="Refresh_Click" Margin="0,0,8,8" />
                <Button x:Name="ConnectButton" Content="连接 REPL" Click="Connect_Click" Margin="0,0,8,8" ToolTip="连接会中断板上正在执行的程序" />
                <Button x:Name="StopButton" Content="停止 / 断开" Click="Stop_Click" Margin="0,0,8,8" />
                <Button x:Name="FirmwareButton" Content="安装解释器说明" Click="Firmware_Click" Margin="0,0,0,8" />
              </WrapPanel>
              <TextBlock x:Name="ConnectionText" Text="未连接" TextWrapping="Wrap" Foreground="{DynamicResource Text}" />
            </StackPanel>
          </Border>
          <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="下载脚本" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,0,0,8" />
              <WrapPanel>
                <TextBox x:Name="ScriptPath" Text="main.py" Width="240" Margin="0,0,8,8"
                  AutomationProperties.Name="下载脚本路径" ToolTip="工程内相对路径，例如 main.py、boot.py、lib/sensor.py" />
                <Button x:Name="UploadButton" Content="下载脚本" Click="Upload_Click" Margin="0,0,8,8" />
                <Button x:Name="StartButton" Content="开始运行" Click="Start_Click" Margin="0,0,0,8"
                        ToolTip="运行板上已下载的指定脚本，持续显示输出；点击停止可中断。" />
              </WrapPanel>
              <TextBlock Text="顶部下载按钮执行相同操作：保存编辑内容，再下载到所选串口；连接会中断板上程序。"
                TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
              <TextBlock Text="下载完成后点击「开始运行」；运行板上已下载版本，修改代码后请先重新下载。" Margin="0,4,0,0"
                TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock x:Name="OperationText" Text="选择串口后，点击顶部下载或下方下载脚本。" TextWrapping="Wrap" Foreground="{DynamicResource Text}" />
            <ProgressBar x:Name="OperationProgress" Height="3" Margin="0,8,0,0" IsIndeterminate="True" Visibility="Collapsed" />
          </StackPanel>
          <Grid x:Name="ReplArea" Grid.Row="4" MinHeight="210">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="CommandColumn" Width="2*" />
              <ColumnDefinition x:Name="OutputColumn" Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition x:Name="OutputRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid x:Name="CommandPane" Margin="0,0,12,0" MinHeight="180">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock Text="REPL 输入" Foreground="{DynamicResource Text}" FontWeight="SemiBold" Margin="0,0,0,8" />
              <TextBox x:Name="CommandText" Grid.Row="1" Text="print('Hello from MicroPython')" MinHeight="60"
                AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
              <StackPanel Grid.Row="2" Margin="0,8,0,0">
                <Button x:Name="ExecuteButton" Content="执行 REPL 片段" Click="Execute_Click" HorizontalAlignment="Left" />
                <TextBlock Text="表达式用 print 显示；每次最多 30 秒，可点击顶部停止。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" />
              </StackPanel>
            </Grid>
            <Grid x:Name="OutputPane" Grid.Column="1" MinHeight="180">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="清空显示" Click="Clear_Click" Padding="8,2" />
                <TextBlock Text="执行结果 / 下载日志 · 宿主时间" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Text}" FontWeight="SemiBold" />
              </DockPanel>
              <TextBox x:Name="OutputText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </ScrollViewer>
  </Border>
</UserControl>
