<UserControl
  x:Class="StudioX.Desktop.HdlSchematicView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:StudioX.Desktop">
  <Grid
    Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="*" />
    </Grid.RowDefinitions>
    <WrapPanel
      Margin="0,0,0,10">
      <Button
        x:Name="GenerateButton"
        Content="生成电路图"
        Click="Generate_Click"
        Margin="0,0,8,0" />
      <Button
        Content="编辑 Verilog"
        Click="Edit_Click"
        Margin="0,0,8,0" />
      <Button
        x:Name="BackButton"
        Content="返回"
        ToolTip="返回上一个模块并恢复缩放、滚动和选择"
        Click="Back_Click"
        IsEnabled="False"
        Margin="0,0,8,0" />
      <ComboBox
        x:Name="Modules"
        MinWidth="180"
        MaxWidth="300"
        SelectionChanged="Module_Changed"
        Margin="0,0,12,0" />
      <Button
        Content="−"
        Click="ZoomOut_Click" />
      <TextBlock
        x:Name="ZoomText"
        Text="100%"
        VerticalAlignment="Center"
        Margin="8,0" />
      <Button
        Content="+"
        Click="ZoomIn_Click"
        Margin="0,0,8,0" />
      <Button
        Content="适应窗口"
        Click="Fit_Click"
        Margin="0,0,8,0" />
      <Button
        x:Name="ExportButton"
        Content="导出 SVG"
        Click="Export_Click"
        IsEnabled="False"
        Margin="0,0,8,0" />
      <Button
        x:Name="LogButton"
        Content="综合日志"
        Click="Log_Click"
        IsEnabled="False" />
    </WrapPanel>
    <Expander
      x:Name="SettingsPanel"
      Grid.Row="1"
      Header="综合配置（工程相对路径）"
      Foreground="{DynamicResource Text}"
      Margin="0,0,0,10">
      <Grid
        Margin="0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <StackPanel
          Margin="0,0,12,0">
          <TextBlock
            Text="源文件（每行一个 .v / .sv）" />
          <TextBox
            x:Name="Sources"
            AcceptsReturn="True"
            Height="85"
            VerticalScrollBarVisibility="Auto" />
        </StackPanel>
        <StackPanel
          Grid.Column="1"
          Margin="0,0,12,0">
          <TextBlock
            Text="包含目录（每行一个）" />
          <TextBox
            x:Name="Includes"
            AcceptsReturn="True"
            Height="85"
            VerticalScrollBarVisibility="Auto" />
        </StackPanel>
        <StackPanel
          Grid.Column="2">
          <TextBlock
            Text="顶层模块（空白为自动选择）" />
          <TextBox
            x:Name="TopModule" />
          <TextBlock
            Text="宏（空格分隔，NAME 或 NAME=值）"
            Margin="0,6,0,0" />
          <TextBox
            x:Name="Defines" />
          <CheckBox
            x:Name="Flatten"
            Content="展开子模块"
            Foreground="{DynamicResource Text}"
            Margin="0,6,0,0" />
        </StackPanel>
      </Grid>
    </Expander>
    <TextBlock
      Grid.Row="2"
      x:Name="Summary"
      Text="尚未生成电路图"
      TextWrapping="Wrap"
      Margin="0,0,0,10" />
    <Grid
      Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition
          Width="*" />
        <ColumnDefinition
          Width="270" />
      </Grid.ColumnDefinitions>
      <ScrollViewer
        x:Name="Viewport"
        Background="{DynamicResource Background}"
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto"
        PreviewMouseWheel="Viewport_Wheel">
        <local:HdlDiagramSurface
          x:Name="Surface"
          HorizontalAlignment="Left"
          VerticalAlignment="Top" />
      </ScrollViewer>
      <DockPanel
        Grid.Column="1"
        Margin="14,0,0,0">
        <StackPanel
          DockPanel.Dock="Top">
          <Label
            Content="搜索信号"
            Foreground="{DynamicResource Text}"
            Padding="0,0,0,4"
            Target="{Binding ElementName=SignalSearch}" />
          <TextBox
            x:Name="SignalSearch"
            IsEnabled="False"
            ToolTip="按名称或位号查找当前模块和子模块中的信号"
            TextChanged="SignalSearch_Changed"
            PreviewKeyDown="SignalSearch_KeyDown" />
          <ListBox
            x:Name="SignalResults"
            Visibility="Collapsed"
            MaxHeight="120"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}"
            ItemContainerStyle="{StaticResource CodeCompletionItemStyle}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            PreviewMouseLeftButtonUp="SignalResults_Click"
            PreviewKeyDown="SignalSearch_KeyDown">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock
                  Text="{Binding Label}"
                  ToolTip="{Binding Label}"
                  TextTrimming="CharacterEllipsis"
                  MaxWidth="240" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock
            x:Name="SignalSearchStatus"
            Visibility="Collapsed"
            Foreground="{DynamicResource Muted}"
            TextWrapping="Wrap"
            Margin="0,4,0,0" />
          <StackPanel
            x:Name="TracePanel"
            Visibility="Collapsed"
            Margin="0,8,0,0">
            <Label
              Content="驱动端与使用端"
              Foreground="{DynamicResource Text}"
              Padding="0,0,0,4"
              Target="{Binding ElementName=TraceEndpoints}" />
            <ComboBox
              x:Name="TraceEndpoints"
              DisplayMemberPath="Label"
              SelectionChanged="TraceEndpoint_Changed" />
          </StackPanel>
        </StackPanel>
        <WrapPanel
          DockPanel.Dock="Bottom"
          Margin="0,8,0,0">
          <Button
            x:Name="SourceButton"
            Content="定位源码"
            Click="Source_Click"
            IsEnabled="False"
            Margin="0,0,8,0" />
          <Button
            x:Name="EnterModuleButton"
            Content="进入子模块"
            Visibility="Collapsed"
            Click="EnterModule_Click" />
        </WrapPanel>
        <TextBox
          x:Name="Details"
          IsReadOnly="True"
          TextWrapping="Wrap"
          VerticalScrollBarVisibility="Auto"
          Margin="0,8,0,0"
          BorderThickness="0"
          Background="Transparent" />
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>
