<Window x:Class="StudioX.Desktop.EntryNameWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="名称" Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
 <StackPanel Margin="22">
  <TextBlock x:Name="Prompt" Margin="0,0,0,12" TextWrapping="Wrap"/>
  <TextBox x:Name="NameInput" MinWidth="300" AutomationProperties.Name="文件或文件夹名称"/>
  <TextBlock x:Name="ErrorLabel" Foreground="#E87979" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
   <Button Content="取消" IsCancel="True" MinWidth="76" Margin="0,0,10,0"/>
   <Button x:Name="AcceptButton" Content="确定" IsDefault="True" MinWidth="76" Style="{StaticResource PrimaryButton}" Click="Accept_Click"/>
  </StackPanel>
 </StackPanel>
</Window>
