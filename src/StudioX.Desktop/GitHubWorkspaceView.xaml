<UserControl x:Class="StudioX.Desktop.GitHubWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12">
 <UserControl.Resources>
  <Style x:Key="CollabList" TargetType="ListBox">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/>
   <Setter Property="Background" Value="{DynamicResource ToolSurface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="ListBox">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
      <ScrollViewer Focusable="False" CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
     </Border>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="CollabReadOnlyText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="Background" Value="{DynamicResource Background}"/>
   <Setter Property="Foreground" Value="{DynamicResource Text}"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="TextBox">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
      <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
     </Border>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
 </UserControl.Resources>
 <Grid Background="{DynamicResource Background}">
  <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition/><RowDefinition Height="28"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource ChromeSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
   <DockPanel Margin="16,8">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock x:Name="AccountStatus" Text="正在读取 GitHub 登录状态…" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <ComboBox x:Name="AccountPicker" Width="145" MinHeight="28" Margin="0,0,8,0" SelectionChanged="Account_Changed" ToolTip="用于 GitHub HTTPS 同步与 Pull Request 的账号；SSH 使用密钥"/>
     <Button x:Name="LoginButton" Content="登录 GitHub" Click="Login_Click" Margin="0,0,6,0"/>
     <Button x:Name="LogoutButton" Content="退出账号" Click="Logout_Click" IsEnabled="False" Margin="0,0,6,0"/>
     <Button x:Name="CancelActionButton" Content="取消" Click="CancelAction_Click" IsEnabled="False"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="GitHub 协作" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <TextBlock Text="仓库、分支和 Pull Request" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <TabControl x:Name="CollaborationTabs" Grid.Row="1" Margin="12,10,12,6">
   <TabItem Header="仓库与分支">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel MaxWidth="1020" Margin="22,18" HorizontalAlignment="Stretch">
      <TextBlock Text="克隆 GitHub 仓库" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Text="克隆完成后，如目录中有 StudioX 工程，IDE 将直接打开。" Foreground="{DynamicResource Muted}" Margin="0,5,0,12"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="仓库地址" VerticalAlignment="Center"/>
       <TextBox x:Name="CloneUrlBox" Grid.Column="1" MinWidth="460" ToolTip="https://github.com/owner/repo.git 或 git@github.com:owner/repo.git"/>
       <Button x:Name="CloneButton" Grid.Column="2" Content="克隆并打开" Click="Clone_Click" Margin="10,0,0,0"/>
      </Grid>
      <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="保存位置" VerticalAlignment="Center"/>
       <TextBox x:Name="CloneDestinationBox" Grid.Column="1" ToolTip="新目录完整路径；已存在且非空时拒绝克隆"/>
       <Button Grid.Column="2" Content="选择目录…" Click="ChooseCloneDestination_Click" Margin="10,0,0,0"/>
      </Grid>
      <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,22,0,19"/>
      <TextBlock Text="当前协作仓库" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock x:Name="CurrentProjectText" Text="未打开工程" Foreground="{DynamicResource Muted}" Margin="0,7,0,11" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,0,0,16">
       <Button Content="选择本地仓库…" Click="ChooseLocalRepository_Click" MinWidth="136" Margin="0,0,10,8"/>
       <Button x:Name="InitializeGitButton" Content="初始化 Git" Click="InitializeGit_Click" MinWidth="106" Margin="0,0,10,8"/>
       <Button Content="刷新" Click="Refresh_Click" MinWidth="72" Margin="0,0,0,8"/>
      </WrapPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="远端仓库" VerticalAlignment="Center"/>
       <ComboBox x:Name="RemotePicker" Grid.Column="1" MinHeight="29" IsEditable="True" SelectionChanged="Remote_Changed" ToolTip="远端名称，如 origin"/>
       <TextBox x:Name="RemoteUrlBox" Grid.Column="2" Margin="9,0,0,0" ToolTip="当前远端的 Git URL"/>
       <Button x:Name="SaveRemoteButton" Grid.Column="3" Content="保存远端" Click="SaveRemote_Click" Margin="9,0,0,0"/>
      </Grid>
      <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="推送地址" VerticalAlignment="Center"/>
       <TextBlock Grid.Column="1" Text="可与仓库地址相同" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
       <TextBox x:Name="PushUrlBox" Grid.Column="2" Margin="9,0,0,0" ToolTip="远端的实际推送 URL；只接受不含凭据的地址"/>
       <Button x:Name="SavePushUrlButton" Grid.Column="3" Content="保存推送地址" Click="SavePushUrl_Click" Margin="9,0,0,0"/>
      </Grid>
      <TextBlock x:Name="RemoteHint" Text="设置 GitHub 远端后可获取、发布和同步分支。" Foreground="{DynamicResource Muted}" Margin="130,6,0,0" TextWrapping="Wrap"/>
      <WrapPanel Margin="130,15,0,0">
       <Button x:Name="FetchButton" Content="获取更新" Click="Fetch_Click" Margin="0,0,8,0"/>
       <Button x:Name="PullButton" Content="快进拉取" Click="Pull_Click" Margin="0,0,8,0"/>
       <Button x:Name="PushButton" Content="推送当前分支" Click="Push_Click" Margin="0,0,8,0"/>
       <Button x:Name="PublishButton" Content="发布当前分支" Click="Publish_Click"/>
      </WrapPanel>
      <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,22,0,19"/>
      <DockPanel><TextBlock Text="远端分支" FontSize="16" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="刷新分支" Click="RefreshBranches_Click" HorizontalAlignment="Right"/></DockPanel>
      <TextBlock Text="先获取更新，再检出同事的分支；检出会改变工作区。" Foreground="{DynamicResource Muted}" Margin="0,5,0,10"/>
      <ListBox x:Name="RemoteBranchesList" Style="{StaticResource CollabList}" Height="190" MinWidth="700" DisplayMemberPath="Display" SelectionChanged="RemoteBranch_Changed"/>
      <WrapPanel Margin="0,10,0,4">
       <Button x:Name="CheckoutRemoteButton" Content="检出所选分支" Click="CheckoutRemote_Click" Margin="0,0,8,0"/>
       <Button x:Name="SetUpstreamButton" Content="设为当前分支上游" Click="SetUpstream_Click"/>
      </WrapPanel>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="Pull Requests">
    <Grid Margin="12,12,12,8">
     <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition/></Grid.RowDefinitions>
     <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
       <Button x:Name="CreatePrButton" Content="创建 PR" Click="CreatePr_Click" Margin="0,0,8,0"/>
       <Button x:Name="RefreshPrButton" Content="刷新 PR" Click="RefreshPr_Click"/>
      </StackPanel>
      <TextBlock x:Name="PrRepositoryText" Text="先连接 GitHub 远端" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,15,0"/>
      <ComboBox x:Name="PrStatePicker" Width="115" MinHeight="28" SelectionChanged="PrState_Changed"/>
     </DockPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="360" MinWidth="270"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="410"/></Grid.ColumnDefinitions>
      <ListBox x:Name="PrList" Style="{StaticResource CollabList}" BorderThickness="0" SelectionChanged="Pr_Changed">
       <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="12,9">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/>
       </StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="{DynamicResource Background}"/>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="{DynamicResource ToolSurface}">
       <StackPanel Margin="20,16">
        <TextBlock x:Name="PrDetailTitle" Text="选择一条 Pull Request" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <StackPanel x:Name="PrDetailsPanel" Visibility="Collapsed">
        <TextBlock x:Name="PrDetailMeta" Foreground="{DynamicResource Muted}" Margin="0,7,0,11" TextWrapping="Wrap"/>
        <TextBox x:Name="PrBody" Style="{StaticResource CollabReadOnlyText}" IsReadOnly="True" MinHeight="75" MaxHeight="170" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <TextBlock Text="检查与审阅" FontWeight="SemiBold" Margin="0,17,0,6"/>
        <TextBlock x:Name="PrChecksText" Text="尚未读取" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
        <TextBlock x:Name="PrReviewsText" Text="" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <TextBlock Text="改动文件" FontWeight="SemiBold" Margin="0,17,0,6"/>
        <ListBox x:Name="PrFilesList" Style="{StaticResource CollabList}" Height="115" DisplayMemberPath="Display" SelectionChanged="PrFile_Changed"/>
        <TextBox x:Name="PrPatch" Style="{StaticResource CollabReadOnlyText}" Height="150" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
        <TextBlock Text="讨论" FontWeight="SemiBold" Margin="0,17,0,6"/>
        <TextBox x:Name="PrDiscussion" Style="{StaticResource CollabReadOnlyText}" Height="100" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <TextBox x:Name="PrReviewBody" Height="65" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,11,0,7" ToolTip="审批、请求修改或评论时填写内容"/>
        <WrapPanel>
         <Button x:Name="PrCommentButton" Content="发表评论" Click="PrComment_Click" Margin="0,0,8,0"/>
         <Button x:Name="PrApproveButton" Content="批准" Click="PrApprove_Click" Margin="0,0,8,0"/>
         <Button x:Name="PrChangesButton" Content="请求修改" Click="PrChanges_Click"/>
        </WrapPanel>
        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,18,0,13"/>
        <DockPanel>
         <Button x:Name="PrMergeButton" DockPanel.Dock="Right" Content="合并 PR…" Click="PrMerge_Click"/>
         <ComboBox x:Name="PrMergeMethodPicker" Width="145" MinHeight="28" HorizontalAlignment="Left"/>
        </DockPanel>
        </StackPanel>
       </StackPanel>
      </ScrollViewer>
     </Grid>
    </Grid>
   </TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="{DynamicResource ChromeSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
   <TextBlock x:Name="WorkspaceStatus" Text="就绪" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>
  </Border>
 </Grid>
</UserControl>
