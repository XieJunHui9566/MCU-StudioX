<Window x:Class="StudioX.Desktop.CubeMxImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="导入 CubeMX CMake 工程" Style="{StaticResource {x:Type Window}}" Width="640" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <StackPanel Margin="28">
  <TextBlock Text="导入 CubeMX CMake 工程" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,10"/>
  <TextBlock Text="继续开发已有工程，沿用 CubeMX 生成的源码与配置。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,22"/>
  <TextBlock x:Name="ProjectInfo" FontWeight="SemiBold" FontSize="15"/>
  <TextBlock x:Name="ProjectPath" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,18"/>
  <TextBlock Text="构建配置" Margin="0,0,0,7"/>
  <ComboBox x:Name="Configuration" MinHeight="32"/>
  <Border Background="{DynamicResource Panel}" Padding="14" Margin="0,20,0,22" CornerRadius="4">
   <StackPanel>
    <TextBlock Text="使用内置 ARM GCC、CMake 和 Ninja"/>
    <TextBlock Text="保留 Core、Drivers、用户库及原有 CMake 文件。&#x0a;新增 .studiox 工程信息，编译输出位于 .build。&#x0a;首次导入会配置 CMake，准备代码提示与跳转。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="23" Margin="0,8,0,0"/>
   </StackPanel>
  </Border>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="取消" IsCancel="True" MinWidth="84" Margin="0,0,10,0"/>
   <Button Content="导入并打开" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Import_Click"/>
  </StackPanel>
 </StackPanel>
</Window>
