<UserControl x:Class="StudioX.Desktop.RtosDebugView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Background="{DynamicResource ToolSurface}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <WrapPanel Margin="8,4">
   <Button x:Name="RefreshButton" Content="刷新 RTOS" Padding="9,3" Click="Refresh_Click"/>
   <Button x:Name="CancelButton" Content="取消读取" Padding="9,3" Margin="5,0,0,0" Visibility="Collapsed" Click="Cancel_Click"/>
   <CheckBox x:Name="AutoRefresh" Content="暂停后自动刷新" IsChecked="True" VerticalAlignment="Center" Margin="12,2,0,2"/>
   <TextBlock Text="只读 · FreeRTOS" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"/>
  </WrapPanel>
  <TextBlock x:Name="StatusText" Grid.Row="1" Text="暂停目标后读取 FreeRTOS 内核。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="9,1,9,3"/>
  <TextBlock x:Name="SchedulerText" Grid.Row="2" Text="调度器 / Tick / 当前任务：—" TextWrapping="Wrap" Margin="9,0,9,4" FontSize="12"/>
  <TabControl x:Name="RtosTabs" Grid.Row="3">
   <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="Padding" Value="11,5"/></Style></TabControl.Resources>
   <TabItem Header="任务"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DataGrid x:Name="TasksGrid" Style="{StaticResource DebugGrid}" SelectionChanged="Task_SelectionChanged" HorizontalScrollBarVisibility="Auto">
     <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="ToolTip" Value="{Binding Details}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Panel}"/></Trigger><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DebugChanged}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
     <DataGrid.Columns>
      <DataGridTextColumn Header="任务" Binding="{Binding Name}" Width="*" MinWidth="100"/>
      <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="85"/>
      <DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="65"/>
      <DataGridTextColumn Header="基础优先级" Binding="{Binding BasePriority}" Width="95"/>
      <DataGridTextColumn Header="最小栈余量(B)" Binding="{Binding StackMinimum}" Width="120"/>
      <DataGridTextColumn Header="记录栈容量(B)" Binding="{Binding StackSize}" Width="120"/>
     </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="1" Margin="9,3"><TextBlock x:Name="TaskDetails" Text="选择任务查看 TCB 和保存的栈指针。" TextWrapping="Wrap" FontSize="11"/><TextBlock Text="栈余量是填充值扫描结果；— 表示缺少符号、栈边界或填充证据。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0"/></StackPanel>
   </Grid></TabItem>
   <TabItem Header="堆"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="9,5">
    <TextBlock x:Name="HeapCaption" Text="未读取堆信息。" TextWrapping="Wrap" Margin="0,0,0,5"/>
    <ProgressBar x:Name="HeapUsage" Height="7" Minimum="0" Maximum="100" Foreground="{DynamicResource Accent}" Background="{DynamicResource Border}" Visibility="Collapsed" Margin="0,0,0,6"/>
    <ItemsControl x:Name="HeapItems"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Consolas"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="统计来自 FreeRTOS 分配器；不包含 libc malloc、静态对象和任务的独立静态栈。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,7,0,0"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="对象"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="5,3"><Button x:Name="ObserveButton" Content="观察句柄" DockPanel.Dock="Right" Padding="9,3" Click="Observe_Click"/><TextBox x:Name="ObjectSymbol" Padding="6,3" Margin="0,0,5,0" ToolTip="全局 QueueHandle_t / SemaphoreHandle_t 名字，例如 ledQueue；不执行函数" KeyDown="ObjectSymbol_KeyDown"/></DockPanel>
    <DockPanel Grid.Row="1" Margin="9,1,9,3"><Button x:Name="RemoveObjectButton" Content="移除" DockPanel.Dock="Right" Padding="7,1" Click="RemoveObject_Click"/><ComboBox x:Name="ObservedSymbols" MinWidth="80" Margin="0,0,5,0" ToolTip="手动观察的符号；仅用于当前工程"/></DockPanel>
    <DataGrid x:Name="ObjectsGrid" Grid.Row="2" Style="{StaticResource DebugGrid}" SelectionChanged="Object_SelectionChanged" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns>
     <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="100"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="115" MinWidth="115"/><DataGridTextColumn Header="当前数量" Binding="{Binding Count}" Width="80" MinWidth="80"/><DataGridTextColumn Header="容量" Binding="{Binding Capacity}" Width="65" MinWidth="65"/><DataGridTextColumn Header="项大小(B)" Binding="{Binding ItemSize}" Width="90" MinWidth="90"/><DataGridTextColumn Header="等发送" Binding="{Binding SendWaiters}" Width="65" MinWidth="65"/><DataGridTextColumn Header="等接收" Binding="{Binding ReceiveWaiters}" Width="65" MinWidth="65"/>
    </DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="3" Margin="9,3"><TextBlock x:Name="ObjectDetails" Text="选择对象查看地址和互斥锁持有者。" TextWrapping="Wrap" FontSize="11"/><TextBlock Text="显示队列注册表和手动观察的句柄；未注册的对象不会自动枚举。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0"/></StackPanel>
   </Grid></TabItem>
   <TabItem Header="读取诊断"><TextBox x:Name="DiagnosticsText" IsReadOnly="True" Text="尚未读取。" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" FontSize="11" FontFamily="Consolas, Microsoft YaHei UI" VerticalScrollBarVisibility="Auto" Padding="9,5"/></TabItem>
  </TabControl>
 </Grid>
</UserControl>
