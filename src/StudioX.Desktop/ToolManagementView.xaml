<UserControl x:Class="StudioX.Desktop.ToolManagementView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}">
 <Grid Margin="18,12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="5"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="工具占用与升级管理" FontSize="22" FontWeight="SemiBold"/>
   <TextBlock Text="查看依赖和 IDE 占用，预览离线升级，保留工程锁定版本。" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
   <WrapPanel x:Name="Toolbar" Margin="0,10,0,4">
    <Button Content="刷新占用" Click="Refresh_Click" Margin="0,0,8,5"/>
    <Button x:Name="InstallButton" Content="预览并安装新版本…" Click="Install_Click" Margin="0,0,8,5"/>
    <Button Content="登记其他工程…" Click="Register_Click" Margin="0,0,8,5"/>
    <Button Content="查看工程检查范围…" Click="Scope_Click" Margin="0,0,8,5"/>
    <Button x:Name="ExportButton" Content="导出占用报告…" Click="Export_Click" Margin="0,0,8,5" IsEnabled="False"/>
    <Button Content="使用说明" Click="Help_Click" Margin="0,0,8,5"/>
   </WrapPanel>
  </StackPanel>
  <TextBlock x:Name="StatusText" Grid.Row="1" TextWrapping="Wrap" Margin="0,3,0,10" Text="正在读取工具版本与依赖…"/>
  <DataGrid x:Name="VersionsGrid" Grid.Row="2" Style="{DynamicResource DebugGrid}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
   CanUserAddRows="False" EnableRowVirtualization="True" FontFamily="Microsoft YaHei UI" FontSize="13" MinRowHeight="32" SelectionChanged="Selection_Changed"
   AutomationProperties.Name="工具版本与空间占用">
   <DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGrid.Resources>
   <DataGrid.Columns>
    <DataGridTextColumn Header="工具集" Binding="{Binding Name}" Width="*" MinWidth="160"/>
    <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="105"/>
    <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="130"/>
    <DataGridTextColumn Header="逻辑大小" Binding="{Binding SizeText}" Width="105"/>
    <DataGridTextColumn Header="依赖" Binding="{Binding ReferenceText}" Width="190"/>
   </DataGrid.Columns>
  </DataGrid>
  <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="{DynamicResource Border}"/>
  <DockPanel Grid.Row="4" Margin="0,10,0,0">
   <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
    <Button x:Name="VerifyButton" Content="完整校验" Click="Verify_Click" Margin="0,0,8,5" IsEnabled="False"/>
    <Button x:Name="RetireButton" Content="移至可恢复区…" Click="Retire_Click" Margin="0,0,8,5" IsEnabled="False"/>
    <Button x:Name="RestoreButton" Content="恢复此版本…" Click="Restore_Click" Margin="0,0,8,5" IsEnabled="False"/>
    <Button x:Name="PurgeButton" Content="永久删除此版本…" ToolTip="仅删除可恢复区中的所选版本，删除后不可恢复。" Click="Purge_Click" Margin="0,0,8,5" IsEnabled="False"/>
   </WrapPanel>
   <TextBox x:Name="DetailText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{DynamicResource ToolSurface}"
    Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Border}" Padding="10" AutomationProperties.Name="依赖来源与组件详情"/>
  </DockPanel>
 </Grid>
</UserControl>
