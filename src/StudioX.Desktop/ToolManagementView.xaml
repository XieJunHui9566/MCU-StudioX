<UserControl
  x:Class="StudioX.Desktop.ToolManagementView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="Transparent"
  Foreground="{DynamicResource Text}">
  <Grid
    Margin="18,12">
    <Grid.RowDefinitions>
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="3*" />
      <RowDefinition
        Height="5" />
      <RowDefinition
        Height="2*" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock
        Text="开发环境组件管理"
        FontSize="22"
        FontWeight="SemiBold" />
      <TextBlock
        x:Name="DescriptionText"
        Text="管理预装与导入的开发环境组件。只在使用或点击校验时检查内容，工程始终使用锁定版本。"
        TextWrapping="Wrap"
        Foreground="{DynamicResource Muted}"
        Margin="0,6,0,0" />
      <WrapPanel
        x:Name="Toolbar"
        Margin="0,8,0,2">
        <Button
          Content="刷新列表"
          Click="Refresh_Click"
          Margin="0,0,8,5" />
        <Button
          Content="从 GitHub 获取…"
          Click="Github_Click"
          Margin="0,0,8,5" />
        <Button
          x:Name="InstallButton"
          Content="导入开发环境组件…"
          ToolTip="导入 .mcutoolchain；完整包和轻量包共用此入口。"
          Click="Install_Click"
          Margin="0,0,8,5" />
        <Button
          x:Name="RecoveryButton"
          Content="恢复未完成操作…"
          Click="Recovery_Click"
          Margin="0,0,8,5"
          Visibility="Collapsed" />
        <Button
          Content="准备当前工程…"
          Click="Prepare_Click"
          Margin="0,0,8,5" />
        <Button
          Content="依赖与报告 ▾"
          Click="Options_Click"
          Margin="0,0,8,5">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem
                Header="登记其他工程…"
                Click="Register_Click" />
              <MenuItem
                Header="查看工程检查范围…"
                Click="Scope_Click" />
              <MenuItem
                x:Name="ExportButton"
                Header="导出占用报告…"
                Click="Export_Click"
                IsEnabled="False" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <Button
          Content="使用说明"
          Click="Help_Click"
          Margin="0,0,8,5" />
      </WrapPanel>
    </StackPanel>
    <TextBlock
      x:Name="StatusText"
      Grid.Row="1"
      TextWrapping="Wrap"
      Margin="0,2,0,6"
      Text="正在读取开发环境组件版本与依赖…" />
    <StackPanel
      Grid.Row="2"
      Margin="0,0,0,6">
      <TextBlock
        x:Name="SelectionText"
        Text="选择一个开发环境组件版本"
        FontWeight="SemiBold"
        TextWrapping="Wrap" />
      <WrapPanel
        x:Name="SelectionActions"
        Margin="0,4,0,0">
        <Button
          x:Name="ToggleButton"
          Content="禁用"
          Click="Toggle_Click"
          Margin="0,0,8,5"
          IsEnabled="False" />
        <Button
          x:Name="PurgeButton"
          Content="删除…"
          Click="Purge_Click"
          Margin="0,0,8,5"
          IsEnabled="False" />
        <Button
          x:Name="VerifyButton"
          Content="完整校验"
          Click="Verify_Click"
          Margin="0,0,8,5"
          IsEnabled="False"
          ToolTip="只校验所选 ID 与版本，不扫描其他组件。" />
        <Button
          x:Name="DebugCheckButton"
          Content="调试环境检查"
          Click="DebugCheck_Click"
          Margin="0,0,8,5"
          IsEnabled="False"
          ToolTip="完整校验所选组件并查询 GCC/GDB/OpenOCD 版本，不连接设备。" />
        <Button
          x:Name="RestoreButton"
          Content="恢复…"
          Click="Restore_Click"
          Margin="0,0,8,5"
          IsEnabled="False"
          Visibility="Collapsed" />
        <Button
          Content="更多操作 ▾"
          Click="Options_Click"
          Margin="0,0,8,5">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem
                x:Name="RetireButton"
                Header="移至可恢复区…"
                Click="Retire_Click"
                IsEnabled="False" />
              <Separator />
              <MenuItem
                x:Name="ComponentExportButton"
                Header="导出为 .mcutoolchain…"
                Click="ComponentExport_Click"
                IsEnabled="False" />
              <MenuItem
                x:Name="RepairButton"
                Header="从本地文件修复…"
                Click="Repair_Click"
                IsEnabled="False" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </WrapPanel>
      <TextBlock
        x:Name="ManagementHint"
        Foreground="{DynamicResource Muted}"
        TextWrapping="Wrap" />
    </StackPanel>
    <DataGrid
      x:Name="VersionsGrid"
      Grid.Row="3"
      Style="{DynamicResource DebugGrid}"
      AutoGenerateColumns="False"
      IsReadOnly="True"
      SelectionMode="Single"
      CanUserAddRows="False"
      EnableRowVirtualization="True"
      FontFamily="Microsoft YaHei UI"
      FontSize="13"
      MinRowHeight="32"
      SelectionChanged="Selection_Changed"
      AutomationProperties.Name="开发环境组件版本与空间占用">
      <DataGrid.Resources>
        <Style
          TargetType="TextBlock">
          <Setter
            Property="TextTrimming"
            Value="CharacterEllipsis" />
          <Setter
            Property="VerticalAlignment"
            Value="Center" />
        </Style>
      </DataGrid.Resources>
      <DataGrid.Columns>
        <DataGridTextColumn
          Header="开发环境组件"
          Binding="{Binding Name}"
          Width="*"
          MinWidth="160" />
        <DataGridTextColumn
          Header="版本"
          Binding="{Binding Version}"
          Width="105" />
        <DataGridTextColumn
          Header="状态"
          Binding="{Binding StateText}"
          Width="130" />
        <DataGridTextColumn
          Header="逻辑大小"
          Binding="{Binding SizeText}"
          Width="105" />
        <DataGridTextColumn
          Header="依赖"
          Binding="{Binding ReferenceText}"
          Width="190" />
      </DataGrid.Columns>
    </DataGrid>
    <GridSplitter
      Grid.Row="4"
      Height="5"
      HorizontalAlignment="Stretch"
      Background="{DynamicResource Border}" />
    <DockPanel
      Grid.Row="5"
      Margin="0,6,0,0">
      <TextBox
        x:Name="DetailText"
        IsReadOnly="True"
        TextWrapping="Wrap"
        VerticalScrollBarVisibility="Auto"
        Background="{DynamicResource ToolSurface}"
        Foreground="{DynamicResource Text}"
        BorderBrush="{DynamicResource Border}"
        Padding="10"
        AutomationProperties.Name="依赖来源与组件详情" />
    </DockPanel>
  </Grid>
</UserControl>
