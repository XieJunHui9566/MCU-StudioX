<UserControl
  x:Class="StudioX.Desktop.Mon51DebugView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:local="clr-namespace:StudioX.Desktop"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid
    Background="{DynamicResource ToolSurface}">
    <Grid.RowDefinitions>
      <RowDefinition
        Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <StackPanel
      Margin="12,6">
      <WrapPanel
        x:Name="SessionControls">
        <Button
          x:Name="LoadSymbolsButton"
          Content="核对并加载当前构建符号"
          Click="Symbols_Click"
          Padding="10,3"
          Margin="0,0,10,4" />
        <CheckBox
          x:Name="SourceStep"
          Content="按源码行步进"
          IsChecked="True"
          Checked="StepMode_Changed"
          Unchecked="StepMode_Changed"
          Margin="0,3,14,4" />
        <Button
          x:Name="InstructionStepButton"
          Content="执行一条指令"
          Click="Instruction_Click"
          Padding="10,3"
          Margin="0,0,10,4" />
      </WrapPanel>
      <TextBlock
        x:Name="SessionHint"
        FontWeight="SemiBold"
        TextWrapping="Wrap" />
      <TextBlock
        x:Name="InstructionHint"
        Foreground="{DynamicResource Muted}"
        FontFamily="Consolas"
        TextWrapping="Wrap" />
    </StackPanel>
    <TabControl
      Grid.Row="1"
      x:Name="Tabs">
      <TabItem
        Header="8051 内存">
        <Grid
          Margin="10,4">
          <Grid.RowDefinitions>
            <RowDefinition
              Height="Auto" />
            <RowDefinition />
          </Grid.RowDefinitions>
          <WrapPanel
            x:Name="MemoryControls"
            Margin="0,0,0,5">
            <ComboBox
              x:Name="Space"
              Width="160"
              Margin="0,0,8,0"
              SelectionChanged="Space_Changed" />
            <TextBlock
              Text="地址 0x"
              VerticalAlignment="Center" />
            <TextBox
              x:Name="Address"
              Text="0000"
              Width="65"
              Margin="4,0,10,0"
              ToolTip="十六进制地址" />
            <TextBlock
              Text="字节数"
              VerticalAlignment="Center" />
            <TextBox
              x:Name="Count"
              Text="64"
              Width="48"
              Margin="4,0,10,0" />
            <Button
              x:Name="ReadButton"
              Content="读取"
              Click="Read_Click"
              Padding="12,3" />
            <TextBox
              x:Name="WriteBytes"
              Width="155"
              Margin="10,0,6,0"
              ToolTip="十六进制字节，例如 01 02 FF；仅编辑用户 RAM" />
            <Button
              Content="写入并核对"
              Click="Write_Click"
              Padding="10,3" />
            <TextBlock
              x:Name="RangeHint"
              Margin="12,0,0,0"
              VerticalAlignment="Center"
              Foreground="{DynamicResource Muted}" />
          </WrapPanel>
          <TextBox
            Grid.Row="1"
            x:Name="Memory"
            IsReadOnly="True"
            FontFamily="Consolas"
            FontSize="12"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            Text="暂停后选择存储区读取。" />
        </Grid>
      </TabItem>
      <TabItem
        Header="CODE 地址断点">
        <Grid
          Margin="10,4">
          <Grid.RowDefinitions>
            <RowDefinition
              Height="Auto" />
            <RowDefinition
              Height="Auto" />
            <RowDefinition />
          </Grid.RowDefinitions>
          <WrapPanel
            x:Name="BreakpointControls">
            <TextBlock
              Text="指令起始地址 0x"
              VerticalAlignment="Center" />
            <TextBox
              x:Name="BreakpointAddress"
              Width="70"
              Margin="4,0,8,0" />
            <Button
              Content="添加断点"
              Click="Add_Click"
              Padding="10,3"
              Margin="0,0,8,0" />
            <Button
              x:Name="RemoveButton"
              Content="删除所选"
              Click="Remove_Click"
              Padding="10,3"
              Margin="0,0,18,0" />
            <TextBlock
              Text="PC 0x"
              VerticalAlignment="Center" />
            <TextBox
              x:Name="PcAddress"
              Width="70"
              Margin="4,0,8,0" />
            <Button
              Content="设置 PC"
              Click="Pc_Click"
              Padding="10,3" />
          </WrapPanel>
          <TextBlock
            Grid.Row="1"
            Text="请输入完整指令的起始地址。软件断点临时写入 A5，暂停和结束时恢复；范围 0003–DBFC。"
            TextWrapping="Wrap"
            Foreground="{DynamicResource Muted}"
            Margin="0,5"
            FontSize="11" />
          <DataGrid
            Grid.Row="2"
            x:Name="Points"
            Style="{StaticResource DebugGrid}">
            <DataGrid.Columns>
              <DataGridTextColumn
                Header="CODE 地址"
                Binding="{Binding AddressText}"
                Width="120" />
              <DataGridTextColumn
                Header="原指令字节"
                Binding="{Binding OriginalText}"
                Width="110" />
              <DataGridTextColumn
                Header="状态"
                Binding="{Binding Status}"
                Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
      <TabItem
        Header="监控日志">
        <TextBox
          x:Name="Output"
          IsReadOnly="True"
          FontFamily="Consolas"
          FontSize="12"
          Margin="10,4"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Auto" />
      </TabItem>
      <TabItem
        x:Name="SourceTab"
        Header="源码 · 观察 · 调用栈">
        <local:DebugToolsView
          x:Name="SourceToolsView" />
      </TabItem>
      <TabItem
        Header="寄存器／变量编辑">
        <StackPanel
          x:Name="EditControls"
          Margin="12,6">
          <TextBlock
            Text="暂停时修改保存的寄存器上下文，写后回读核对。P 标志只读，由 A 自动计算。"
            TextWrapping="Wrap"
            Margin="0,0,0,8" />
          <WrapPanel>
            <ComboBox
              x:Name="EditRegister"
              Width="95"
              Margin="0,0,8,0" />
            <TextBox
              x:Name="RegisterValue"
              Width="95"
              Text="0x00"
              Margin="0,0,8,0" />
            <Button
              Content="修改寄存器"
              Click="Register_Click"
              Padding="10,3" />
          </WrapPanel>
          <TextBlock
            Text="固定 RAM 地址的整数变量／数组元素／结构成员（十进制或 0x 十六进制）。"
            TextWrapping="Wrap"
            Margin="0,14,0,8" />
          <WrapPanel>
            <TextBox
              x:Name="EditVariable"
              Width="170"
              Margin="0,0,8,0" />
            <TextBox
              x:Name="VariableValue"
              Width="95"
              Text="0"
              Margin="0,0,8,0" />
            <Button
              x:Name="SetVariableButton"
              Content="修改变量"
              Click="Variable_Click"
              Padding="10,3" />
          </WrapPanel>
          <TextBlock
            Text="RAM 写入开放 DATA/IDATA 00–7F 与 XDATA 0000–03FF。CODE 编辑由地址断点管理；下载入口使用独立下载服务。"
            TextWrapping="Wrap"
            Foreground="{DynamicResource Muted}"
            Margin="0,14,0,0" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
