<UserControl x:Class="StudioX.Desktop.PluginDebugView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock x:Name="TitleText" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock x:Name="PluginIdentity" Foreground="{DynamicResource Muted}" Margin="0,6,0,8" TextWrapping="Wrap" />
      <WrapPanel Margin="0,0,0,12">
        <Button x:Name="RefreshButton" Content="重新解释快照" Click="Refresh_Click" Margin="0,0,12,0" />
        <TextBlock x:Name="StateText" VerticalAlignment="Center" TextWrapping="Wrap" />
      </WrapPanel>
      <TextBlock Text="暂停、单步和选择栈帧后自动刷新。此视图只解释 IDE 已读取的快照。"
        Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12" />
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <ContentControl x:Name="PanelHost" />
        <TextBox x:Name="DiagnosticText" IsReadOnly="True" TextWrapping="Wrap" Visibility="Collapsed"
          VerticalScrollBarVisibility="Auto" MaxHeight="240" Margin="0,12,0,0" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
