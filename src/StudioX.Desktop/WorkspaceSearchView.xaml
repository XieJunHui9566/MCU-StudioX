<UserControl
  x:Class="StudioX.Desktop.WorkspaceSearchView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="{DynamicResource ToolSurface}"
  Foreground="{DynamicResource Text}">
  <Grid
    Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="160" />
      <RowDefinition
        Height="5" />
      <RowDefinition
        Height="*" />
    </Grid.RowDefinitions>
    <StackPanel
      x:Name="SearchControls">
      <WrapPanel>
        <TextBlock
          Text="查找"
          VerticalAlignment="Center"
          Margin="0,0,8,6" />
        <TextBox
          x:Name="Pattern"
          MinWidth="200"
          Width="260"
          Margin="0,0,10,6"
          AutomationProperties.Name="工程查找文本" />
        <TextBlock
          Text="替换为"
          VerticalAlignment="Center"
          Margin="0,0,8,6" />
        <TextBox
          x:Name="Replacement"
          MinWidth="160"
          Width="220"
          Margin="0,0,10,6"
          AutomationProperties.Name="工程替换文本" />
        <CheckBox
          x:Name="MatchCase"
          Content="大小写"
          VerticalAlignment="Center"
          Margin="0,0,10,6" />
        <CheckBox
          x:Name="WholeWord"
          Content="全词"
          VerticalAlignment="Center"
          Margin="0,0,10,6" />
        <CheckBox
          x:Name="Regex"
          Content="正则"
          VerticalAlignment="Center"
          Margin="0,0,10,6" />
      </WrapPanel>
      <WrapPanel>
        <TextBlock
          Text="包含文件"
          VerticalAlignment="Center"
          Margin="0,0,8,6" />
        <TextBox
          x:Name="Include"
          Width="220"
          Text="*"
          ToolTip="通配符；分号分隔，例如 *.c;*.h;src/**"
          Margin="0,0,10,6" />
        <TextBlock
          Text="排除文件"
          VerticalAlignment="Center"
          Margin="0,0,8,6" />
        <TextBox
          x:Name="Exclude"
          Width="220"
          ToolTip="通配符；分号分隔，例如 tests/**;*.generated.c"
          Margin="0,0,10,6" />
        <CheckBox
          x:Name="IncludeDevice"
          Content="包含 device 器件支持目录"
          VerticalAlignment="Center"
          Margin="0,0,10,6" />
        <Button
          Content="查找"
          Click="Find_Click"
          Margin="0,0,6,6" />
        <Button
          Content="预览替换"
          Click="Preview_Click"
          Margin="0,0,6,6" />
      </WrapPanel>
    </StackPanel>
    <StackPanel
      Grid.Row="1">
      <WrapPanel>
        <Button
          x:Name="Apply"
          Content="应用所选修改"
          Click="Apply_Click"
          IsEnabled="False"
          Margin="0,0,8,6" />
        <Button
          x:Name="Undo"
          Content="撤销本次批量修改"
          Click="Undo_Click"
          IsEnabled="False"
          Margin="0,0,8,6" />
        <TextBlock
          Text="修改进入编辑器，Ctrl+Shift+S 保存全部文件。双击匹配项定位。"
          VerticalAlignment="Center"
          TextWrapping="Wrap"
          Margin="0,0,0,6"
          Foreground="{DynamicResource Muted}" />
      </WrapPanel>
      <TextBlock
        x:Name="Status"
        Text="搜索当前工程；使用打开文档的未保存内容。自动排除构建产物、版本库与链接。"
        TextWrapping="Wrap"
        Margin="0,0,0,8" />
    </StackPanel>
    <DataGrid
      x:Name="Files"
      Grid.Row="2"
      Style="{StaticResource DebugGrid}"
      IsReadOnly="False"
      AutoGenerateColumns="False"
      CanUserAddRows="False"
      CanUserDeleteRows="False"
      SelectionChanged="File_Changed">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn
          x:Name="SelectionColumn"
          Header="应用"
          Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
          Width="55" />
        <DataGridTextColumn
          Header="文件"
          Binding="{Binding Path}"
          IsReadOnly="True"
          Width="*" />
        <DataGridTextColumn
          Header="匹配数"
          Binding="{Binding Count}"
          IsReadOnly="True"
          Width="70" />
        <DataGridTextColumn
          Header="状态"
          Binding="{Binding State}"
          IsReadOnly="True"
          Width="180" />
      </DataGrid.Columns>
    </DataGrid>
    <GridSplitter
      Grid.Row="3"
      HorizontalAlignment="Stretch"
      ResizeDirection="Rows"
      ResizeBehavior="PreviousAndNext" />
    <TabControl
      x:Name="ResultTabs"
      Grid.Row="4">
      <TabItem
        Header="匹配位置">
        <DataGrid
          x:Name="Matches"
          Style="{StaticResource DebugGrid}"
          IsReadOnly="True"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          MouseDoubleClick="Match_DoubleClick">
          <DataGrid.Columns>
            <DataGridTextColumn
              Header="行"
              Binding="{Binding Line}"
              Width="60" />
            <DataGridTextColumn
              Header="列"
              Binding="{Binding Column}"
              Width="60" />
            <DataGridTextColumn
              Header="文本"
              Binding="{Binding Text}"
              Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem
        Header="修改前 / 修改后">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition
              Width="8" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <TextBox
            x:Name="Before"
            IsReadOnly="True"
            AcceptsReturn="True"
            FontFamily="Consolas"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            AutomationProperties.Name="修改前" />
          <TextBox
            x:Name="After"
            Grid.Column="2"
            IsReadOnly="True"
            AcceptsReturn="True"
            FontFamily="Consolas"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            AutomationProperties.Name="修改后" />
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
