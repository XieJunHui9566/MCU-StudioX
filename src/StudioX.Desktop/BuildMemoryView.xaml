<UserControl x:Class="StudioX.Desktop.BuildMemoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:StudioX.Desktop">
 <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="8,7,8,6" Background="Transparent">
  <Expander IsExpanded="True" Foreground="{DynamicResource Text}" HorizontalContentAlignment="Stretch">
   <Expander.Template><ControlTemplate TargetType="Expander"><StackPanel>
    <ToggleButton Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="展开或折叠构建分析器">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
      <Border x:Name="Header" Background="Transparent" CornerRadius="3" Padding="2,4"><Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="15"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Path x:Name="Arrow" Data="M 0,0 L 4,4 L 0,8" Stroke="{DynamicResource Muted}" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
       <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
      </Grid></Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Header" Property="Background" Value="{DynamicResource HoverSurface}"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Header" Property="Background" Value="{DynamicResource HoverSurface}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
   </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Expander.Template>
   <Expander.Header><StackPanel Orientation="Horizontal"><local:Icon Kind="memory-usage" Foreground="{DynamicResource Muted}" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="构建分析器" FontSize="12"/></StackPanel></Expander.Header>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="270" Margin="8,8,0,0">
    <StackPanel>
     <ItemsControl x:Name="Targets">
      <ItemsControl.ItemTemplate><DataTemplate>
       <StackPanel Margin="0,0,0,8">
        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="11" ToolTip="{Binding Description}" Margin="0,0,0,7"/>
        <ItemsControl ItemsSource="{Binding Regions}"><ItemsControl.ItemTemplate><DataTemplate>
         <Grid Margin="0,0,0,7" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Description}">
          <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
          <Grid Grid.Column="1" Height="18">
           <ProgressBar Minimum="0" Maximum="100" Value="{Binding BarPercent, Mode=OneWay}" Foreground="{Binding Fill}" BorderBrush="{DynamicResource Border}" Background="#184488AA" IsHitTestVisible="False">
            <ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3"><Grid x:Name="PART_Track" ClipToBounds="True"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="2" Opacity="0.75"/></Grid></Border></ControlTemplate></ProgressBar.Template>
           </ProgressBar>
           <TextBlock Text="{Binding Percentage}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SizeText}" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
         </Grid>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="{Binding Diagnostic}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/>
       </StackPanel>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock x:Name="AnalysisStatus" Text="编译成功后显示各存储区占用。" Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap" ToolTip="容量来自链接后的 MEMORY 表；占用含数据、堆栈预留和段内对齐，独立段间空洞不计入。不是运行时峰值；修改代码后需重新编译。"/>
    </StackPanel>
   </ScrollViewer>
  </Expander>
 </Border>
</UserControl>
