<UserControl
  x:Class="StudioX.Desktop.OpenOcdPlotView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:StudioX.Desktop">
  <ScrollViewer
    x:Name="PageScroll"
    Margin="12,8"
    VerticalScrollBarVisibility="Auto"
    HorizontalScrollBarVisibility="Disabled">
    <Grid
      MinHeight="620"
      Height="{Binding ViewportHeight, ElementName=PageScroll}">
      <Grid.RowDefinitions>
        <RowDefinition
          Height="Auto" />
        <RowDefinition
          Height="Auto" />
        <RowDefinition
          Height="Auto" />
        <RowDefinition
          Height="Auto" />
        <RowDefinition
          Height="*"
          MinHeight="230" />
        <RowDefinition
          Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel
        Margin="0,0,0,8">
        <TextBlock
          Text="OpenOCD 变量绘图"
          FontSize="20"
          FontWeight="SemiBold" />
        <TextBlock
          x:Name="TargetLabel"
          Foreground="{DynamicResource Muted}"
          TextWrapping="Wrap" />
        <TextBlock
          Text="① 启动实机调试  →  ② 暂停时添加全局变量  →  ③ 开始采集，再点击调试工具栏的运行"
          TextWrapping="Wrap"
          Margin="0,5,0,0" />
        <TextBlock
          Text="通过调试探针读取 SRAM，无需串口或固件输出。运行中读取需芯片/探针支持；时间为主机读回时间，多通道按顺序读取。"
          Foreground="{DynamicResource Muted}"
          TextWrapping="Wrap" />
      </StackPanel>
      <WrapPanel
        Grid.Row="1"
        Margin="0,0,0,6">
        <StackPanel
          Margin="0,0,8,5">
          <TextBlock
            Text="全局变量 / 成员 / 数组元素" />
          <TextBox
            x:Name="ExpressionInput"
            Width="240"
            ToolTip="例如 app_counter、sensor.value、samples[0]"
            AutomationProperties.Name="绘图变量" />
        </StackPanel>
        <StackPanel
          Margin="0,0,8,5">
          <TextBlock
            Text="数值类型" />
          <ComboBox
            x:Name="TypePicker"
            Width="135"
            AutomationProperties.Name="绘图数值类型" />
        </StackPanel>
        <Button
          x:Name="AddButton"
          Content="添加变量"
          VerticalAlignment="Bottom"
          Margin="0,0,8,5"
          Click="Add_Click" />
        <Button
          x:Name="RemoveButton"
          Content="移除选中"
          VerticalAlignment="Bottom"
          Margin="0,0,8,5"
          Click="Remove_Click" />
        <Button
          x:Name="ClearChannelsButton"
          Content="清空通道"
          VerticalAlignment="Bottom"
          Margin="0,0,0,5"
          Click="ClearChannels_Click" />
      </WrapPanel>
      <DataGrid
        Grid.Row="2"
        x:Name="ChannelsGrid"
        Style="{StaticResource DebugGrid}"
        CanUserSortColumns="False"
        AutoGenerateColumns="False"
        IsReadOnly="True"
        CanUserAddRows="False"
        Height="125"
        Margin="0,0,0,8"
        SelectionMode="Single">
        <DataGrid.Columns>
          <DataGridTemplateColumn
            Header="曲线"
            Width="65">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock
                  Text="{Binding Legend}"
                  Foreground="{Binding Brush}"
                  VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn
            Header="变量"
            Binding="{Binding Expression}"
            Width="*"
            MinWidth="140" />
          <DataGridTextColumn
            Header="地址"
            Binding="{Binding Address}"
            Width="115" />
          <DataGridTextColumn
            Header="类型"
            Binding="{Binding Type}"
            Width="90" />
          <DataGridTextColumn
            Header="最新值"
            Binding="{Binding Value}"
            Width="140" />
        </DataGrid.Columns>
      </DataGrid>
      <WrapPanel
        Grid.Row="3"
        Margin="0,0,0,6">
        <TextBlock
          Text="采样间隔 (ms)"
          VerticalAlignment="Center"
          Margin="0,0,6,5" />
        <TextBox
          x:Name="IntervalInput"
          Width="70"
          Text="100"
          Margin="0,0,8,5"
          ToolTip="20–10000 ms；实际速度受探针和目标限制" />
        <Button
          x:Name="StartButton"
          Content="▶ 开始采集"
          Click="Start_Click"
          Margin="0,0,8,5" />
        <Button
          x:Name="StopButton"
          Content="■ 停止采集"
          Click="Stop_Click"
          Margin="0,0,8,5" />
        <Button
          x:Name="ExportButton"
          Content="导出 CSV"
          Click="Export_Click"
          Margin="0,0,8,5" />
        <Button
          x:Name="ClearDataButton"
          Content="清空曲线"
          Click="ClearData_Click"
          Margin="0,0,8,5" />
        <Button
          Content="恢复视图"
          Click="Reset_Click"
          Margin="0,0,8,5" />
        <CheckBox
          x:Name="FollowCheck"
          Content="跟随"
          IsChecked="True"
          Click="Options_Click"
          VerticalAlignment="Center"
          Margin="0,0,8,5" />
        <CheckBox
          x:Name="AutoYCheck"
          Content="自动 Y"
          IsChecked="True"
          Click="Options_Click"
          VerticalAlignment="Center"
          Margin="0,0,0,5" />
      </WrapPanel>
      <local:SerialPlotChart
        Grid.Row="4"
        x:Name="Chart"
        EmptyMessage="添加变量后点击「开始采集」" />
      <StackPanel
        Grid.Row="5"
        Margin="0,6,0,0">
        <TextBlock
          x:Name="StatusLabel"
          TextWrapping="Wrap" />
        <TextBlock
          x:Name="StatisticsLabel"
          Foreground="{DynamicResource Muted}"
          TextWrapping="Wrap" />
        <TextBlock
          x:Name="Notice"
          Foreground="{DynamicResource DiagnosticError}"
          TextWrapping="Wrap"
          MaxHeight="70"
          ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <TextBlock
          Text="滚轮平移 · Ctrl+滚轮缩放时间 · Ctrl+Shift+滚轮缩放数值 · 拖动平移 · 双击恢复。停止采集不会暂停程序。"
          Foreground="{DynamicResource Muted}"
          TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
