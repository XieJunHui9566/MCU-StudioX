<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework></PropertyGroup>
  <ItemGroup>
    <Reference Include="$(StudioXDirectory)/StudioX*.dll" />
  </ItemGroup>
  <Target Name="RequireInstalledIde" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(StudioXDirectory)/StudioX.Application.dll')" Text="Set StudioXDirectory to the existing installed IDE directory." />
  </Target>
</Project>
