+}
+
+/* 只合并相邻且唯一使用的 CODE 地址，不跨越内存操作或控制流。
+   保留原逐字节 ADD/ADDC 和 24 位进位，结果直接进入 DPX 的三个 SFR，
+   避免先拆到临时寄存器再回搬。不改 DR56 最高字节，也不新增暂存区。 */
+static bool
+mcs251GenIndexedCodeRead (iCode *ic)
+{
+  iCode *get = ic->next;
+  operand *base = IC_LEFT (ic), *index = IC_RIGHT (ic);
+  operand *pointer = IC_RESULT (ic), *value;
+  sym_link *ptype, *itype;
+  symbol *valueSymbol;
+  const char *indexRegister = NULL;
+  bool accepted = FALSE;
+  int indexSize, valueSize, offset;
+  static const char *const destination[] = { "dpl", "dph", "dpxl" };
+
+  if (!_G.currentFunc || IFFUNC_ISNAKED (_G.currentFunc->type) ||
+      IFFUNC_CALLEESAVES (_G.currentFunc->type) ||
+      !get || get->generated || !POINTER_GET (get) ||
+      !IS_ITEMP (pointer) || !isOperandEqual (pointer, IC_LEFT (get)) ||
+      bitVectnBitsOn (OP_DEFS (pointer)) != 1 ||
+      !bitVectBitValue (OP_DEFS (pointer), ic->key) ||
+      bitVectnBitsOn (OP_USES (pointer)) != 1 ||
+      !bitVectBitValue (OP_USES (pointer), get->key) ||
+      OP_SYMBOL (pointer)->isspilt || OP_SYMBOL (pointer)->remat ||
+      OP_SYMBOL (pointer)->nRegs != 3 ||
+      (IC_RIGHT (get) && (!IS_OP_LITERAL (IC_RIGHT (get)) || operandLitValue (IC_RIGHT (get)) != 0)))
+    return FALSE;
+  ptype = operandType (pointer);
+  if (!IS_PTR (ptype) || DCL_TYPE (ptype) != CPOINTER || getSize (ptype) != 3)
+    return FALSE;
+  if (!IS_PTR (operandType (base)))
+    { operand *swap = base; base = index; index = swap; }
+  if (!IS_PTR (operandType (base)) || DCL_TYPE (operandType (base)) != CPOINTER ||
+      getSize (operandType (base)) != 3 || !IS_ITEMP (base) || !OP_SYMBOL (base)->remat ||
+      !IS_ITEMP (index) || OP_SYMBOL (index)->remat || OP_SYMBOL (index)->ruonly ||
+      ((OP_SYMBOL (index)->isspilt || !OP_SYMBOL (index)->nRegs) && !OP_SYMBOL (index)->accuse))
+    return FALSE;
+  itype = operandType (index);
+  indexSize = getSize (itype);
+  value = IC_RESULT (get);
+  valueSize = getSize (operandType (value));
+  if (!IS_INTEGRAL (itype) || IS_BITINT (itype) || !SPEC_USIGN (getSpec (itype)) ||
+      (indexSize != 1 && indexSize != 2) || !IS_ITEMP (value) ||
+      !IS_INTEGRAL (operandType (value)) || IS_BITINT (operandType (value)) ||
+      (valueSize != 1 && valueSize != 2 && valueSize != 4) ||
+      IS_BITFIELD (getSpec (ptype->next)) || IS_BITVAR (ptype->next) ||
+      IS_AGGREGATE (ptype->next) || getSize (ptype->next) != valueSize ||
+      isVolatile (ptype->next) || isVolatile (operandType (base)->next) ||
+      isAtomic (operandType (base)->next) ||
+      isOperandVolatileOrAtomic (base, TRUE) || isOperandVolatileOrAtomic (index, TRUE) ||
+      isOperandVolatileOrAtomic (pointer, TRUE) || isOperandVolatileOrAtomic (value, TRUE) ||
+      isAtomic (ptype->next) || hasInc (pointer, get, valueSize) || ifxForOp (value, get))
+    return FALSE;
+
+  /* aopOp 对分页/间接 spill 可能发射寻址指令。先排除这些位置，
+     确保拒绝候选时尚未改变生成流，原来的 PLUS/GET 可完整回退。 */
+  valueSymbol = OP_SYMBOL (value);
+  if (valueSymbol->remat || valueSymbol->accuse || valueSymbol->ruonly ||
+      valueSymbol->regType == REG_CND || valueSymbol->regType == REG_BIT)
+    return FALSE;
+  if (valueSymbol->isspilt || !valueSymbol->nRegs)
+    {
+      symbol *slot = SPIL_LOC (value);
+      if (!slot || !slot->onStack || !SPEC_OCLS (slot->etype) || SPEC_OCLS (slot->etype)->paged)
+        return FALSE;
+    }
+  else if (valueSymbol->nRegs != valueSize)
+    return FALSE;
+
+  aopOp (base, ic, FALSE);
+  aopOp (index, ic, FALSE);
+  aopOp (value, get, FALSE);
+  if (AOP_TYPE (base) != AOP_IMMD || AOP_SIZE (base) != 3 ||
+      AOP (base)->aopu.aop_immd.from_cast_remat ||
+      AOP (base)->aopu.aop_immd.mcs251_pdata_page ||
+      !AOP (base)->aopu.aop_immd.aop_immd1 || !AOP (base)->aopu.aop_immd.aop_immd1[0] ||
+      (AOP_TYPE (value) != AOP_REG && AOP_TYPE (value) != AOP_MCS251_STK) ||
+      AOP_SIZE (value) != valueSize || AOP_SIZE (index) != indexSize)
+    goto release;
+  if (indexSize == 1 && (AOP_TYPE (index) == AOP_REG || AOP_TYPE (index) == AOP_ACC))
+    {
+      if (aopInReg (AOP (index), 0, A_IDX)) indexRegister = "a";
+      else if (aopInReg (AOP (index), 0, B_IDX)) indexRegister = "b";
+      else if (AOP_TYPE (index) == AOP_REG &&
+               AOP (index)->aopu.aop_reg[0]->type != REG_BIT &&
+               AOP (index)->aopu.aop_reg[0]->offset >= 0 &&
+               AOP (index)->aopu.aop_reg[0]->offset < 16)
+        indexRegister = AOP (index)->aopu.aop_reg[0]->name;
+    }
+  else if (indexSize == 2)
+    {
+      indexRegister = mcs251WordForNativePair (AOP (index), 0);
+      if (AOP_TYPE (index) == AOP_ACC && aopInReg (AOP (index), 0, A_IDX) &&
+          aopInReg (AOP (index), 1, B_IDX))
+        indexRegister = "wr10";
+    }
+  if (!indexRegister)
+    goto release;
+
+  _G.dptrCache.valid = FALSE;
+  emitcode (";", "mcs251 indexed CODE address %d-bit", indexSize * 8);
+  for (offset = 0; offset < 3; ++offset)
+    {
+      MOVA (opGet (index, offset, FALSE, FALSE));
+      emitcode (offset ? "addc" : "add", "a,%s", opGet (base, offset, FALSE, FALSE));
+      emitcode ("mov", "%s,a", destination[offset]);
+    }
+  genLine.lineElement.ic = get;
+  genCodePointerGet (IC_LEFT (get), value, get, NULL, NULL, TRUE);
+  genLine.lineElement.ic = ic;
+  get->generated = 1;
+  accepted = TRUE;
+release:
+  freeAsmop (value, NULL, get, TRUE);
+  freeAsmop (index, NULL, ic, TRUE);
+  freeAsmop (base, NULL, ic, TRUE);
+  return accepted;
 }
 
