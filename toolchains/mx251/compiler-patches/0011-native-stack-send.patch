 /*-----------------------------------------------------------------*/
 /* packForPush - heuristics to reduce iCode for pushing            */
 /*-----------------------------------------------------------------*/
+/* 原生SEND在CALL处统一搬运。仅将同块内未逃逸的栈标量快照延后到该处，
+   不跨计算、写入、控制流或调用；volatile和取址对象保持原读取时机。
+   这样分配器不必先给只用一次的参数分配临时槽，再在SEND交换两个DR。 */
+static void
+packStackForNativeSend (iCode *ic, eBBlock *ebp)
+{
+  iCode *def, *walk, *call;
+  operand *source, *temp;
+  sym_link *ftype;
+  int width;
+
+  if (ic->op != SEND || options.useXstack || !IS_ITEMP (IC_LEFT (ic)))
+    return;
+  temp = IC_LEFT (ic);
+  if (bitVectnBitsOn (OP_DEFS (temp)) != 1 || bitVectnBitsOn (OP_USES (temp)) != 1)
+    return;
+  def = hTabItemWithKey (iCodehTab, bitVectFirstBit (OP_DEFS (temp)));
+  if (!def || def->op != '=' || POINTER_SET (def) || def->seq < ebp->fSeq ||
+      def->seq >= ic->seq || !IS_TRUE_SYMOP (IC_RIGHT (def)))
+    return;
+  source = IC_RIGHT (def);
+  width = getSize (operandType (source));
+  if ((width != 1 && width != 2 && width != 4) || IS_AGGREGATE (operandType (source)) ||
+      !OP_SYMBOL (source)->onStack || OP_SYMBOL (source)->addrtaken ||
+      isOperandGlobal (source) || isOperandVolatileOrAtomic (source, TRUE) ||
+      compareType (operandType (source), operandType (temp), false) != 1)
+    return;
+
+  /* 先验证从定义到最终CALL的整段；失败不修改任何iCode或活跃信息。
+     只容许其他参数的纯快照以及SEND/IPUSH，不推断复杂别名或副作用。 */
+  for (walk = def->next; walk && walk->seq <= ebp->lSeq; walk = walk->next)
+    {
+      if (walk->op == CALL)
+        break;
+      if (walk->op == SEND || walk->op == IPUSH)
+        {
+          if (isOperandVolatileOrAtomic (IC_LEFT (walk), TRUE))
+            return;
+          continue;
+        }
+      if (walk->op != '=' || POINTER_SET (walk) || !IS_ITEMP (IC_RESULT (walk)) ||
+          !IC_RIGHT (walk) || isOperandVolatileOrAtomic (IC_RIGHT (walk), TRUE))
+        return;
+      if (!IS_OP_LITERAL (IC_RIGHT (walk)) &&
+          (!IS_TRUE_SYMOP (IC_RIGHT (walk)) || !OP_SYMBOL (IC_RIGHT (walk))->onStack ||
+           OP_SYMBOL (IC_RIGHT (walk))->addrtaken))
+        return;
+    }
+  call = walk;
+  if (!call || call->op != CALL || call->seq < ic->seq || call->seq > ebp->lSeq)
+    return;
+  ftype = operandType (IC_LEFT (call));
+  if (!IS_FUNC (ftype) || FUNC_SDCCCALL (ftype) != 4)
+    return;
+
+  bitVectUnSetBit (OP_USES (source), def->key);
+  OP_USES (source) = bitVectSetBit (OP_USES (source), ic->key);
+  bitVectUnSetBit (OP_USES (temp), ic->key);
+  bitVectUnSetBit (OP_DEFS (temp), def->key);
+  OP_SYMBOL (source)->liveTo = max (OP_SYMBOL (source)->liveTo, call->seq);
+  ReplaceOpWithCheaperOp (&IC_LEFT (ic), source);
+  remiCodeFromeBBlock (ebp, def);
+  hTabDeleteItem (&iCodehTab, def->key, def, DELETE_ITEM, NULL);
+}
