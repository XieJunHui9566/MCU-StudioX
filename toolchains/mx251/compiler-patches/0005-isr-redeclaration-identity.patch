--- a/src/SDCCsymt.c
+++ b/src/SDCCsymt.c
@@ -1683,6 +1683,15 @@
                 error = 1;
               if (compareTypeExact (csym->type, sym->type, sym->level, true) != 1)
                 error = 1;
+              /* ISR 槽及影响函数体的属性也是声明契约；普通 C 类型
