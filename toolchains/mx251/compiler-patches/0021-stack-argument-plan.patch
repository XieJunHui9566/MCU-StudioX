   aopOp (IC_LEFT (ic), ic, FALSE);
+
+  if (mcs251GenStackParmPush (ic))
+    {
+      freeAsmop (IC_LEFT (ic), NULL, ic, TRUE);
+      return;
+    }
 
   // pushSide(IC_LEFT(ic), AOP_SIZE(IC_LEFT(ic)));
   size = AOP_SIZE (IC_LEFT (ic));
